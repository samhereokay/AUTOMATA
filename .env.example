NODE_ENV=development

# Application
PORT=3000
# IMPORTANT: This is a development placeholder. Use a secure random string for production.
API_AUTH_TOKEN=change-me
CORS_ORIGIN=*

# PostgreSQL
# IMPORTANT: This is a development placeholder. Do not use for production.
DATABASE_URL=postgres://automata:automata_password@localhost:5434/automata

# Test-only
TEST_DATABASE_URL=postgres://automata:automata_password@localhost:5434/automata_test

# Local AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scheduler
# PIPELINE_INTERVAL_MS=0 means scheduler is disabled (n8n/API controls execution)
PIPELINE_INTERVAL_MS=0

# Logging
# Allowed values: debug, info, warn, error
LOG_LEVEL=info
