peration": "true"}, "leftValue": "={{ !$json.error && !($json.statusCode >= 400) }}"}]}}, "typeVersion": 2.2}, {"id": "7a2506ea-9d61-4ec3-b373-d71b403b4fa1", "name": "WhatsApp - Send Escalation (Still Active)", "type": "n8n-nodes-base.whatsApp", "position": [4752, -1904], "webhookId": "adb04c2d-ab69-4c64-9df6-ab5095a3f3de", "parameters": {"textBody": "=🚨 URGENT: Secret still ACTIVE after remediation was marked confirmed.\nType: {{ $json.secretType }}\nMasked value: {{ $json.maskedValue }}\nSource: {{ $json.source }} at {{ $json.location }}\nThis needs immediate re-investigation — the reported rotation did not take effect.", "operation": "send", "phoneNumberId": "={{ $json.whatsappBusinessPhoneId }}", "additionalFields": {}, "recipientPhoneNumber": "={{ $json.whatsappRecipientPhone }}"}, "typeVersion": 1}, {"id": "341672fe-cae2-4a79-84af-9b63b97a9072", "name": "Set - Confirmed Revoked & Closed", "type": "n8n-nodes-base.set", "position": [4752, -1680], "parameters": {"options": {}, "assignments": {"assignments": [{"name": "caseStatus", "type": "string", "value": "closed_confirmed_revoked"}]}}, "typeVersion": 3.4}, {"id": "cda2aad8-9254-4221-817e-b8cd9d32dd4e", "name": "WhatsApp - Send Resolution Confirmed", "type": "n8n-nodes-base.whatsApp", "position": [4992, -1680], "webhookId": "69494e42-e92f-44ad-9ef3-92ffac107c13", "parameters": {"textBody": "=✅ Resolved: {{ $json.secretType }} ({{ $json.maskedValue }}) confirmed revoked after remediation. Case closed.", "operation": "send", "phoneNumberId": "={{ $json.whatsappBusinessPhoneId }}", "additionalFields": {}, "recipientPhoneNumber": "={{ $json.whatsappRecipientPhone }}"}, "typeVersion": 1}, {"id": "8b2f5f8f-22b6-446a-b4c5-e9ed13653ed9", "name": "JS - Classify Risk & Build Remediation Plan", "type": "n8n-nodes-base.code", "position": [4272, -1408], "parameters": {"jsCode": "// Advanced risk scoring: secret type + exposure surface + live/revoked status,\n// plus a per-type remediation checklist and a WhatsApp-ready summary message.\nconst item = $input.first().json;\n\nlet verified = null;\nif (item.verified === 'null' || item.verified === null) {\n  verified = null;\n} else if (item.error || (item.statusCode && item.statusCode >= 400)) {\n  verified = false;\n} else if (item.verificationApiUrl) {\n  verified = true;\n}\n\nconst CATEGORY_BASE_SCORE = { cloud: 40, vcs: 30, payment: 45, generic: 15 };\nconst SOURCE_MULTIPLIER = { repo: 1.5, ci: 1.0 };\n\nlet score = (CATEGORY_BASE_SCORE[item.category] || 10) * (SOURCE_MULTIPLIER[item.source] || 1);\nscore += (item.confidencePercent || 0) * 0.3;\nif (verified === true) score += 30;\nif (verified === false) score -= 15;\nscore = Math.max(0, Math.min(100, Math.round(score)));\n\nlet severity = 'low';\nif (score >= 75) severity = 'critical';\nelse if (score >= 55) severity = 'high';\nelse if (score >= 30) severity = 'medium';\n\nconst CHECKLISTS = {\n  'AWS Access Key': ['Deactivate/delete the key pair in IAM immediately.', 'Review CloudTrail for unauthorized activity since exposure.', 'Rotate any dependent services using this key.'],\n  'AWS Secret Key': ['Deactivate/delete the associated access key in IAM immediately.', 'Review CloudTrail for unauthorized activity.', 'Rotate dependent services.'],\n  'GitHub Personal Access Token': ['Revoke the token in GitHub Settings > Developer settings.', 'Check the audit log for unexpected repository access.', 'Reissue a scoped, short-lived token instead.'],\n  'GitLab Token': ['Revoke the token in GitLab user settings.', 'Review project access logs.'],\n  'Slack Token': ['Revoke the token/app installation in Slack admin.', 'Rotate and re-scope minimally.'],\n  'Stripe Live Key': ['Roll the key immediately in the Stripe dashboard.', 'Review recent charges/payouts for anomalies.', 'Notify finance/security of potential exposure.'],\n  'Stripe Restricted Key': ['Roll the key immediately in the Stripe dashboard.', 'Review scoped resource access logs.'],\n  'Google API Key': ['Restrict or regenerate the key in Google Cloud Console.', 'Add application/IP restrictions going forward.'],\n  'Private Key Block': ['Revoke/rotate the corresponding certificate or SSH key immediately.', 'Audit systems that trusted this key.'],\n  'Generic Bearer YOUR_TOKEN_HERE': ['Identify the issuing service and revoke the token there.', 'Search for other usages of the same token.'],\n  'Generic High-Entropy String': ['Manually confirm whether this is a real secret.', 'If confirmed, identify the issuing service and rotate it.']\n};\nconst checklist = CHECKLISTS[item.secretType] || ['Manually investigate and rotate if confirmed sensitive.'];\n\nconst alertRequired = severity === 'critical' || severity === 'high' || severity === 'medium';\n\nconst whatsappMessage = 'Secret exposure detected: ' + item.secretType + ' (' + severity.toUpperCase() + ', risk score ' + score + '/100)\\nSource: ' + item.source + ' at ' + item.location + '\\nMasked value: ' + item.maskedValue + '\\nStill valid: ' + (verified === null ? 'unknown - manual check needed' : (verified ? 'YES - still active' : 'No - appears already revoked')) + '\\nNext steps: ' + checklist.join(' | ');\n\nreturn [{\n  json: {\n    ...item,\n    verified,\n    riskScore: score,\n    severity,\n    checklist,\n    alertRequired,\n    whatsappMessage\n  }\n}];"}, "typeVersion": 2}, {"id": "3e979301-5f23-4e77-8adc-8326c39f6976", "name": "Switch - Severity Routing", "type": "n8n-nodes-base.switch", "position": [4512, -1408], "parameters": {"rules": {"values": [{"conditions": {"options": {"version": 1, "leftValue": "", "caseSensitive": true, "typeValidation": "strict"}, "combinator": "or", "conditions": [{"operator": {"type": "string", "operation": "equals"}, "leftValue": "={{ $json.severity }}", "rightValue": "critical"}, {"operator": {"type": "string", "operation": "equals"}, "leftValue": "={{ $json.severity }}", "rightValue": "high"}]}}, {"conditions": {"options": {"version": 1, "leftValue": "", "caseSensitive": true, "typeValidation": "s