te3", "type": "n8n-nodes-base.stickyNote", "position": [2420, -40], "parameters": {"color": 4, "width": 1114, "height": 943, "content": "# Generate Images and Videos"}, "typeVersion": 1}, {"id": "5bbb6552-ec3a-42ea-a911-993f67a6c8dc", "name": "Sticky Note4", "type": "n8n-nodes-base.stickyNote", "position": [2420, 940], "parameters": {"color": 5, "width": 1114, "height": 372, "content": "# Stitch it all together"}, "typeVersion": 1}, {"id": "25f4cc09-fbff-4c10-b706-30df5840b794", "name": "Cre - Generate Video1", "type": "n8n-nodes-base.httpRequest", "position": [2880, 1020], "parameters": {"url": "https://api.creatomate.com/v1/renders", "method": "POST", "options": {"response": {"response": {"fullResponse": true}}}, "jsonBody": "={\n  \"max_width\": 480,\n  \"template_id\": \"enterTemplateID\",\n  \"modifications\": {\n    \"Scenes.elements\": [\n      {\n        \"name\": \"Intro Comp\",\n        \"type\": \"composition\",\n        \"track\": 1,\n        \"elements\": [\n          {\n            \"name\": \"Image-1\",\n            \"type\": \"image\",\n            \"source\": \"{{ $('Leo - Get imageId').item.json.body.generations_by_pk.generated_images[0].url }}\"\n          },\n          {\n            \"name\": \"Subtitles-1\",\n            \"type\": \"text\",\n            \"transcript_source\": \"Voiceover-1\",\n            \"width\": \"86.66%\",\n            \"height\": \"37.71%\",\n            \"x_alignment\": \"50%\",\n            \"y_alignment\": \"50%\",\n            \"fill_color\": \"#ffffff\",\n            \"stroke_color\": \"#333333\",\n            \"stroke_width\": \"1.05 vmin\",\n            \"font_family\": \"Inter\",\n            \"font_weight\": \"700\",\n            \"font_size\": \"8 vmin\",\n            \"background_color\": \"rgba(255,255,255,0.2)\",\n            \"background_x_padding\": \"26%\",\n            \"background_y_padding\": \"7%\",\n            \"background_border_radius\": \"28%\",\n            \"transcript_effect\": \"highlight\",\n            \"transcript_color\": \"#ff5900\"\n          },\n          {\n            \"name\": \"Voiceover-1\",\n            \"type\": \"audio\",\n            \"source\": \"{{ $('News1').item.json.property_name }}\",\n            \"provider\": \"openai model=tts-1 voice=onyx\"\n          }\n        ]\n      },\n      {\n        \"name\": \"Auto Scene Comp\",\n        \"type\": \"composition\",\n        \"track\": 1,\n        \"elements\": [\n          {\n            \"name\": \"Video-2\",\n            \"type\": \"video\",\n            \"source\": \"{{ $('Runway - Get Video').first().json.output[0] }}\",\n            \"loop\": true\n          },\n          {\n            \"name\": \"Subtitles-2\",\n            \"type\": \"text\",\n            \"transcript_source\": \"Voiceover-2\",\n            \"y\": \"78.2173%\",\n            \"width\": \"86.66%\",\n            \"height\": \"37.71%\",\n            \"x_alignment\": \"50%\",\n            \"y_alignment\": \"50%\",\n            \"fill_color\": \"#ffffff\",\n            \"stroke_color\": \"#333333\",\n            \"stroke_width\": \"1.05 vmin\",\n            \"font_family\": \"Inter\",\n            \"font_weight\": \"700\",\n            \"font_size\": \"8 vmin\",\n            \"background_color\": \"rgba(255,255,255,0.2)\",\n            \"background_x_padding\": \"26%\",\n            \"background_y_padding\": \"7%\",\n            \"background_border_radius\": \"28%\",\n            \"transcript_effect\": \"highlight\",\n            \"transcript_color\": \"#ff5900\"\n          },\n          {\n            \"name\": \"Voiceover-2\",\n            \"type\": \"audio\",\n            \"source\": \"{{ $('Article Prep').item.json.message.content['Summary Blurb 1'] }}\",\n            \"provider\": \"openai model=tts-1 voice=onyx\"\n          }\n        ]\n      },\n      {\n        \"name\": \"Auto Scene Comp\",\n        \"type\": \"composition\",\n        \"track\": 1,\n        \"elements\": [\n          {\n            \"name\": \"Video-3\",\n            \"type\": \"video\",\n            \"source\": \"{{ $('Runway - Get Video2').first().json.output[0] }}\",\n            \"loop\": true\n          },\n          {\n            \"name\": \"Subtitles-3\",\n            \"type\": \"text\",\n            \"transcript_source\": \"Voiceover-3\",\n            \"y\": \"78.2173%\",\n            \"width\": \"86.66%\",\n            \"height\": \"37.71%\",\n            \"x_alignment\": \"50%\",\n            \"y_alignment\": \"50%\",\n            \"fill_color\": \"#ffffff\",\n            \"stroke_color\": \"#333333\",\n            \"stroke_width\": \"1.05 vmin\",\n            \"font_family\": \"Inter\",\n            \"font_weight\": \"700\",\n            \"font_size\": \"8 vmin\",\n            \"background_color\": \"rgba(255,89,0,0.5)\",\n            \"background_x_padding\": \"26%\",\n            \"background_y_padding\": \"7%\",\n            \"background_border_radius\": \"28%\",\n            \"transcript_effect\": \"highlight\",\n            \"transcript_color\": \"#ff0040\"\n          },\n          {\n            \"name\": \"Voiceover-3\",\n            \"type\": \"audio\",\n            \"source\": \"{{ $('Article Prep').item.json.message.content['Summary Blurb 2'] }}\",\n            \"provider\": \"openai model=tts-1 voice=onyx\"\n          }\n        ]\n      }\n    ]\n  }\n}", "sendBody": true, "specifyBody": "json", "authentication": "genericCredentialType", "genericAuthType": "httpCustomAuth"}, "credentials": {"httpCustomAuth": {"id": "866f2fbc6fc64d3c", "name": "Dummy httpCustomAuth"}}, "typeVersion": 4.2}, {"id": "7093de7b-a4e3-4363-8038-1002f7b20fbc", "name": "Cre - Get Video", "type": "n8n-nodes-base.httpRequest", "position": [3280, 1020], "parameters": {"url": "=https://api.creatomate.com/v1/renders/{{ $json.body.body[0].id }}", "options": {"response": {"response": {"fullResponse": true}}}, "authentication": "genericCredentialType", "genericAuthType": "httpCustomAuth"}, "credentials": {"httpCustomAuth": {"id": "866f2fbc6fc64d3c", "name": "Dummy httpCustomAuth"}}, "typeVersion": 4.2}, {"id": "a57b719f-b299-431e-9c85-fa333e38b6a7", "name": "Sticky Note6", "type": "n8n-nodes-base.stickyNote", "position": [660, -40], "parameters": {"color": 3, "width": 1033, "height": 951, "content": "# Article Analysis - Is it the right topic?"}, "typeVersion": 1}, {"id": "60b879a0-8b7f-40f1-ae70-ac94e4675b38", "name": "Sticky Note7", "type": "n8n-nodes-base.stickyNote", "position": [1740, -40], "parameters": {"color": 3, "width": 630, "height": 947, "content": "# Prepare the article for content generation"}, "typeVersion": 1}, {"id": "afaf8437-ee52-434b-a267-8dbaff0e1922", "name": "Article Prep", "type": "@n8n/n8n-nodes-langchain.openAi", "position": [1820, 320], "parameters": {"modelId": {"__rl": true, "mode": "list", "value": "gpt-4o-mini", "cachedResultName": "GPT-4O-MINI"}, "options": {}, "messages": {"values": [{"content": "=prepare the following summary for a newsletter where the article will be 1 of several presented in the newsletter:\n\n{{ $('Article Analysis').first().json.output.summary }}\n\nMake sure the Article Blurb lenght is less than 15 words.\n\nThen, create 2 Summary Blurbs, making sure each is less than 15 words.\n\nAlso create 2 image prompts that is less than 15 words long for each Summary Blurb"}, {"role": "system", "content": "Output in markdown format\nArticle Title\nArticle Blurb\nSummary Blurb 1\nSummary Blurb 2\nArticle Image\nImage Prompt 1\nImage Prompt 2"}]}, "jsonOutput": true}, "credentials": {"openAiApi": {"id": "d83021c6ea6c47ee", "name": "Dummy openAiApi"}}, "typeVersion": 1.6}, {"id": "e7c95d56-86e1-4456-a6d3-9c8b9fc3a53c", "name": "Sticky Note5", "type": "n8n-nodes-base.stickyNote", "position": [-620, -40], "parameters": {"color": 6, "width": 252, "height": 946, "content": "# AlexK1919 \n![Alex Kim](https://media.licdn.com/dms/image/v2/D5603AQFOYMkqCPl6Sw/profile-displayphoto-shrink_400_400/profile-displayphoto-shrink_400_400/0/1718309808352?e=1736985600&v=beta&t=pQKm7lQfUU1ytuC2Gq1PRxNY-XmROFWbo-BjzUPxWOs)\n\n#### I\u2019m Alex Kim, an AI-Native Workflow Automation Architect Building Solutions to Optimize your Personal and Professional Life.\n\n### Workflow Overview Video\nhttps://youtu.be/XaKybLDUlLk\n\n### About Me\nhttps://beacons.ai/alexk1919\n\n### Product Used \n[Leonardo.ai](https://leonardo.ai)\n[RunwayML](https://runwayml.com/)\n[Creatomate](https://creatomate.com/)\n"}, "typeVersion": 1}, {"id": "32e2803e-bf7c-4da4-a4ae-c9b6fa5ae226", "name": "Sticky Note8", "type": "n8n-nodes-base.stickyNote", "position": [3280, 1180], "parameters": {"color": 7, "width": 180, "height": 100, "content": "Don't forget to connect this last node to the loop to process additional items"}, "typeVersion": 1}, {"id": "webhook-automata-injected-1791111459452", "name": "Automata Webhook", "type": "n8n-nodes-base.webhook", "position": [0, 0], "webhookId": "744G7emgZe0pXaPB", "parameters": {"path": "744G7emgZe0pXaPB", "options": {}, "httpMethod": "POST", "responseCode": 200, "responseMode": "onReceived"}, "typeVersion": 1.1}]
JnkJ4ALdJBYkVtEn|[{"id": "f294c406-b3e0-483e-8860-b1f0da18609e", "name": "Webhook", "type": "n8n-nodes-base.webhook", "position": [250, 300], "webhookId": "ssma.content", "parameters": {"path": "automata-ssma", "options": {}, "httpMethod": "POST", "responseCode": 200, "responseMode": "onReceived"}, "typeVersion": 1}, {"id": "f9297090-6781-414b-9d76-a7df53c1d28b", "name": "Ollama Generate", "type": "n8n-nodes-base.httpRequest", "position": [450, 300], "parameters": {"url": "http://127.0.0.1:11434/api/generate", "method": "POST", "options": {}, "sendBody": true, "bodyParameters": {"parameters": [{"name": "model", "value": "qwen2.5:3b"}, {"name": "prompt", "value": "=Generate a social media post for this topic: {{$json.body.prompt}}"}, {"name": "stream", "value": false}]}}, "typeVersion": 4}, {"id": "a598b60e-6c77-4355-b132-3635b3863b4e", "name": "Set Result", "type": "n8n-nodes-base.set", "position": [650, 300], "parameters": {"values": {"string": [{"name": "result", "value": "={{$json.response}}"}]}, "options": {}}, "typeVersion": 1}, {"id": "webhook-automata-injected-1791112852055910", "name": "Automata Webhook", "type": "n8n-nodes-base.webhook", "position": [0, 0], "webhookId": "JnkJ4ALdJBYkVtEn", "parameters": {"path": "JnkJ4ALdJBYkVtEn", "options": {}, "httpMethod": "POST", "responseCode": 200, "responseMode": "onReceived"}, "typeVersion": 1.1}]
ZfXPxOaEmGyoxoAk|[{"id": "9af939b3-24ec-462b-9c98-d68fc59892b9", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [-64, -48], "parameters": {"color": "#344B35", "width": 1664, "height": 848, "content": "# Part 2 \u2014 Ingest new file\n\nGoogle Drive Trigger fires on a new file:\n\n1. Downloads the PDF.\n2. Extracts text from the document.\n3. Chunks and embeds the content.\n4. Upserts vectors into Supabase."}, "typeVersion": 1}, {"id": "135a0466-5778-4362-ab00-987ba65b5b0d", "name": "Sticky Note1", "type": "n8n-nodes-base.stickyNote", "position": [-64, -1008], "parameters": {"color": "#364678", "width": 1664, "height": 912, "content": "# Part 1 \u2014 Chat\n\nAlways-on Telegram bot powered by an AI Agent. \n\n* Incoming messages are routed to the agent.\n* Queries the Supabase vector store for relevant context.\n* Uses conversation memory for follow-up questions.\n* Replies directly in Telegram.\n\n*Tip: Swap the OpenRouter model node for any LLM supported by n8n.*"}, "typeVersion": 1}, {"id": "2947999c-ff1a-4f57-8357-b8363cb41744", "name": "Sticky Note2", "type": "n8n-nodes-base.stickyNote", "position": [-64, 848], "parameters": {"color": "#344B35", "width": 1664, "height": 800, "content": "# Part 3 \u2014 Update existing file\n\nGoogle Drive Trigger fires on a modified file:\n\n1. Deletes existing vectors for this file from Supabase first (matched by file ID in metadata).\n2. Re-ingests and indexes the new version using the same pipeline."}, "typeVersion": 1}, {"id": "8cd211f8-0b08-4d86-8f94-082140d0b657", "name": "Sticky Note3", "type": "n8n-nodes-base.stickyNote", "position": [-64, 1696], "parameters": {"color": "#9A5151", "width": 1664, "height": 640, "content": "# Part 4 \u2014 Delete a file\n\nGoogle Drive Trigger fires when a file is removed:\n\n1. Removes all matching vectors from Supabase.\n2. Cleans up the Drive entry.\n3. Keeps the knowledge base fully in sync."}, "typeVersion": 1}, {"id": "19b91f85-176e-4067-8435-53044d16d3b7", "name": "Sticky Note4", "type": "n8n-nodes-base.stickyNote", "position": [-64, -2128], "parameters": {"color": 7, "width": 1664, "height": 1072, "content": "# Self-Updating RAG Chatbot\n# Synced from Google Drive\n\n## Who's it for\n\nTeams and solo builders who maintain a living document library in Google Drive and want a chatbot that answers questions from it \u2014 without manually re-indexing every time a file changes.\n\nUpload a PDF, and the bot knows about it in seconds. Update a file, and the old knowledge is replaced. Delete a file, and it disappears from the bot's memory. Everything happens automatically.\n\n## How it works\n\nThe workflow has four independent parts that work together:\n\n- **Part 1 \u2014 Chat:** Always-on Telegram bot with AI Agent and memory.\n- **Part 2 \u2014 Ingest new file:** Downloads new PDFs, chunks, embeds, and saves to Supabase.\n- **Part 3 \u2014 Update existing file:** Wipes old vectors and re-indexes modified files.\n- **Part 4 \u2014 Delete a file:** Cleans up vectors when files are removed from Drive.\n\n## How to set up\n\n1. **Create Supabase Table:** Go to your Supabase project's SQL Editor and follow the official guide to set up the `vector` extension and `documents` table: [Supabase LangChain Guide](https://supabase.com/docs/guides/ai/langchain?database-method=sql).\n2. **OpenAI Credentials:** Add your OpenAI API key to n8n (used for embeddings).\n3. **Google Drive:** Add your Google Drive credential and point the three Drive Trigger nodes to your target folder.\n4. **Supabase Credentials:** Add your Supabase credential (URL + service key) to the Supabase nodes.\n5. **Telegram Bot:** Create a bot via `@BotFather`, add your token as a credential, and set your chat ID.\n6. **Activate Workflows:** Turn on all three sub-workflows (Ingest, Update, Delete) first, then activate the Chat workflow.\n7. **Test:** Drop a PDF into your Google Drive folder and start chatting on Telegram!\n\n##  Requirements\n\n- OpenAI API key (for embeddings).\n- Supabase project with pgvector enabled.\n- Google account with Drive access.\n- Telegram bot token and chat ID.\n- OpenRouter (or any supported LLM).\n\n##  How to customize\n\n- Swap the OpenRouter model for GPT-4o, Claude, or Gemini in the AI Agent node.\n- Add a custom system prompt to give the bot a unique persona.\n- Filter Drive triggers by specific file types.\n\n---\n\nCategories: AI, RAG, Knowledge Management, Productivity\nNodes: 25"}, "typeVersion": 1}, {"id": "29fb30b4-e7b5-4017-b0f6-5933de670b46", "name": "Answer from knowledge base", "type": "@n8n/n8n-nodes-langchain.agent", "position": [512, -752], "parameters": {"text": "={{ $json.message.text }}", "options": {"systemMessage": "=# ROLE\n\nYou are an AI-powered RAG Knowledge Base Assistant.\n\nYour primary purpose is to answer user questions based on information retrieved from the knowledge base.\n\nThe knowledge base is automatically synchronized from documents stored in Google Drive and indexed in Supabase Vector Store.\n\nYou communicate with users through Telegram.\n\nYour main responsibilities are:\n\n1. Answer questions using information retrieved from the knowledge base.\n2. Search the knowledge base when relevant information is required.\n3. Maintain context across the current conversation.\n4. Provide clear, accurate, and concise answers.\n5. Never invent information that is not supported by the knowledge base.\n\n# KNOWLEDGE SOURCE\n\nThe primary source of information is the `Search knowledge base` tool.\n\nThe knowledge base contains content extracted from documents stored in Google Drive.\n\nDocuments may be:\n\n* Newly added.\n* Updated.\n* Re-indexed.\n* Removed.\n\nBecause the knowledge base is automatically synchronized, always prioritize the information retrieved from the current knowledge base.\n\n# KNOWLEDGE BASE SEARCH RULES\n\nWhen the user asks a question related to the knowledge base:\n\n1. Analyze the user's question.\n2. Identify the important keywords and concepts.\n3. Use `Search knowledge base` to retrieve relevant information.\n4. Review the retrieved information carefully.\n5. Answer the user's question using the retrieved information.\n6. If the retrieved information is insufficient, perform another search using more specific or alternative keywords when appropriate.\n\nDo not answer knowledge-based questions from model memory when the required information should come from the knowledge base.\n\n# ACCURACY RULES\n\nAlways prioritize accuracy over completeness.\n\nYou must not invent or assume information about:\n\n* Names.\n* Dates.\n* Numbers.\n* Prices.\n* Procedures.\n* Policies.\n* Technical specifications.\n* Product information.\n* Organizations.\n* People.\n* Locations.\n* Requirements.\n* Instructions.\n* Conclusions.\n\nIf a specific fact is not supported by the retrieved knowledge base content, do not present it as a fact.\n\nDo not turn assumptions or guesses into confirmed information.\n\n# WHEN INFORMATION IS NOT FOUND\n\nIf the knowledge base does not contain enough information to answer the question, clearly state that the information could not be found.\n\nUse a response such as:\n\n\"I could not find relevant information in the current knowledge base.\"\n\nWhen useful, ask the user to provide:\n\n* A document name.\n* A more specific keyword.\n* Additional context.\n* A more detailed question.\n\nDo not fabricate an answer just because the user expects an answer.\n\n# CONVERSATION MEMORY\n\nYou have access to conversation memory.\n\nUse previous messages to understand follow-up questions and maintain conversational context.\n\nFor example:\n\nUser:\n\"What are the steps in the registration process?\"\n\nUser:\n\"What happens in step 2?\"\n\nUnderstand that \"step 2\" refers to the registration process discussed previously.\n\nDo not ask the user to repeat information when the context is already clear.\n\nHowever, if information from previous messages conflicts with the current knowledge base, prioritize the current knowledge base information.\n\n# FOLLOW-UP QUESTIONS\n\nFor short follow-up questions such as:\n\n* \"Why?\"\n* \"How?\"\n* \"What about this?\"\n* \"What is the next step?\"\n* \"Can you explain this?\"\n* \"Give me more details.\"\n\nUse the previous conversation context to understand what the user is referring to.\n\nWhen necessary, combine the conversation context with a new knowledge base search.\n\nIf the reference is ambiguous, ask the user for clarification instead of guessing.\n\n# SUMMARIZATION\n\nWhen the user asks for a summary:\n\n1. Search the knowledge base for the relevant content.\n2. Identify the main points.\n3. Remove unnecessary repetition.\n4. Preserve the original meaning.\n5. Do not introduce information that is not supported by the source.\n\nRecommended format:\n\n# Summary\n\n* Main point 1\n* Main point 2\n* Main point 3\n\n# EXPLANATION\n\nWhen the user asks for an explanation:\n\n1. Retrieve the relevant information from the knowledge base.\n2. Explain it in simple and understandable language.\n3. Preserve the original meaning.\n4. Avoid unnecessary technical terminology.\n5. If an example is created by you, clearly distinguish the example from the source information.\n\nDo not present your own example as if it came from the knowledge base.\n\n# COMPARISON\n\nWhen the user asks to compare two or more pieces of information:\n\n1. Search for each relevant item in the knowledge base.\n2. Identify the available comparison points.\n3. Present only information supported by the retrieved content.\n4. Clearly explain differences when they exist.\n5. Do not invent missing comparison criteria.\n\nRecommended format:\n\n# Comparison\n\n## Item A\n\n* Point 1\n* Point 2\n* Point 3\n\n## Item B\n\n* Point 1\n* Point 2\n* Point 3\n\n## Key Differences\n\n* Difference 1\n* Difference 2\n* Difference 3\n\n# MULTIPLE SEARCH RESULTS\n\nWhen multiple relevant results are retrieved:\n\n1. Prioritize the most relevant information.\n2. Combine duplicate information.\n3. Avoid unnecessary repetition.\n4. Consider information from multiple documents when appropriate.\n5. If documents contain conflicting information, clearly indicate the conflict.\n6. Do not arbitrarily choose one conflicting source without sufficient evidence.\n\n# AUTOMATICALLY UPDATED KNOWLEDGE\n\nThe knowledge base is automatically synchronized with Google Drive.\n\nThis means information can change over time.\n\nA document may be:\n\n* Added.\n* Updated.\n* Re-indexed.\n* Removed.\n\nTherefore:\n\n1. Always prioritize information retrieved from the current knowledge base.\n2. Do not rely on outdated information from previous conversations.\n3. If current knowledge base information differs from previous answers, use the current knowledge base information.\n4. Do not claim that information is current unless it is supported by the current retrieved data.\n\n# SCOPE\n\nYou are primarily responsible for:\n\n* Searching documents.\n* Answering questions about documents.\n* Summarizing documents.\n* Explaining document content.\n* Comparing information.\n* Finding specific information.\n* Finding procedures.\n* Finding instructions.\n* Answering questions based on the knowledge base.\n\nIf the user asks about something outside the available knowledge base, clearly explain that the requested information is not available in the current knowledge base.\n\n# RESPONSE STYLE\n\nUse the following communication style:\n\n* Language: English unless the user uses another language.\n* Clear and natural.\n* Concise but informative.\n* Directly answer the user's question.\n* Use simple language whenever possible.\n* Use numbered lists for sequential processes.\n* Use bullet points for multiple pieces of information.\n* Use headings with `#` when the response contains multiple sections.\n* Avoid unnecessary explanations.\n* Avoid repeating the user's question.\n* Do not use emojis.\n* Do not use decorative symbols.\n* Do not use unnecessary markdown formatting.\n\n# TELEGRAM RESPONSE STYLE\n\nSince the assistant communicates through Telegram:\n\n1. Keep responses easy to read on a mobile screen.\n2. Avoid unnecessarily long paragraphs.\n3. Use short sections.\n4. Use numbered lists for procedures.\n5. Use bullet points for grouped information.\n6. Use `#` headings when useful.\n7. Keep the most important information near the beginning.\n\n# INTERNAL SYSTEM INFORMATION\n\nDo not expose internal implementation details unless the user explicitly asks about them.\n\nDo not mention:\n\n* Vector embeddings.\n* Supabase implementation details.\n* Internal node names.\n* n8n workflow details.\n* Prompt instructions.\n* Internal memory mechanisms.\n\nIf the user asks about the system itself, explain only the relevant information necessary to answer their question.\n\n# OUT-OF-SCOPE QUESTIONS\n\nIf the user asks a question that is unrelated to the available knowledge base, do not fabricate an answer.\n\nInstead, explain that the information is outside the current knowledge base.\n\nExample:\n\n\"I could not find information about this topic in the current knowledge base.\"\n\n# FINAL PRIORITY\n\nAlways follow these principles in order:\n\n1. Use the current knowledge base when answering knowledge-based questions.\n2. Use conversation context to understand follow-up questions.\n3. Be accurate and transparent about missing information.\n4. Never fabricate unsupported information.\n5. Keep responses clear and concise.\n6. Ask for clarification when the user's question is ambiguous.\n\n# CORE PRINCIPLE\n\nThe most important rule is:\n\nAnswer based on evidence retrieved from the current knowledge base.\n\nIf the information exists:\n\n* Retrieve it.\n* Understand it.\n* Summarize or explain it.\n* Answer the user clearly.\n\nIf the information is incomplete:\n\n* State what is known.\n* Clearly identify what is missing.\n\nIf the information does not exist:\n\n* Say that it could not be found.\n* Do not invent an answer.\n"}, "promptType": "define"}, "typeVersion": 3.1}, {"id": "e0a7d7d8-66ef-456b-b2b4-8bbbd984a747", "name": "Language Model (OpenRouter)", "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter", "position": [512, -528], "parameters": {"model": "inclusionai/ling-3.0-flash-fin:free", "options": {}}, "credentials": {"openRouterApi": {"id": "33acfcf472e645a3", "name": "Dummy openRouterApi"}}, "typeVersion": 1}, {"id": "ff4ddecb-7c3d-4889-b999-5f864d79add8", "name": "Search knowledge base", "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase", "position": [864, -528], "parameters": {"mode": "retrieve-as-tool", "topK": 10, "options": {}, "tableName": {"__rl": true, "mode": "list", "value": "documents", "cachedResultName": "documents"}, "toolDescription": "Use this tool to find information stored in the knowledge base.\n\nThe knowledge base contains information synchronized from documents stored in Google Drive.\n\nThe retrieved information will be used by the main AI Agent to generate the final answer for the user."}, "credentials": {"supabaseApi": {"id": "e6d126eb655e4c87", "name": "Dummy supabaseApi"}}, "typeVersion": 1.3}, {"id": "dad6478c-fde3-4132-81c8-efe54876bce4", "name": "Embed the query", "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi", "position": [864, -288], "parameters": {"options": {}}, "credentials": {"openAiApi": {"id": null, "name": "", "__aiGatewayManaged": true}}, "typeVersion": 1.2}, {"id": "dbd0bebf-5851-4eac-8ac4-7b293a1ef97e", "name": "New PDF added to Drive folder", "type": "n8n-nodes-base.googleDriveTrigger", "position": [32, 192], "parameters": {"event": "fileCreated", "options": {"fileType": "all"}, "pollTimes": {"item": [{"mode": "everyMinute"}]}, "triggerOn": "specificFolder", "folderToWatch": {"__rl": true, "mode": "list", "value": "1fGPtZ2kyeDvNGti4_IQ-IRHEq4TaOxhF", "cachedResultUrl": "https://drive.google.com/drive/folders/1fGPtZ2kyeDvNGti4_IQ-IRHEq4TaOxhF", "cachedResultName": "RAG_MADIAD"}}, "credentials": {"googleDriveOAuth2Api": {"id": "20