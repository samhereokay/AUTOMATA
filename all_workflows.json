th2": {"id": "8479ad9d7328434e", "name": "Dummy gmailOAuth2"}}, "typeVersion": 1.4}, {"id": "54c44b64-181a-4b17-b41f-8abe19604f88", "name": "Anfrage vollst\u00e4ndig laden", "type": "n8n-nodes-base.gmail", "position": [1008, 1088], "webhookId": "fa68cc78-3751-4500-8362-379372f7ba74", "parameters": {"simple": false, "options": {"downloadAttachments": true}, "messageId": "={{ $json.id }}", "operation": "get"}, "credentials": {"gmailOAuth2": {"id": "8479ad9d7328434e", "name": "Dummy gmailOAuth2"}}, "typeVersion": 2.2}, {"id": "3805e65d-a692-46fc-aba2-e9f46fc75fbf", "name": "E-Mail-Daten vorbereiten", "type": "n8n-nodes-base.code", "position": [1232, 1088], "parameters": {"mode": "runOnceForEachItem", "jsCode": "const daten = $json;\n\nfunction entitiesDekodieren(text) {\n  const entities = {\n    nbsp: ' ',\n    amp: '&',\n    lt: '<',\n    gt: '>',\n    quot: '\"',\n    apos: \"'\",\n    auml: '\u00e4',\n    Auml: '\u00c4',\n    ouml: '\u00f6',\n    Ouml: '\u00d6',\n    uuml: '\u00fc',\n    Uuml: '\u00dc',\n    szlig: '\u00df',\n    euro: '\u20ac',\n    ndash: '\u2013',\n    mdash: '\u2014'\n  };\n\n  let ergebnis = String(text);\n\n  ergebnis = ergebnis.replace(\n    /&#x([0-9a-f]+);/gi,\n    (_, wert) => String.fromCodePoint(parseInt(wert, 16))\n  );\n\n  ergebnis = ergebnis.replace(\n    /&#(\\d+);/g,\n    (_, wert) => String.fromCodePoint(parseInt(wert, 10))\n  );\n\n  // Zweimal ausf\u00fchren, falls Zeichen doppelt codiert sind.\n  for (let i = 0; i < 2; i++) {\n    ergebnis = ergebnis.replace(\n      /&([A-Za-z]+);/g,\n      (treffer, name) => entities[name] ?? treffer\n    );\n  }\n\n  return ergebnis;\n}\n\nfunction htmlZuText(inhalt) {\n  return entitiesDekodieren(\n    String(inhalt)\n      .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n      .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n      .replace(/<br\\s*\\/?>/gi, '\\n')\n      .replace(/<\\/p>/gi, '\\n')\n      .replace(/<[^>]+>/g, ' ')\n  )\n    .replace(/\\r/g, '')\n    .replace(/[ \\t]+\\n/g, '\\n')\n    .replace(/\\n{3,}/g, '\\n\\n')\n    .trim();\n}\n\nconst absenderObjekt = daten.from?.value?.[0];\n\nconst absenderText =\n  daten.from?.text ||\n  daten.From ||\n  '';\n\nconst kundenEmail =\n  absenderObjekt?.address ||\n  absenderText.match(/<([^<>]+@[^<>]+)>/)?.[1] ||\n  absenderText.match(/[\\w.+-]+@[\\w.-]+\\.[A-Za-z]{2,}/)?.[0] ||\n  '';\n\nconst absenderName =\n  absenderObjekt?.name ||\n  absenderText\n    .replace(/<[^>]+>/g, '')\n    .replace(/\"/g, '')\n    .trim();\n\nconst textVarianten = [\n  typeof daten.text === 'string'\n    ? htmlZuText(daten.text)\n    : '',\n  typeof daten.textAsHtml === 'string'\n    ? htmlZuText(daten.textAsHtml)\n    : '',\n  typeof daten.html === 'string'\n    ? htmlZuText(daten.html)\n    : '',\n  typeof daten.snippet === 'string'\n    ? htmlZuText(daten.snippet)\n    : ''\n].filter(text => text.length > 0);\n\nconst anfrage =\n  textVarianten.sort((a, b) => b.length - a.length)[0] || '';\n\nif (!anfrage) {\n  throw new Error(\n    'In der E-Mail wurde kein Nachrichtentext gefunden.'\n  );\n}\n\nconst ergebnis = {\n  json: {\n    Gmail_Message_ID: daten.id || '',\n    Gmail_Thread_ID: daten.threadId || '',\n    Absender_Name: absenderName,\n    'Kunden_E-Mail': kundenEmail,\n    Betreff: daten.subject || daten.Subject || '',\n    Anfrage: anfrage\n  }\n};\n\nif ($binary && Object.keys($binary).length > 0) {\n  ergebnis.binary = $binary;\n}\n\nreturn ergebnis;"}, "typeVersion": 2}, {"id": "304c60a6-4311-4446-84fc-eed6daa95bfd", "name": "Angebotsdaten aus E-Mail extrahieren", "type": "@n8n/n8n-nodes-langchain.informationExtractor", "position": [2320, 1088], "parameters": {"text": "={{\n`Absender: ${$json.Absender_Name || ''}\nKunden-E-Mail: ${$json['Kunden_E-Mail'] || ''}\nBetreff: ${$json.Betreff || ''}\n\nE-MAIL-ANFRAGE:\n${$json.Anfrage || ''}\n\nPDF-ANHANG VORHANDEN:\n${$json.Hat_PDF_Anhang ? 'Ja' : 'Nein'}\n\nPDF-TITEL:\n${$json.PDF_Titel || 'Nicht vorhanden'}\n\nINHALT DES PDF-ANHANGS:\n${$json.PDF_Text || 'Kein PDF-Inhalt vorhanden.'}`\n}}", "options": {}, "attributes": {"attributes": [{"name": "=Kundenname", "required": true, "description": "Vollst\u00e4ndiger Name des Kunden aus dem Nachrichtentext. Nicht den technischen Absendernamen verwenden. Wenn nicht vorhanden: Nicht angegeben."}, {"name": "Strasse_Hausnummer", "required": true, "description": "Stra\u00dfe und Hausnummer des Ausf\u00fchrungsortes. Wenn nicht vorhanden: Nicht angegeben."}, {"name": "Ort", "required": true, "description": "Ort des Ausf\u00fchrungsortes. Wenn nicht vorhanden: Nicht angegeben."}, {"name": "Projektart", "required": true, "description": "Kurze passende Projektart, zum Beispiel Innenanstrich, Fassadenanstrich, Renovierung, Neubau, Gewerbe, B\u00fcro oder Treppenhaus."}, {"name": "Leistungsbeschreibung", "required": true, "description": "Vollst\u00e4ndige sachliche Zusammenfassung aller gew\u00fcnschten Arbeiten, Fl\u00e4chen, Materialien und Ausf\u00fchrungsw\u00fcnsche. Keine Preise erfinden."}, {"name": "Ist_Angebotsanfrage", "type": "boolean", "required": true, "description": "Wahr, wenn tats\u00e4chlich ein Angebot oder Kostenvoranschlag f\u00fcr Arbeiten angefragt wird. Falsch bei Terminantworten, Werbung, Newslettern oder anderen E-Mails."}, {"name": "PLZ", "required": true, "description": "Nur die f\u00fcnfstellige Postleitzahl als Text ausgeben. F\u00fchrende Nullen erhalten. Wenn nicht vorhanden: Nicht angegeben."}, {"name": "PDF_Ist_Leistungsverzeichnis", "type": "boolean", "required": true, "description": "Wahr nur, wenn der PDF-Inhalt ein Leistungsverzeichnis, eine Leistungsaufstellung oder projektbezogene Unterlage mit auszuf\u00fchrenden Arbeiten enth\u00e4lt. Bei Planern, Werbung, fachfremden Dokumenten oder fehlendem PDF immer falsch."}, {"name": "LV_Leistungen", "description": "Alle im PDF konkret genannten auszuf\u00fchrenden Leistungen oder Positionen kompakt zusammenfassen. Nichts erfinden. Ohne relevante Angaben leer lassen."}, {"name": "LV_Materialien", "description": "Alle konkret genannten Materialien und Produkte inklusive Typ oder Eigenschaften \u00fcbernehmen. Niemals Preise oder Rabatte sch\u00e4tzen. Ohne Angaben leer lassen."}, {"name": "LV_Mengen", "description": "Alle konkret genannten Mengen, Fl\u00e4chen, Ma\u00dfe, St\u00fcckzahlen und Einheiten positionsbezogen \u00fcbernehmen. Nichts erg\u00e4nzen oder berechnen. Ohne Angaben leer lassen."}]}}, "typeVersion": 1.2}, {"id": "aefc685a-8ec2-4bd7-9776-3b1b54f07e59", "name": "OpenAI-Chatmodell Angebotsdaten", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [2320, 1328], "parameters": {"model": {"__rl": true, "mode": "list", "value": "gpt-5-mini"}, "options": {}, "builtInTools": {}}, "credentials": {"openAiApi": {"id": "d83021c6ea6c47ee", "name": "Dummy openAiApi"}}, "typeVersion": 1.3}, {"id": "79c428e7-0b97-4b03-8315-738cfab152a3", "name": "Angebotsanfrage pr\u00fcfen", "type": "n8n-nodes-base.if", "position": [2544, 1088], "parameters": {"options": {}, "conditions": {"options": {"version": 3, "leftValue": "", "caseSensitive": true, "typeValidation": "strict"}, "combinator": "and", "conditions": [{"id": "355847ce-8ad1-40c7-a01d-4cd1590820f9", "operator": {"type": "boolean", "operation": "true", "singleValue": true}, "leftValue": "={{ $json.output.Ist_Angebotsanfrage }}", "rightValue": ""}]}}, "typeVersion": 2.3}, {"id": "1f323cfc-5f24-4b39-b956-c5fd42eee59f", "name": "Bestehende Angebote abrufen", "type": "n8n-nodes-base.googleSheets", "position": [2768, 1088], "parameters": {"options": {}, "sheetName": {"__rl": true, "mode": "list", "value": "gid=0", "cachedResultUrl": "https://docs.google.com/spreadsheets/d/18HTzdkvuVmXZbiT--jIjdJ8ykB7-5W2qNxpyMMVqdUg/edit#gid=0", "cachedResultName": "Tabellenblatt1"}, "documentId": {"__rl": true, "mode": "list", "value": "18HTzdkvuVmXZbiT--jIjdJ8ykB7-5W2qNxpyMMVqdUg", "cachedResultUrl": "https://docs.google.com/spreadsheets/d/18HTzdkvuVmXZbiT--jIjdJ8ykB7-5W2qNxpyMMVqdUg/edit?usp=drivesdk", "cachedResultName": "FLOW AI Angebote"}}, "credentials": {"googleSheetsOAuth2Api": {"id": "cbc1b5f60f3e43a0", "name": "Dummy googleSheetsOAuth2Api"}}, "typeVersion": 4.7}, {"id": "9a12112a-879c-449e-8b4c-4ff51d2ef35a", "name": "Angebotsentwurf vorbereiten", "type": "n8n-nodes-base.code", "position": [2992, 1088], "parameters": {"jsCode": "const vorhandeneAngebote = $input\n  .all()\n  .map(item => item.json);\n\nconst extrahiert =\n  $('Angebotsdaten aus E-Mail extrahieren')\n    .first()\n    .json\n    .output;\n\nconst emailDaten =\n  $('E-Mail-Daten vorbereiten')\n    .first()\n    .json;\n\nfunction textBereinigen(wert) {\n  if (wert === undefined || wert === null) {\n    return '';\n  }\n\n  return String(wert).trim();\n}\n\nconst istLeistungsverzeichnis =\n  extrahiert.PDF_Ist_Leistungsverzeichnis === true ||\n  String(\n    extrahiert.PDF_Ist_Leistungsverzeichnis\n  ).toLowerCase() === 'true';\n\nconst beschreibungsTeile = [];\n\nconst normaleLeistungsbeschreibung =\n  textBereinigen(\n    extrahiert.Leistungsbeschreibung\n  );\n\nif (normaleLeistungsbeschreibung) {\n  beschreibungsTeile.push(\n    normaleLeistungsbeschreibung\n  );\n}\n\nif (istLeistungsverzeichnis) {\n  const lvLeistungen =\n    textBereinigen(extrahiert.LV_Leistungen);\n\n  const lvMaterialien =\n    textBereinigen(extrahiert.LV_Materialien);\n\n  const lvMengen =\n    textBereinigen(extrahiert.LV_Mengen);\n\n  if (lvLeistungen) {\n    beschreibungsTeile.push(\n      `Leistungen aus dem Leistungsverzeichnis:\\n${lvLeistungen}`\n    );\n  }\n\n  if (lvMaterialien) {\n    beschreibungsTeile.push(\n      `Materialien aus dem Leistungsverzeichnis:\\n${lvMaterialien}`\n    );\n  }\n\n  if (lvMengen) {\n    beschreibungsTeile.push(\n      `Mengen aus dem Leistungsverzeichnis:\\n${lvMengen}`\n    );\n  }\n}\n\nconst leistungsbeschreibung =\n  beschreibungsTeile.join('\\n\\n');\n\nconst jahr = new Intl.DateTimeFormat('de-DE', {\n  timeZone: 'Europe/Berlin',\n  year: 'numeric'\n}).format(new Date());\n\nconst nummernMuster =\n  new RegExp(`^ANG-${jahr}-(\\\\d+)$`);\n\nlet hoechsteNummer = 0;\n\nfor (const angebot of vorhandeneAngebote) {\n  const treffer = String(\n    angebot.Angebotsnummer || ''\n  ).match(nummernMuster);\n\n  if (treffer) {\n    hoechsteNummer = Math.max(\n      hoechsteNummer,\n      Number(treffer[1])\n    );\n  }\n}\n\nconst naechsteNummer =\n  String(hoechsteNummer + 1).padStart(4, '0');\n\nreturn [\n  {\n    json: {\n      Angebotsnummer:\n        `ANG-${jahr}-${naechsteNummer}`,\n\n      Angebotsdatum: '',\n\n      Kundenname:\n        textBereinigen(extrahiert.Kundenname),\n\n      'Kunden_E-Mail':\n        textBereinigen(\n          emailDaten['Kunden_E-Mail']\n        ),\n\n      Strasse_Hausnummer:\n        textBereinigen(\n          extrahiert.Strasse_Hausnummer\n        ),\n\n      PLZ:\n        textBereinigen(extrahiert.PLZ),\n\n      Ort:\n        textBereinigen(extrahiert.Ort),\n\n      Projektart:\n        textBereinigen(extrahiert.Projektart),\n\n      Leistungsbeschreibung:\n        leistungsbeschreibung,\n\n      Gesamt_Netto: '',\n\n      MwSt_Prozent: 19,\n\n      Gesamt_Brutto: '',\n\n      Gueltig_bis: '',\n\n      Zahlungsbedingungen:\n        'Zahlbar innerhalb von 14 Tagen ohne Abzug',\n\n      Status: 'ENTWURF',\n\n      Angebotstext: '',\n\n      PDF_Link: ''\n    }\n  }\n];"}, "typeVersion": 2}, {"id": "01b661c2-933d-493e-9e5c-d1d7bceb07b1", "name": "Angebotsentwurf in Tabelle speichern", "type": "n8n-nodes-base.googleSheets", "position": [3200, 1088], "parameters": {"columns": {"value": {}, "schema": [{"id": "Angebotsnummer", "type": "string", "display": true, "removed": false, "required": false, "displayName": "Angebotsnummer", "defaultMatch": false, "canBeUsedToMatch": true}, {"id": "Angebotsdatum", "type": "string", "display": true, "removed": false, "required": false, "displayName": "Angebotsdatum", "defaultMatch": false, "canBeUsedToMatch": true}, {"id": "Kundenname", "type": "string", "display": true, "removed": false, "require