: lead.industry,\n  keywords: lead.keywords,\n  title: lead.title,\n  email_status: lead.email_status,\n  website: lead.website,\n  country: lead.country,\n  technologies: lead.technologies\n};"}, "typeVersion": 2}, {"id": "3b463972-a873-4fb4-9cf0-6c52e2288740", "name": "If Emails Available", "type": "n8n-nodes-base.if", "position": [4848, 320], "parameters": {"options": {}, "conditions": {"options": {"version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "strict"}, "combinator": "and", "conditions": [{"id": "eb720308-396f-40ff-91c1-3238ceed86f6", "operator": {"type": "boolean", "operation": "true", "singleValue": true}, "leftValue": "={{ $json.emails_available.toBoolean() }}", "rightValue": ""}]}}, "typeVersion": 2.2}, {"id": "a558421b-b82b-4289-a103-e4cbb040ee4a", "name": "Email Data", "type": "n8n-nodes-base.code", "position": [9072, 320], "parameters": {"jsCode": "const sequence = 1;\nconst uuid = $input.first().json.uuid;\n\nconst selectedEmailData = $('Check If Emails Available to Send Email').first().json.selected_email;\n\nconst emailObj = selectedEmailData?.list \n  ? selectedEmailData.list[0] \n  : selectedEmailData;\n\nconst emailSentFrom = emailObj['email inbox'] \n  || emailObj['email_inbox']\n  || '';\n\nreturn {\n  email_to: $('Lead Info').first().json.user_email,\n  email_sent_from: emailSentFrom,\n  email_subject: $input.first().json.output.subject,\n  email_body: $input.first().json.output.cold_email,\n  sequence,\n  image_tag: ``,\n  uuid,\n};"}, "typeVersion": 2}, {"id": "75e5692c-49f0-42db-878c-91612c0f49d8", "name": "Company Info", "type": "n8n-nodes-base.httpRequest", "onError": "continueErrorOutput", "position": [3184, 320], "parameters": {"url": "=http://remap-db-nocodb-8c9c42-52-63-253-187.traefik.me/api/v1/db/data/noco/piwdw78449e53ef/mix542wgvzzot41?limit=1", "options": {}, "sendHeaders": true, "headerParameters": {"parameters": [{"name": "xc-token", "value": "YOUR_NOCODB_API_TOKEN"}, {"name": "Content-Type", "value": "application/json"}]}}, "typeVersion": 4.2}, {"id": "8002d696-9037-4e87-89fa-d983005c446a", "name": "Get Leads Data", "type": "n8n-nodes-base.httpRequest", "onError": "continueErrorOutput", "position": [496, 1320], "parameters": {"url": "=http://remap-db-nocodb-8c9c42-52-63-253-187.traefik.me/api/v1/db/data/noco/piwdw78449e53ef/mod2sodnsu3ghfs?where=(Need of follow up?,eq,yes)&limit=500", "options": {}, "sendHeaders": true, "headerParameters": {"parameters": [{"name": "xc-token", "value": "YOUR_NOCODB_API_TOKEN"}, {"name": "Content-Type", "value": "application/json"}]}}, "typeVersion": 4.2}, {"id": "6ada1d30-88d5-420e-a05c-4368853e4706", "name": "Company Info 2", "type": "n8n-nodes-base.httpRequest", "onError": "continueErrorOutput", "position": [4848, 1320], "parameters": {"url": "=http://remap-db-nocodb-8c9c42-52-63-253-187.traefik.me/api/v1/db/data/noco/piwdw78449e53ef/mix542wgvzzot41?limit=1", "options": {}, "sendHeaders": true, "headerParameters": {"parameters": [{"name": "xc-token", "value": "YOUR_NOCODB_API_TOKEN"}, {"name": "Content-Type", "value": "application/json"}]}}, "typeVersion": 4.2}, {"id": "627101cf-6f41-4582-bc62-8971625edb5e", "name": "Filter 2nd Email Leads Data", "type": "n8n-nodes-base.executeWorkflow", "position": [1392, 1320], "parameters": {"options": {"waitForSubWorkflow": true}, "workflowId": {"__rl": true, "mode": "list", "value": "2OslOcofQpi_j7Zq_BABv", "cachedResultUrl": "/workflow/2OslOcofQpi_j7Zq_BABv", "cachedResultName": "1.3 = Filter Leads Data-v2"}, "workflowInputs": {"value": {"sequence": 1, "lead_data": "={{ $json.data }}"}, "schema": [{"id": "sequence", "type": "number", "display": true, "required": false, "displayName": "sequence", "defaultMatch": false, "canBeUsedToMatch": true}, {"id": "lead_data", "type": "array", "display": true, "required": false, "displayName": "lead_data", "defaultMatch": false, "canBeUsedToMatch": true}], "mappingMode": "defineBelow", "matchingColumns": [], "attemptToConvertTypes": false, "convertFieldsToString": true}}, "typeVersion": 1.2}, {"id": "dc6661ae-5456-4da6-b085-e898ef29a009", "name": "Update Email Sequence 2", "type": "n8n-nodes-base.code", "position": [944, 1320], "parameters": {"jsCode": "const rawData = $(\"Get Leads Data\").all();\n\n// NocoDB wraps data in list array\nconst leads = rawData.flatMap(item => item.json.list || []);\n\nreturn [{\n  json: {\n    sequence: 2,\n    data: leads\n  }\n}];"}, "typeVersion": 2}, {"id": "b56f9a93-e664-46c1-8b8e-b91fae8fb2c3", "name": "Split Out", "type": "n8n-nodes-base.splitOut", "position": [1840, 1320], "parameters": {"options": {}, "fieldToSplitOut": "result"}, "typeVersion": 1}, {"id": "2a231964-7cfd-4299-9321-fd0a486a0501", "name": "Prompt", "type": "n8n-nodes-base.code", "onError": "continueErrorOutput", "position": [5616, 1320], "parameters": {"jsCode": "return {\n  prompt: `\n<instructions>\nYou are an expert cold email writer. You write short, human emails that feel like a quick note from a real person, not a pitch from a company.\n\n<target_audience>\nYou are writing to small and mid-sized service-based businesses with 10 to 100 employees. The industries you will encounter are Engineering, Construction, Marketing and Digital Agencies, and Law Firms. These businesses are based primarily in Nashville, Columbus, Kansas City, Birmingham, and Louisville, with secondary markets in Raleigh, Indianapolis, Jacksonville, San Antonio, Oklahoma City, Memphis, Greenville, and Des Moines.\n\nBefore writing, identify which industry this prospect belongs to. Then use the relevant angle below:\n\n- Engineering or Construction: Focus on slow project timelines, lack of visibility on where time and money go, and manual processes that delay delivery. Use language around compressing timelines, eliminating delays, and turning messy processes into clear systems.\n- Marketing or Digital Agencies: Focus on manual reporting, slow client delivery cycles, and juggling too many tools. Use language around faster delivery, cleaner operations, and getting more done without adding headcount.\n- Law Firms: Focus on manual intake, slow document workflows, and time lost on non-billable admin tasks. Use language around cutting out the back and forth, freeing up billable hours, and getting client work out faster.\n\nIf the industry is unclear, use the prospect's posts and bio to make your best judgment.\n</target_audience>\n\n<prospect_data>\nFirst Name: ${$('Aggregate').first().json.data[0].Name.split(' ')[0]}\nCompany Name: ${$('Aggregate').first().json.data[0].Company}\n</prospect_data>\n\n<writing_rules>\nSTRICT RULES \u2014 follow every single one, no exceptions:\n- The email body MUST contain between 110 and 120 words. This is non-negotiable. Count every word before finalizing. The greeting \"Hi [First Name],\" counts. The CTA counts. Every word counts. If you are under 110, you MUST expand. Do not submit until count is 110 to 120.\n- Never use em dashes (\u2014). If you need to separate a thought, use a comma.\n- NEVER use ellipsis (...) anywhere in the email. Do not write \"...\" for any reason. Not between paragraphs, not as a transition, not anywhere. If you are about to write \"...\", stop and delete it.\n- No fluff words. No filler. No corporate buzzwords.\n- No fancy or hard words. Write like a real person texting a colleague.\n- No AI-sounding phrases. No words like \"leverage,\" \"unlock,\" \"robust,\" \"seamless,\" \"cutting-edge,\" \"revolutionary,\" \"synergy,\" \"furthermore,\" or \"I hope this finds you well.\"\n- No unnecessary quotation marks.\n- Reading grade level must be 8 or below.\n- Every paragraph is one or two lines max. Must look like a quick note sent from a phone.\n- Do not pitch the product directly. Build curiosity. Make them want to ask for more.\n- Do not make up features, results, or services. Only use what is in the RAG.\n- Never use promotional or spam trigger words.\n- 100% human tone throughout.\n- DO NOT add any links in the email body.\n</writing_rules>\n\n<format_rules>\nSTRICT FORMAT RULES \u2014 this controls how the email looks. Follow exactly:\n- Always open with: Hi [First Name],\n- Then leave one blank line.\n- Write each paragraph as 1 to 2 short lines only.\n- Leave one blank line between every paragraph.\n- The CTA is its own paragraph with a blank line above it.\n- The signature must always be a single HTML paragraph using a line break, exactly like this:\n<p>Best,<br>Nicole</p>\nDo not split the signature into two separate <p> tags. Never add a blank line between Best and Nicole.\n- The final output must be in HTML. Use <p> tags for each paragraph so spacing renders correctly in email clients.\n</format_rules>\n\n<email_structure>\nThis is the second email. The prospect has not replied yet. Do not mention that directly. Just reconnect naturally.\n\nStep 1 \u2014 Open with: Hi [First Name],\n\nStep 2 \u2014 First paragraph: Reference ONE article you found. Mention the publication name naturally, like \"I was reading something on Forbes the other day.\" One to two lines. Make it feel like you genuinely came across it.\n\nStep 3 \u2014 Second paragraph: In one to two lines, tie what you read to the specific friction they are likely dealing with based on their industry. No product name. Just connect the dots with enough detail to build toward the word count.\n\nStep 4 \u2014 Third paragraph: One to two lines. Hint that what you work with relates to what the article is talking about. Vague enough to spark curiosity, not close a sale.\n\nStep 5 \u2014 CTA paragraph: End with this exact line, word for word:\n\"If you want to learn more about it, I would be happy to send a PDF.\"\n\nStep 6 \u2014 Signature, as a single HTML paragraph:\n<p>Best,<br>Nicole</p>\n</email_structure>\n\n<subject_line_rules>\nIMPORTANT: You must pick ONE subject line from the pool below. Do not write your own subject line. Do not modify any subject line. Do not combine subject lines. Only use what is in the list below, exactly as written.\n\nPick the single most relevant one based on the prospect's industry and the article topic.\n\nCRITICAL: Replace {first_name} with the actual first name of the prospect. Do NOT output {first_name} as literal text. Always use the real value.\n\nFirst Name to use: ${$('Aggregate').first().json.data[0].Name.split(' ')[0]}\n\nSubject line pool:\n- {first_name}, was this on purpose?\n- {first_name}, this surprised me\n- {first_name}, this doesn't look intentional\n- {first_name}, this feels heavier than needed\n- {first_name}, unsure if this was on purpose\n- {first_name}, checking before assuming\n- {first_name}, I've seen this go sideways\n- {first_name}, curious about one thing I noticed\n- {first_name}, question about your workflow setup\n- {first_name}, this might deserve a look\n- {first_name}, small concern worth flagging\n- {first_name}, double-checking before I assume\n- {first_name}, sanity check on something I noticed\n- {first_name}, this seems to create drag\n\nOutput only the chosen subject line with real values substituted. Do not explain your choice. Do not write a new one.\n</subject_line_rules>\n\n<search>\nFind one recent article that shows how professionals or businesses in Engineering, Construction, Marketing, or Law are using AI automation or workflow tools to improve productivity, cut costs, or reduce manual work. Focus on real use cases. The article must NOT be from AI Smart Insiders. Use a neutral source. Use only ONE article. Never combine multiple articles.\n</search>\n\n<history>\nThis is the second follow-up email. The prospect has not replied yet.\nThe first email introduced our product and sparked curiosity.\nOriginal first email: ${$('Aggregate').first().json.data[0]['message 1']}\n</history>\n</instructions>\n\n<result>\nReturn ONLY a raw JSON object. No markdown. No code fences. No explanation. No text before or after. Start with { and end with }.\n\nFormat exactly: {\"email_subject\": \"...\", \"email_message\": \"...\"}\n\nThe email_message must be in HTML. Use <p> tags for every paragraph. Do not use markdown. Do not add any clickable links inside the email body. The signature must be a single <p> tag like this: <p>Best,<br>Nicole</p>\n</result>\n  `,\n};"}, "executeOnce": false, "retryOnFail": false, "typeVersion": 2}, {"id": "83e8d329-8ae4-40b8-8fb8-c02136923690", "name": "Open AI Search", "type": "n8n-nodes-base.httpRequest", "position": [6064, 1320], "parameters": {"url": "https://api.openai.com/v1/chat/completions", "method": "POST", "options": {}, "jsonBody": "={\n    \"model\": \"gpt-5.4-mini\",\n    \"messages\": [{\n        \"role\": \"user\",\n        \"content\": {{ JSON.stringify($json.prompt.trim()) }}\n    }]\n}", "sendBody": true, "sendHeaders": true, "specifyBody": "json", "headerParameters": {"parameters": [{"name": "Authorization", "value": "Bearer YOUR_TOKEN_HERE"}, {"name": "Content-type", "value": "application/json"}]}}, "typeVersion": 4.2}, {"id": "2051a629-c17c-4647-a1e5-c9c9a757e8c3", "name": "Email Fixing", "type": "n8n-nodes-base.code", "onError": "continueErrorOutput", "position": [6512, 1320], "parameters": {"jsCode": "// // Get the raw string\n// const raw = $input.first().json.choices[0].message.content;\n\n// // Remove the ```json and ``` wrappers\n// const cleaned = raw.replace(/```json|```/g, '').trim();\n\n// // Parse to object\n// const parsed = JSON.parse(cleaned);\n\n// // Get citation title safely from annotations\n// const citationTitle = $input.first().json.choices[0].message.annotations?.[0]?.url_citation?.title ?? \"\";\n\n// // Replace markdown links [text](url) \u2192 <a href=\"url\">TITLE</a>\n// const fixMarkdownLinks = (text, title) => {\n//   return text.replace(/\\[[^\\]]+\\]\\(([^)]+)\\)/g, `<a href=\"$1\">${title}</a>`);\n// };\n\n// // Clean the email_message\n// const email_message_fixed = fixMarkdownLinks(parsed.email_message, citationTitle);\n\n// // Return two separate properties\n// return {\n//   email_subject: parsed.email_subject,\n//   email_message: email_message_fixed\n// };\n\n\n\n\n\n// Get the raw string\nconst raw = $input.first().json.choices[0].message.content;\n\n// Remove the ```json and ``` wrappers\nconst cleaned = raw.replace(/```json|```/g, '').trim();\n\n// Helper: check if string looks like JSON\nconst isJsonLike = (str) => /^[\\{\\[]/.test(str);\n\n// Try to parse JSON, otherwise fall back to plain text handling\nlet parsed = null;\nlet email_subject = \"\";\nlet email_message = \"\";\n\nif (isJsonLike(cleaned)) {\n  try {\n    parsed = JSON.parse(cleaned);\n  } catch (e) {\n    // If parsing fails, we'll handle as plain text below\n    parsed = null;\n  }\n}\n\nif (parsed && typeof parsed === \"object\") {\n  // Original JSON-based logic\n  email_subject = parsed.email_subject ?? \"\";\n  email_message = parsed.email_message ?? \"\";\n} else {\n  // Fallback: treat `cleaned` as plain email text\n  const lines = cleaned.split(\"\\n\");\n  const firstLine = lines[0] ?? \"\";\n\n  if (/^Subject:/i.test(firstLine)) {\n    // \"Subject: ...\" on first line\n    email_subject = firstLine.replace(/^Subject:/i, \"\").trim();\n    email_message = lines.slice(1).join(\"\\n\").trim();\n  } else {\n    // No explicit \"Subject:\", use first line as subject\n    email_subject = firstLine.trim();\n    email_message = lines.slice(1).join(\"\\n\").trim();\n  }\n}\n\n// Get citation title safely from annotations\nconst citationTitle =\n  $input.first().json.choices[0].message.annotations?.[0]?.url_citation\n    ?.title ?? \"\";\n\n// Replace markdown links [text](url) \u2192 <a href=\"url\">TITLE</a>\nconst fixMarkdownLinks = (text, title) => {\n  if (!text) return \"\";\n  return text.replace(\n    /\\[[^\\]]+\\]\\(([^)]+)\\)/g,\n    `<a href=\"$1\">${title}</a>`\n  );\n};\n\n// Clean the email_message\nconst email_message_fixed = fixMarkdownLinks(email_message, citationTitle);\n\n// Return two separate properties\nreturn {\n  email_subject,\n  email_message: email_message_fixed,\n};\n"}, "executeOnce": false, "retryOnFail": false, "typeVersion": 2}, {"id": "94f7f718-7342-4b1a-8c76-a07dd7a34dd9", "name": "Get Leads Data1", "type": "n8n-nodes-base.httpRequest", "onError": "continueErrorOutput", "position": [496, 2320], "parameters": {"url": "=http://remap-db-nocodb-8c9c42-52-63-253-187.traefik.me/api/v1/db/data/noco/piwdw78449e53ef/mod2sodnsu3ghfs?where=(Need%20of%20follow%20up%3F,eq,yes)&limit=500", "options": {}, "sendHeaders": true, "headerParameters": {"parameters": [{"name": "xc-token", "value": "YOUR_NOCODB_API_TOKEN"}, {"name": "Content-Type", "value": "application/json"}]}}, "typeVersion": 4.2}, {"id": "7f2c21bc-4def-46bf-90c9-380086115a7d", "name": "Filter 2nd Email Leads Data1", "type": "n8n-nodes-base.executeWorkflow", "position": [1392, 2320], "parameters": {"options": {"waitForSubWorkflow": true}, "workflowId": {"__rl": true, "mode": "list", "value": "2OslOcofQpi_j7Zq_BABv", "cachedResultUrl": "/workflow/2OslOcofQpi_j7Zq_BABv", "cachedResultName": "1.3 = Filter Leads Data-v2"}, "workflowInputs": {"value": {"sequence": "={{ $json.sequence }}", "lead_data": "={{ $json.data }}"}, "schema": [{"id": "sequence", "type": "number", "display": true, "required": false, "displayName": "sequence", "defaultMatch": false, "canBeUsedToMatch": true}, {"id": "lead_data", "type": "array", "display": true, "required": false, "displayName": "lead_data", "defaultMatch": false, "canBeUsedToMatch": true}], "mappingMode": "defineBelow", "matchingColumns": [], "attemptToConvertTypes": false, "convertFieldsToString": true}}, "typeVersion": 1.2}, {"id": "88564e88-3b23-413f-8fd9-8cdf3b129b85", "name": "Split Out1", "type": "n8n-nodes-base.splitOut", "position": [1840, 2320], "parameters": {"options": {}, "fieldToSplitOut": "result"}, "typeVersion": 1}, {"id": "843f9aa4-16ba-4b00-bad5-448820d32d26", "name": "Get Leads Data2", "type": "n8n-nodes-base.httpRequest", "onError": "continueErrorOutput", "position": [496, 3320], "parameters": {"url": "=http://remap-db-nocodb