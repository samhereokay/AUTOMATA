{antwortText}\\n${email.snippet || \"\"}`;\n\nconst preisanfrageTreffer = suchText.match(/PA-ANG-\\d{4}-\\d+/i);\nconst angebotsTreffer = suchText.match(/ANG-\\d{4}-\\d+/i);\n\nconst preisanfrageId =\n  preisanfrageTreffer?.[0]?.toUpperCase() ||\n  (angebotsTreffer ? `PA-${angebotsTreffer[0].toUpperCase()}` : \"\");\n\nconst angebotsnummer =\n  angebotsTreffer?.[0]?.toUpperCase() || \"\";\n\nif (!preisanfrageId || !angebotsnummer) {\n  throw new Error(\n    \"Preisanfrage_ID oder Angebotsnummer konnte in der H\u00e4ndlerantwort nicht gefunden werden.\"\n  );\n}\n\nreturn [\n  {\n    json: {\n      Preisanfrage_ID: preisanfrageId,\n      Angebotsnummer: angebotsnummer,\n      Grosshaendler_Absender: absender,\n      Betreff: betreff,\n      Haendlerantwort_Text: antwortText.trim(),\n      Gmail_Thread_ID: email.threadId || \"\",\n      Gmail_Message_ID: email.id || \"\",\n      Antwortdatum: new Date(\n        Number(email.internalDate) || Date.now()\n      ).toLocaleDateString(\"de-DE\"),\n      Status: \"ANTWORT_ERHALTEN\"\n    }\n  }\n];"}, "typeVersion": 2}, {"id": "658e7025-3b8c-4040-902b-ee791107abdb", "name": "H\u00e4ndlerantwort in Tabelle speichern", "type": "n8n-nodes-base.googleSheets", "position": [3088, 2272], "parameters": {"columns": {"value": {"Status": "=ANGEBOT_AUSGEWERTET", "Hinweise": "={{ $json.output[0].content[0].text.Hinweise }}", "Lieferzeit": "={{ $json.output[0].content[0].text.Lieferzeit }}", "Positionen": "={{ $json.output[0].content[0].text.Positionen }}", "Gueltig_bis": "={{ $json.output[0].content[0].text.Gueltig_bis }}", "Lieferkosten": "={{ $json.output[0].content[0].text.Lieferkosten }}", "Grosshaendler": "={{ $json.output[0].content[0].text.Haendlername }}", "Mehrwertsteuer": "={{ $json.output[0].content[0].text.Mehrwertsteuer }}", "Preisanfrage_ID": "={{ $json.output[0].content[0].text.Preisanfrage_ID }}", "Zusammenfassung": "={{ $json.output[0].content[0].text.Zusammenfassung }}", "Gesamtpreis_netto": "={{ $json.output[0].content