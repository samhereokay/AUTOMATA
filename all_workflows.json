c8ff40-8232-4683-950a-37fa60d87eb2", "name": "Convert HTML to Markdown", "type": "n8n-nodes-base.markdown", "notes": "Markdown is more friendly LLM format than HTML", "position": [-240, -200], "parameters": {"html": "={{ $json.data }}", "options": {"ignore": "img,form", "blockElements": ""}}, "notesInFlow": true, "typeVersion": 1}, {"id": "6708c44c-e1a5-4f2b-9780-c980c7a95053", "name": "Append Aummary to Google Sheets", "type": "n8n-nodes-base.googleSheets", "position": [580, -40], "parameters": {"columns": {"value": {"link": "={{ $('Loop Over Rss Elements').item.json.link }}", "title": "={{ $('Loop Over Rss Elements').item.json.title }}", "source": "={{ $('Loop Over Rss Elements').item.json[\"RSS NAME\"] }}", "pubDate": "={{ $('Loop Over Rss Elements').item.json.pubDate.toDateTime().format('yyyy-MM-dd HH:mm').toDateTime() }}", "ai summary": "={{ $json.text }}", "categories": "={{ $('Loop Over Rss Elements').item.json.categories.toJsonString() }}"}, "schema": [{"id": "pubDate", "type": "string", "display": true, "required": false, "displayName": "pubDate", "defaultMatch": false, "canBeUsedToMatch": true}, {"id": "source", "type": "string", "display": true, "removed": false, "required": false, "displayName": "source", "defaultMatch": false, "canBeUsedToMatch": true}, {"id": "title", "type": "string", "display": true, "required": false, "displayName": "title", "defaultMatch": false, "canBeUsedToMatch": true}, {"id": "link", "type": "string", "display": true, "removed": false, "required": false, "displayName": "link", "defaultMatch": false, "canBeUsedToMatch": true}, {"id": "categories", "type": "string", "display": true, "required": false, "displayName": "categories", "defaultMatch": false, "canBeUsedToMatch": true}, {"id": "ai summary", "type": "string", "display": true, "required": false, "displayName": "ai summary", "defaultMatch": false, "canBeUsedToMatch": true}], "mappingMode": "defineBelow", "matchingColumns": ["link"], "attemptToConvertTypes": false, "convertFieldsToString": false}, "options": {"useAppend": true, "cellFormat": "RAW"}, "operation": "appendOrUpdate", "sheetName": {"__rl": true, "mode": "url", "value": "={{ $('Settings').item.json[\"Articles Sheet\"] }}"}, "documentId": {"__rl": true, "mode": "url", "value": "={{ $('Settings').item.json.Document }}"}}, "credentials": {"googleSheetsOAuth2Api": {"id": "cbc1b5f60f3e43a0", "name": "Dummy googleSheetsOAuth2Api"}}, "typeVersion": 4.6}, {"id": "366e157b-9ff0-4913-b993-7d37c3252fe2", "name": "Combine Rss with source name", "type": "n8n-nodes-base.set", "position": [-1660, 480], "parameters": {"options": {}, "assignments": {"assignments": [{"id": "72a6cb17-fefb-44c6-b2d5-348ce57e8270", "name": "RSS NAME", "type": "string", "value": "={{ $('Loop Over Items').item.json[\"RSS NAME\"] }}"}]}, "includeOtherFields": true}, "typeVersion": 3.4}, {"id": "29f5c69a-c6ea-4191-bff5-914044efb76e", "name": "Check If Article Exists", "type": "n8n-nodes-base.if", "notes": "We check if the object is empty", "position": [-900, -180], "parameters": {"options": {}, "conditions": {"options": {"version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "strict"}, "combinator": "and", "conditions": [{"id": "f2fe5727-5ae3-40fe-86c5-e2ad6288303b", "operator": {"type": "object", "operation": "empty", "singleValue": true}, "leftValue": "={{ $item(\"0\").$node[\"Get Row for URL is in Sheets\"].json }}", "rightValue": ""}]}}, "notesInFlow": true, "typeVersion": 2.2}, {"id": "a3e91192-55c8-4384-8d2e-fc6cc7321c98", "name": "Summarize Content", "type": "@n8n/n8n-nodes-langchain.chainLlm", "position": [-20, -200], "parameters": {"text": "=Hi Gemma Summarize This:\n\n<basic_information>\n- Date: {{ $('Loop Over Rss Elements').item.json.isoDate }}\n- Title: {{ $('Loop Over Rss Elements').item.json.title }}\n- Author/Source: {{ $('Loop Over Rss Elements').item.json.creator }} / {{ $('Loop Over Rss Elements').item.json.link }}\n- Category: {{ $('Loop Over Rss Elements').item.json.categories.toJsonString() }}\n</basic_information>\n\n<content>\n{{ $json.data }}\n</content>\n\nResponse immediately without any introductory text, explanations, or commentary.", "batching": {}, "messages": {"messageValues": [{"message": "=You Are Gemma.\n<role>\nGemma is an expert at creating concise, valuable article summaries. She can process content from various domains and specializes in extracting key information and practical insights from any type of article.\n</role>\n\n<task>\nGemma create a structured summary format of the provided article, preserving key information and practical insights.\n</task>\n\n<steps>\n- Identify main content of sended by user.\n- Prepare summary, when writing use <writing_guidelines>.\n- Make quality control based on <quality_control>.\n- Output summary driectly in Markdown frmat following <structured_summary_format>. Check <output_formatting> for guidelines.\n</steps>\n\n<writing_guidelines>\nSHOULD DO:\n- Use simple, understandable language.\n- Maintain objectivity and accuracy.\n- Extract practical insights.\n- Emphasize specific data and numbers.\n- Prioritize actionable information.\n- Adjust detail level to article length.\n- Use bullet points for better readability.\n\nSHOULD AVOID:\n- Adding her own opinions beyond the article.\n- Repeating information in different sections.\n- Using jargon without explanation.\n- Omitting important caveats/limitations.\n- Exceeding 300 words in total summary.\n- Copying entire fragments verbatim.\n</writing_guidelines>\n\n<special_cases>\n- FOR TECHNICAL ARTICLES: Gemma should explain complex terms, highlight technical requirements, and note implementation difficulty level.\n- FOR BUSINESS ARTICLES: Gemma should focus on ROI and metrics, highlight potential costs/benefits, and note target audience.\n- FOR CASE STUDIES: Gemma should describe context and challenge, present applied solution, and highlight results and success metrics.\n- TONE AND STYLE: Gemma should maintain a professional but accessible tone that is concise and concrete, focused on reader value, and action-oriented.\n</special_cases>\n\n<quality_control>\nBefore finalizing, Gemma should check:\n- Does the summary capture the essence of the article?\n- Are all sections filled?\n- Is the information accurate and verified?\n- Is the length appropriate?\n- Does the summary have practical value?\n</quality_control>\n\n<structured_summary_format>\n[1-5 sentences describing the main message of the article]\n\n## QUICK TAKEAWAYS\n\n- [3-5 most important conclusions in bullet format]\n\n## KEY POINTS\n\n- [Most important point 1]\n- [Most important point 2]\n- [Most important point 3]\n- [Most important point 4-5 if relevant]\n\n## PRACTICAL INSIGHTS\n\n- [Specific actions/recommendations]\n- [Tools/methods mentioned in the article]\n- [Metrics/numerical data if relevant]\n\n## PRACTICAL APPLICATION\n\n[How this information can be applied in business/life/relevant field]\n</structured_summary_format>\n\n<output_formatting>\nResponse immediately without any introductory text, explanations, or commentary.\nOutput formatting is Markdown.\nDo not start with block indicators (``` ```)\nYOU CAN NOT USE :\n- \"Here's a breakdown\", \n- \"Here's the summary\",\n- \"Okay, here's a breakdown of the provided text, categorized and summarized for clarity\",\n- or any other preamble. Go directly to the structured summary format.\n</output_formatting>"}]}, "promptType": "define"}, "retryOnFail": true, "typeVersion": 1.7}, {"id": "6edc03ae-3932-4b6d-b8f1-98cb2e51f4cb", "name": "Format Output", "type": "n8n-nodes-base.set", "position": [320, -200], "parameters": {"options": {}, "assignments": {"assignments": [{"id": "52023808-641d-4f4d-9c8f-b51c9b3bbbd1", "name": "text", "type": "string", "value": "={{ $json.text.replace(/<think>[\\s\\S]*?<\\/think>/g, '') }}"}]}}, "typeVersion": 3.4}, {"id": "02eb922d-ae5c-4029-a01a-3a279989fa1c", "name": "Schedule Trigger", "type": "n8n-nodes-base.scheduleTrigger", "position": [-3080, 180], "parameters": {"rule": {"interval": [{"field": "hours"}]}}, "typeVersion": 1.2}, {"id": "131b0ae1-bc12-48d8-a20d-bbffbf9b6bee", "name": "Loop Over Items", "type": "n8n-nodes-base.splitInBatches", "position": [-2100, 280], "parameters": {"options": {}}, "typeVersion": 3}, {"id": "28c1347b-e54e-405e-ab0a-da6a422187da", "name": "Filter Last X Days", "type": "n8n-nodes-base.filter", "notes": "This filter only news from last x days", "position": [-1740, -200], "parameters": {"options": {}, "conditions": {"options": {"version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "strict"}, "combinator": "and", "conditions": [{"id": "516c4ec9-fc16-4687-a376-86a79115afc8", "operator": {"type": "dateTime", "operation": "after"}, "leftValue": "={{ $json.pubDate }}", "rightValue": "={{ $('Settings').item.json['Current Time'].toDateTime().minus($('Settings').item.json['Last X Days'],'days').startOf('day') }}"}]}}, "notesInFlow": true, "typeVersion": 2.2}, {"id": "852a3623-87a1-4a96-99f4-eb8303ab7c2c", "name": "Settings", "type": "n8n-nodes-base.set", "notes": "Set Here Your Gogle Sheets URLs and Last x Days Filter", "position": [-2640, 280], "parameters": {"options": {}, "assignments": {"assignments": [{"id": "93e02cc9-f9c9-4167-ad2c-688433aa9b36", "name": "Document", "type": "string", "value": "https://docs.google.com/spreadsheets/d/1i1p_DPymm8QeZrCLxs-Skz8BMSutKpUW4khzpiNBcYc/edit?gid=0#gid=0"}, {"id": "c95234c3-baff-4dd6-a3ec-3a97a10e44c1", "name": "Articles Sheet", "type": "string", "value": "https://docs.google.com/spreadsheets/d/1i1p_DPymm8QeZrCLxs-Skz8BMSutKpUW4khzpiNBcYc/edit?gid=0#gid=0"}, {"id": "c94d9441-3b2b-421b-bb57-cfa041b132d6", "name": "Rss Feeds", "type": "string", "value": "https://docs.google.com/spreadsheets/d/1i1p_DPymm8QeZrCLxs-Skz8BMSutKpUW4khzpiNBcYc/edit?gid=255338052#gid=255338052"}, {"id": "94b40b88-6c7f-4bdf-8896-c8b9a4f6621f", "name": "Current Time", "type": "string", "value": "={{ \n  $workflow.trigger === 'Schedule Trigger' ? \n  $('Schedule Trigger').item.json.timestamp : \n  $now \n}}"}, {"id": "eba798d1-5a87-4446-bdc4-63e8a27bc510", "name": "Last X Days", "type": "number", "value": 31}]}}, "notesInFlow": true, "typeVersion": 3.4}, {"id": "7f3236e0-025d-496e-aacc-c74f15df3ec2", "name": "LLM Chat Model", "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter", "notes": "You can choose other LLM chat model", "position": [-60, -20], "parameters": {"model": "google/gemini-2.5-flash", "options": {"temperature": 0.3, "responseFormat": "text"}}, "credentials": {"openRouterApi": {"id": "33acfcf472e645a3", "name": "Dummy openRouterApi"}}, "typeVersion": 1}, {"id": "e4b8e1da-e960-4774-8419-0ffce5df9b3f", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [-2720, 40], "parameters": {"width": 300, "height": 460, "content": "## Settings\n\n- Copy this Google Sheet : https://docs.google.com/spreadsheets/d/1i1p_DPymm8QeZrCLxs-Skz8BMSutKpUW4khzpiNBcYc/copy\n- Enter copied URL's in settings\n- Set up time gap for news from RSS"}, "typeVersion": 1}, {"id": "472a0cbb-2b01-48c1-8472-8b0962269a80", "name": "Sticky Note1", "type": "n8n-nodes-base.stickyNote", "position": [-2220, 220], "parameters": {"width": 1060, "height": 560, "content": "## Loop for adding source name to RSS record"}, "typeVersion": 1}, {"id": "94ead111-4efe-459d-9053-3ff7714d5b98", "name": "End of worfklow", "type": "n8n-nodes-base.noOp", "position": [-1120, -460], "parameters": {}, "typeVersion": 1}, {"id": "5e470cd5-23c9-4866-a18c-694bf1c021a9", "name": "Get Webpage HTML Content", "type": "n8n-nodes-base.httpRequest", "position": [-660, -200], "parameters": {"url": "={{ $('Loop Over Rss Elements').item.json.link }}", "options": {"response": {"response": {"responseFormat": "text"}}}}, "typeVersion": 4.2}, {"id": "8bc1cad5-fbbc-43fa-b41f-e668bf9bd8f8", "name": "Extract Body Content in HTML", "type": "n8n-nodes-base.html", "notes": "We need only body without images", "position": [-460, -200], "parameters": {"options": {"trimValues": true, "cleanUpText": true}, "operation": "extractHtmlContent", "extractionValues": {"values": [{"key": "data", "cssSelector": "body", "returnValue": "html"}]}}, "typeVersion": 1.2}, {"id": "68bb881d-8c0c-4c21-9fab-237bcc42f76e", "name": "Sticky Note2", "type": "n8n-nodes-base.stickyNote", "position": [-1080, 300], "parameters": {"color": 4, "width": 760, "height": 280, "content": "## Google Sheets Columns\nGoogle Sheet Template: https://docs.google.com/spreadsheets/d/1i1p_DPymm8QeZrCLxs-Skz8BMSutKpUW4khzpiNBcYc/\n### Articles Sheet\n| pubDate    | source | title | link | categories | ai summary |\n### RSS FEEDS\n| RSS NAME | RSS URL | \n"}, "typeVersion": 1}, {"id": "396e077e-aba2-4b89-bb0b-7aece91b924b", "name": "Sticky Note3", "type": "n8n-nodes-base.stickyNote", "position": [-3840, -540], "parameters": {"width": 700, "height": 1680, "content": "# Monitor RSS feeds with AI summaries to Google Sheets\n\n## What this workflow does\n\nThis automation monitors multiple RSS feeds, filters new articles from the last X days, checks for duplicates, and generates AI-powered summaries. It fetches full article content, converts HTML to markdown, and uses Gemini AI to create structured summaries with quick takeaways, key points, and practical insights. All data is automatically saved to Google Sheets.\n\n## How it works\n\n1. **Read RSS feeds** from Google Sheets configuration\n2. **Filter articles** from the last X days (configurable)\n3. **Check for duplicates** by comparing URLs with existing Google Sheets data\n4. **Fetch full content** from article URLs\n5. **Convert HTML to Markdown** for better AI processing\n6. **Generate AI summaries** using Gemini AI with structured format\n7. **Save to Google Sheets** with article details and AI summary\n\n## Quick Setup\n\n1. **Copy the Google Sheet template**: https://docs.google.com/spreadsheets/d/1i1p_DPymm8QeZrCLxs-Skz8BMSutKpUW4khzpiNBcYc/copy\n\n2. **Update Settings node** with your copied Google Sheets URLs:\n   - Document URL (main sheet)\n   - Articles Sheet URL \n   - RSS Feeds Sheet URL\n\n3. **Add your RSS feeds** to the \"RSS FEEDS\" tab in your Google Sheet:\n   - RSS NAME (source name)\n   - RSS URL (feed URL)\n\n4. **Configure credentials**:\n   - Google Sheets OAuth2 API\n   - OpenRouter API key for Gemini AI\n\n5. **Adjust time filter** in Settings node (default: last 31 days)\n\n## Google Sheets Structure\n\n### Articles Sheet Columns\n| pubDate | source | title | link | categories | ai summary |\n\n### RSS FEEDS Sheet Columns  \n| RSS NAME | RSS URL |\n\n## Customization Options\n\n- **Change AI model**: Replace LLM Chat Model node with different provider\n- **Modify summary format**: Edit the AI prompt in \"Summarize Content\" node\n- **Adjust time filter**: Change \"Last X Days\" value in Settings node\n- **Add more data fields**: Extend Google Sheets columns and mapping\n\n## Scheduling\n\n- **Manual trigger**: Click \"Execute workflow\" button\n- **Automatic**: Runs every hour using Schedule Trigger (configurable)\n"}, "typeVersion": 1}, {"id": "webhook-automata-injected-1791111470595682", "name": "Automata Webhook", "type": "n8n-nodes-base.webhook", "position": [0, 0], "webhookId": "4ugQDSCMUWFpn5qo", "parameters": {"path": "4ugQDSCMUWFpn5qo", "options": {}, "httpMethod": "POST", "responseCode": 200, "responseMode": "onReceived"}, "typeVersion": 1.1}]
nYC0otQvaIDx36qW|[{"id": "dc33af70-53b6-44b0-95c9-7720ea5c6db6", "name": "Overview", "type": "n8n-nodes-base.stickyNote", "position": [-1008, -16], "parameters": {"width": 704, "height": 760, "content": "## Social Media Content + Image Generator (Claude/Gemini/OpenAI)\n\n### How it works\n\nThe workflow contains no nodes, so there is no executable automation to analyze. No triggers, processing steps, or outputs are currently defined on the canvas.\n\n### Setup steps\n\n- Add at least one trigger node to start the workflow.\n- Add processing and output nodes as needed, then configure any required credentials.\n\n### Customization\n\nOnce nodes are added, they can be grouped by their canvas position and role in the automation."}, "typeVersion": 1}, {"id": "a0cc85c9-b380-418e-9f9e-2c0302e7e814", "name": "Input", "type": "n8n-nodes-base.stickyNote", "position": [-256, -16], "parameters": {"color": 7, "width": 1100, "height": 756, "content": "## 1. Receive, settings, validate & route\n\ud83d\udd18 **Settings** node = master switches. Toggle `image_generation_enabled` ON/OFF (OFF = text only, image skipped for every request).\n`provider`: `claude` (default), `gemini` or `openai`."}, "typeVersion": 1}, {"id": "83d10128-f9b3-4ff4-bab6-9ed8223dd4be", "name": "Generate", "type": "n8n-nodes-base.stickyNote", "position": [864, -16], "parameters": {"color": 7, "width": 736, "height": 1360, "content": "## 2. Generate\n\u26a0\ufe0f Set credentials on the chat model nodes: **Anthropic** (top), **Google Gemini** (middle), **OpenAI** (bottom). Only the ones you use are required."}, "typeVersion": 1}, {"id": "be6d7f0d-bcc8-488a-97ce-dfee8bcd2a8e", "name": "Respond", "type": "n8n-nodes-base.stickyNote", "position": [2592, 336], "parameters": {"color": 7, "width": 388, "height": 520, "content": "## 4. Respond\nJSON response to the webhook caller."}, "typeVersion": 1}, {"id": "14adf13b-66c0-4295-b4c6-4b5743c1223c", "name": "Webhook", "type": "n8n-nodes-base.webhook", "position": [-192, 400], "webhookId": "618fdadb-fffa-4aff-ad3a-19c1b31e7752", "parameters": {"path": "social-content", "options": {}, "httpMethod": "POST", "responseMode": "responseNode"}, "typeVersion": 2}, {"id": "66aa8f1f-6b48-47b6-8da7-249858b95314", "name": "Validate Input", "type": "n8n-nodes-base.code", "position": [272, 400], "parameters": {"jsCode": "// Normalise and validate the incoming webhook payload\nconst body = $input.first().json.body || {};\nconst str = v => (typeof v === 'string' ? v.trim() : '');\n\nconst topic = str(body.topic);\nconst context = str(body.context);\nconst errors = [];\nlet provider = (str(body.provider) || 'claude').toLowerCase();\nif (['chatgpt', 'gpt'].includes(provider)) provider = 'openai';\nif (!['claude', 'gemini', 'openai'].includes(provider)) errors.push('\"provider\" must be \"claude\", \"gemini\" or \"openai\"');\nif (!topic) errors.push('\"topic\" is required');\nif (!context) errors.push('\"context\" is required');\nif (topic.length > 300) errors.push('\"topic\" must be 300 characters or fewer');\nif (context.length > 8000) errors.push('\"context\" must be 8000 characters or fewer');\nconst image_generation_enabled = $input.first().json.image_generation_enabled !== false; // master switch from Settings\nconst generate_image = image_generation_enabled && (body.generate_image === undefined ? true : !(body.generate_image === false || String(body.generate_image).toLowerCase() === 'false'));\nconst image_size = str(body.image_size) || '1024x1024';\nif (!['1024x1024', '1024x1536', '1536x1024'].includes(image_size)) errors.push('\"image_size\" must be 1024x1024, 1024x1536 or 1536x1024');\nconst image_provider = (str(body.image_provider) || (provider === 'openai' ? 'openai' : 'gemini')).toLowerCase().replace(/^(chatgpt|gpt)$/, 'openai');\nif (!['openai', 'gemini'].includes(image_provider)) errors.push('\"image_provider\" must be \"openai\" or \"gemini\"');\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    provider,\n    topic,\n    context,\n    tone: str(body.tone) || 'professional, insightful and approachable',\n    audience: str(body.audience) || 'business professionals and decision makers',\n    brand: str(body.brand) || 'not specified',\n    cta: str(body.cta) || 'none',\n    language: str(body.language) || 'English',\n    image_generation_enabled,\n    generate_image,\n    image_size,\n    image_provider,\n    image_style: str(body.image_style) || 'clean, modern, professional editorial photography style',\n  }\n}];"}, "typeVersion": 2}, {"id": "95935712-c597-40d2-8b6b-42aaf4dcfb20", "name": "Is Valid?", "type": "n8n-nodes-base.if", "position": [448, 400], "parameters": {"options": {}, "conditions": {"options": {"version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "strict"}, "combinator": "and", "conditions": [{"id": "eaef4294-fdf0-4544-a91f-01c5f46b77bc", "operator": {"type": "boolean", "operation": "true", "singleValue": true}, "leftValue": "={{ $json.valid }}", "rightValue": ""}]}}, "typeVersion": 2.2}, {"id": "d80db3a2-96ef-4dd6-afa2-6220a9b5f8d5", "name": "Generate Social Content (Claude)", "type": "@n8n/n8n-nodes-langchain.chainLlm", "onError": "continueErrorOutput", "position": [1104, 128], "parameters": {"text": "=Topic: {{ $json.topic }}\n\nContext:\n{{ $json.context }}\n\nTone: {{ $json.tone }}\nTarget audience: {{ $json.audience }}\nBrand / author: {{ $json.brand }}\nCall to action (optional): {{ $json.cta }}\nLanguage: {{ $json.language }}\n\nGenerate the content for all four platforms.", "messages": {"messageValues": [{"message": "You are a senior social media strategist and copywriter. You turn one topic plus supporting context into platform-native posts for LinkedIn, X (Twitter), Facebook and Instagram.\n\nRules:\n- Write natively for each platform; never paste the same text everywhere.\n- LinkedIn: strong 1-2 line hook, short paragraphs, practical insight, clear CTA or question at the end. 150-250 words. 3-5 hashtags.\n- X: one standalone post of max 280 characters AND a 4-7 tweet thread, each tweet max 280 characters, first tweet is the hook. Max 2 hashtags.\n- Facebook: conversational, 60-120 words, ends with an engagement question. 2-3 hashtags.\n- Instagram: caption with a hook in the first line, line breaks, emojis used sparingly, CTA. 8-15 relevant hashtags. Also suggest one image/visual idea.\n- Only use facts from the provided context. Do not invent statistics, names, quotes or links.\n- Hashtags must include the # symbol and contain no spaces.\n- Return ONLY the structured output requested."}]}, "promptType": "define", "hasOutputParser": true}, "typeVersion": 1.5}, {"id": "d39dc4d2-3944-4336-9535-532437b8f617", "name": "Anthropic Chat Model", "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic", "position": [1104, 352], "parameters": {"model": {"__rl": true, "mode": "list", "value": "claude-sonnet-4-5-20250929", "cachedResultName": "Claude Sonnet 4.5"}, "options": {"temperature": 0.7, "maxTokensToSample": 4096}}, "typeVersion": 1.3}, {"id": "b9d88ec5-35ff-44b4-8943-1ce80aca85fd", "name": "Structured Output Parser", "type": "@n8n/n8n-nodes-langchain.outputParserStructured", "position": [1248, 352], "parameters": {"schemaType": "manual", "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"linkedin\": {\"type\": \"object\", \"properties\": {\"post\": {\"type\": \"string\"}, \"hashtags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}, \"required\": [\"post\", \"hashtags\"]},\n    \"twitter\": {\"type\": \"object\", \"properties\": {\"single_post\": {\"type\": \"string\"}, \"thread\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"hashtags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}, \"required\": [\"single_post\", \"thread\", \"hashtags\"]},\n    \"facebook\": {\"type\": \"object\", \"properties\": {\"post\": {\"type\": \"string\"}, \"hashtags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}, \"required\": [\"post\", \"hashtags\"]},\n    \"instagram\": {\"type\": \"object\", \"properties\": {\"caption\": {\"type\": \"string\"}, \"hashtags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"image_idea\": {\"type\": \"string\"}}, \"required\": [\"caption\", \"hashtags\", \"image_idea\"]}\n  },\n  \"required\": [\"linkedin\", \"twitter\", \"facebook\", \"instagram\"]\n}"}, "typeVersion": 1.2}, {"id": "46ae7f40-f231-4362-a3db-4e31750f51cd", "name": "Respond Success", "type": "n8n-nodes-base.respondToWebhook", "position": [2720, 464], "parameters": {"options": {"responseCode": 200}, "respondWith": "json", "responseBody": "={{ JSON.stringify({ success: true, provider: $('Validate Input').first().json.provider, topic: $('Validate Input').first().json.topic, generated_at: $now.toISO(), content: $json.output, image: $json.image ?? null }) }}"}, "typeVersion": 1.1}, {"id": "cc92bc3a-f2c1-48da-a1c6-4436fcd40675", "name": "Respond LLM Error", "type": "n8n-nodes-base.respondToWebhook", "position": [2720, 672], "parameters": {"options": {"responseCode": 500}, "respondWith": "json", "responseBody": "={{ JSON.stringify({ success: false, provider: $('Validate Input').item.json.provider, error: 'Content generation failed', details: $json.error?.message || $json.error || 'unknown error' }) }}"}, "typeVersion": 1.1}, {"id": "156e8731-e623-432e-b481-1afc6906d79b", "name": "Respond Bad Request", "type": "n8n-nodes-base.respondToWebhook", "position": [672, 560], "parameters": {"options": {"responseCode": 400}, "respondWith": "json", "responseBody": "={{ JSON.stringify({ success: false, errors: $json.errors }) }}"}, "typeVersion": 1.1}, {"id": "ea35c476-6b6b-4fea-9438-43aac0e0187c", "name": "Generate Social Content (Gemini)", "type": "@n8n/n8n-nodes-langchain.chainLlm", "onError": "continueErrorOutput", "position": [1104, 544], "parameters": {"text": "=Topic: {{ $json.topic }}\n\nContext:\n{{ $json.context }}\n\nTone: {{ $json.tone }}\nTarget audience: {{ $json.audience }}\nBrand / author: {{ $json.brand }}\nCall to action (optional): {{ $json.cta }}\nLanguage: {{ $json.language }}\n\nGenerate the content for all four platforms.", "messages": {"messageValues": [{"message": "You are a senior social media strategist and copywriter. You turn one topic plus supporting context into platform-native posts for LinkedIn, X (Twitter), Facebook and Instagram.\n\nRules:\n- Write natively for each platform; never paste the same text everywhere.\n- LinkedIn: strong 1-2 line hook, short paragraphs, practical insight, clear CTA or question at the end. 150-250 words. 3-5 hashtags.\n- X: one standalone post of max 280 characters AND a 4-7 tweet thread, each tweet max 280 characters, first tweet is the hook. Max 2 hashtags.\n- Facebook: conversational, 60-120 words, ends with an engagement question. 2-3 hashtags.\n- Instagram: caption with a hook in the first line, line breaks, emojis used sparingly, CTA. 8-15 relevant hashtags. Also suggest one image/visual idea.\n- Only use facts from the provided context. Do not invent statistics, names, quotes or links.\n- Hashtags must include the # symbol and contain no spaces.\n- Return ONLY the structured output requested."}]}, "promptType": "define", "hasOutputParser": true}, "typeVersion": 1.5}, {"id": "878d80e6-8788-4287-bba1-f34d93f79ef4", "name": "Structured Output Parser (Gemini)", "type": "@n8n/n8n-nodes-langchain.outputParserStructured", "position": [1248, 768], "parameters": {"schemaType": "manual", "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"linkedin\": {\"type\": \"object\", \"properties\": {\"post\": {\"type\": \"string\"}, \"hashtags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}, \"required\": [\"post\", \"hashtags\"]},\n    \"twitter\": {\"type\": \"object\", \"properties\": {\"single_post\": {\"type\": \"string\"}, \"thread\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"hashtags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}, \"required\": [\"single_post\", \"thread\", \"hashtags\"]},\n    \"facebook\": {\"type\": \"object\", \"properties\": {\"post\": {\"type\": \"string\"}, \"hashtags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}, \"required\": [\"post\", \"hashtags\"]},\n    \"instagram\": {\"type\": \"object\", \"properties\": {\"caption\": {\"type\": \"string\"}, \"hashtags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"image_idea\": {\"type\": \"string\"}}, \"required\": [\"caption\", \"hashtags\", \"image_idea\"]}\n  },\n  \"required\": [\"linkedin\", \"twitter\", \"facebook\", \"instagram\"]\n}"}, "typeVersion": 1.2}, {"id": "ba45477a-3a43-4519-8d44-5795145bfafd", "name": "Google Gemini Chat Model", "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini", "position": [1104, 768], "parameters": {"options": {"temperature": 0.7, "maxOutputTokens": 4096}}, "credentials": {"googlePalmApi": {"id": "11a68a950433485d", "name": "Dummy googlePalmApi"}}, "typeVersion": 1}, {"id": "63d0e687-3811-43a5-a4ab-d495d8ee2617", "name": "Route by Provider", "type": "n8n-nodes-base.switch", "position": [656, 304], "parameters": {"rules": {"values": [{"outputKey": "Claude", "conditions": {"options": {"version": 2, "leftValue": "", "caseSensitive": false, "typeValidation": "strict"}, "combinator": "and", "conditions": [{"id": "edc74eba-defd-44cc-a043-8a379f4b514a", "operator": {"type": "string", "operation": "equals"}, "leftValue": "={{ $json.provider }}", "rightValue": "claude"}]}, "renameOutput": true}, {"outputKey": "Gemini", "conditions": {"options": {"version": 2, "leftValue": "", "caseSensitive": false, "typeValidation": "strict"}, "combinator": "and", "conditions": [{"id": "ce6a69ce-0bfd-46e2-9124-5653f0f10808", "operator": {"type": "string", "operation": "equals"}, "leftValue": "={{ $json.provider }}", "rightValue": "gemini"}]}, "renameOutput": true}, {"outputKey": "OpenAI", "conditions": {"options": {"version": 2, "leftValue": "", "caseSensitive": false, "typeValidation": "strict"}, "combinator": "and", "conditions": [{"id": "baaa54ef-a22c-48b7-beff-70951456e225", "operator": {"type": "string", "operation": "equals"}, "leftValue": "={{ $json.provider }}", "rightValue": "openai"}]}, "renameOutput": true}]}, "options": {}}, "typeVersion": 3.2}, {"id": "7112d357-cb08-4d79-a2f0-89fdd0116e0f", "name": "Generate Social Content (OpenAI)", "type": "@n8n/n8n-nodes-langchain.chainLlm", "onError": "continueErrorOutput", "position": [1088, 992], "parameters": {"text": "=Topic: {{ $json.topic }}\n\nContext:\n{{ $json.context }}\n\nTone: {{ $json.tone }}\nTarget audience: {{ $json.audience }}\nBrand / author: {{ $json.brand }}\nCall to action (optional): {{ $json.cta }}\nLanguage: {{ $json.language }}\n\nGenerate the content for all four platforms.", "messages": {"messageValues": [{"message": "You are a senior social media strategist and copywriter. You turn one topic plus supporting context into platform-native posts for LinkedIn, X (Twitter), Facebook and Instagram.\n\nRules:\n- Write natively for each platform; never paste the same text everywhere.\n- LinkedIn: strong 1-2 line hook, short paragraphs, practical insight, clear CTA or question at the end. 150-250 words. 3-5 hashtags.\n- X: one standalone post of max 280 characters AND a 4-7 tweet thread, each tweet max 280 characters, first tweet is the hook. Max 2 hashtags.\n- Facebook: conversational, 60-120 words, ends with an engagement question. 2-3 hashtags.\n- Instagram: caption with a hook in the first line, line breaks, emojis used sparingly, CTA. 8-15 relevant hashtags. Also suggest one image/visual idea.\n- Only use facts from the provided context. Do not invent statistics, names, quotes or links.\n- Hashtags must include the # symbol and contain no spaces.\n- Return ONLY the structured output requested."}]}, "promptType": "define", "hasOutputParser": true}, "typeVersion": 1.5}, {"id": "d66453a8-b168-4dce-8108-a705b292ceab", "name": "Structured Output Parser (OpenAI)", "type": "@n8n/n8n-nodes-langchain.outputParserStructured", "position": [1232, 1184], "parameters": {"schemaType": "manual", "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"linkedin\": {\"type\": \"object\", \"properties\": {\"post\": {\"type\": \"string\"}, \"hashtags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}, \"required\": [\"post\", \"hashtags\"]},\n    \"twitter\": {\"type\": \"object\", \"properties\": {\"single_post\": {\"type\": \"string\"}, \"thread\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"hashtags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}, \"required\": [\"single_post\", \"thread\", \"hashtags\"]},\n    \"facebook\": {\"type\": \"object\", \"properties\": {\"post\": {\"type\": \"string\"}, \"hashtags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}, \"required\": [\"post\", \"hashtags\"]},\n    \"instagram\": {\"type\": \"object\", \"properties\": {\"caption\": {\"type\": \"string\"}, \"hashtags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"image_idea\": {\"type\": \"string\"}}, \"required\": [\"caption\", \"hashtags\", \"image_idea\"]}\n  },\n  \"required\": [\"linkedin\", \"twitter\", \"facebook\", \"instagram\"]\n}"}, "typeVersion": 1.2}, {"id": "b9b8b102-b6e9-4442-be85-5e0dcf72ca3f", "name": "OpenAI Chat Model", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [1088, 1184], "parameters": {"model": {"__rl": true, "mode": "list", "value": "gpt-4.1-mini", "cachedResultName": "gpt-4.1-mini"}, "options": {"maxTokens": 4096, "temperature": 0.7}}, "credentials": {"openAiApi": {"id": "d83021c6ea6c47ee", "name": "Dummy openAiApi"}}, "typeVersion": 1.2}, {"id": "616fb90a-df9a-4100-95db-4284baf4fd98", "name": "Image Requested?", "type": "n8n-nodes-base.if", "position": [1728, 464], "parameters": {"options": {}, "conditions": {"options": {"version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "loose"}, "combinator": "and", "conditions": [{"id": "a09b9d2b-ee75-4b5c-bfc0-21420d974fe1", "operator": {"type": "boolean", "operation": "true", "singleValue": true}, "leftValue": "={{ $('Validate Input').first().json.generate_image }}", "rightValue": ""}]}, "looseTypeValidation": true}, "typeVersion": 2.2}, {"id": "02d5f93c-300d-4475-a681-08d36c5efd51", "name": "Generate Image (OpenAI)", "type": "n8n-nodes-base.httpRequest", "onError": "continueRegularOutput", "maxTries": 2, "position": [2160, 368], "parameters": {"url": "https://api.openai.com/v1/images/generations", "method": "POST", "options": {"timeout": 180000}, "jsonBody": "={{ JSON.stringify({ model: 'gpt-image-1', n: 1, size: $('Validate Input').first().json.image_size, quality: 'medium', output_format: 'jpeg', output_compression: 80, prompt: `Social media image. Style: ${$('Validate Input').first().json.image_style}. Scene: ${$json.output.instagram.image_idea}. Topic: ${$('Validate Input').first().json.topic}. Do not include any text, words, letters or logos in the image.` }) }}", "sendBody": true, "specifyBody": "json", "authentication": "predefinedCredentialType", "nodeCredentialType": "openAiApi"}, "credentials": {"openAiApi": {"id": "d83021c6ea6c47ee", "name": "Dummy openAiApi"}}, "retryOnFail": true, "typeVersion": 4.2}, {"id": "e2946132-dc25-4841-86a8-99a1a597e02e", "name": "Attach Image", "type": "n8n-nodes-base.code", "position": [2384, 464], "parameters": {"jsCode": "// Merge generated text with the image result (OpenAI or Gemini)\nconst text = $('Image Requested?').first().json.output;\nconst cfg = $('Validate Input').first().json;\nconst res = $input.first().json;\nlet b64 = null, mime = 'image/jpeg';\nif (res.data?.[0]?.b64_json) {                       // OpenAI\n  b64 = res.data[0].b64_json;\n} else {                                             // Gemini\n  const part = (res.candidates?.[0]?.content?.parts || []).find(p => p.inlineData || p.inline_data);\n  const d = part?.inlineData || part?.inline_data;\n  if (d?.data) { b64 = d.data; mime = d.mimeType || d.mime_type || 'image/png'; }\n}\nconst image = b64\n  ? { provider: cfg.image_provider, mime_type: mime, size: cfg.image_size, prompt_idea: text?.instagram?.image_idea, data_uri: `data:${mime};base64,${b64}` }\n  : { provider: cfg.image_provider, error: [res.error?.message, res.error?.description].filter(Boolean).join(' | ') || res.error || res.candidates?.[0]?.finishReason || 'Image generation failed' };\nreturn [{ json: { output: text, image } }];"}, "typeVersion": 2}, {"id": "9d64df5b-da96-4327-9bfb-0aade5bda661", "name": "Image", "type": "n8n-nodes-base.stickyNote", "position": [1632, -16], "parameters": {"color": 7, "width": 896, "height": 824, "content": "## 3. Generate image (optional)\nUses the Instagram `image_idea` + `image_style`. `image_provider`: **openai** (gpt-image-1) or **gemini** (gemini-2.5-flash-image). Defaults to the text provider (Claude \u2192 Gemini). Returned as a base64 `data_uri`. Skipped when `generate_image` is `false`; on failure text is still returned with `image.error`."}, "typeVersion": 1}, {"id": "46d0886b-d805-4694-a7e5-44b4d225149e", "name": "Manual Test Run", "type": "n8n-nodes-base.manualTrigger", "position": [-208, 880], "parameters": {}, "typeVersion": 1}, {"id": "a86af20e-fd07-486a-b66e-a1aa4f8ce84b", "name": "Test Input", "type": "n8n-nodes-base.set", "position": [336, 880], "parameters": {"mode": "raw", "options": {}, "jsonOutput": "{\n  \"body\": {\n    \"provider\": \"gemini\",\n    \"topic\": \"Why RevOps teams should own the CRM\",\n    \"context\": \"Many companies let Sales, Marketing and CS each configure the CRM separately, which leads to duplicate fields, broken reports and poor data quality. A RevOps team owning the CRM creates one source of truth, consistent definitions (e.g. what counts as an SQL), cleaner forecasting and faster onboarding of new tools.\",\n    \"tone\": \"practical and confident\",\n    \"audience\": \"B2B SaaS founders and revenue leaders\",\n    \"brand\": \"Naviquis\",\n    \"cta\": \"Book a free CRM health check\",\n    \"language\": \"English\",\n    \"generate_image\": true,\n    \"image_size\": \"1024x1024\",\n    \"image_style\": \"clean modern flat illustration, blue and white palette\"\n  }\n}"}, "typeVersion": 3.4}, {"id": "6c748b12-8941-4dc6-9500-12837155db8c", "name": "Test Note", "type": "n8n-nodes-base.stickyNote", "position": [-256, 752], "parameters": {"color": 7, "width": 1104, "height": 328, "content": "## \ud83e\uddea Manual test\nEdit **Test Input** (same fields as the webhook body, wrapped in `body`), then pick **Manual Test Run** in *Execute workflow*. Results appear on the **Respond Success** / **Respond LLM Error** / **Respond Bad Request** node output."}, "typeVersion": 1}, {"id": "68cd4217-a9e7-4705-911f-b62b03372170", "name": "Route Image Provider", "type": "n8n-nodes-base.switch", "position": [1936, 464], "parameters": {"rules": {"values": [{"outputKey": "OpenAI", "conditions": {"options": {"version": 2, "leftValue": "", "caseSensitive": false, "typeValidation": "strict"}, "combinator": "and", "conditions": [{"id": "72c80a1c-bf4c-483e-88e5-15555aa2ff24", "operator": {"type": "string", "operation": "equals"}, "leftValue": "={{ $('Validate Input').first().json.image_provider }}", "rightValue": "openai"}]}, "renameOutput": true}, {"outputKey": "Gemini", "conditions": {"options": {"version": 2, "leftValue": "", "caseSensitive": false, "typeValidation": "strict"}, "combinator": "and", "conditions": [{"id": "c51f8855-67d0-478a-8300-85b6d3527bec", "operator": {"type": "string", "operation": "equals"}, "leftValue": "={{ $('Validate Input').first().json.image_provider }}", "rightValue": "gemini"}]}, "renameOutput": true}]}, "options": {}}, "typeVersion": 3.2}, {"id": "d200ae36-d6d7-4c01-af82-cc43db88a71c", "name": "Generate Image (Gemini)", "type": "n8n-nodes-base.httpRequest", "onError": "continueRegularOutput", "maxTries": 2, "position": [2160, 560], "parameters": {"url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-image:generateContent", "method": "POST", "options": {"timeout": 180000}, "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: `Social media image. Style: ${$('Validate Input').first().json.image_style}. Scene: ${$json.output.instagram.image_idea}. Topic: ${$('Validate Input').first().json.topic}. Do not include any text, words, letters or logos in the image.` }] }], generationConfig: { responseModalities: ['IMAGE'], imageConfig: { aspectRatio: ({ '1024x1024': '1:1', '1024x1536': '2:3', '1536x1024': '3:2' })[$('Validate Input').first().json.image_size] } } }) }}", "sendBody": true, "specifyBody": "json", "authentication": "predefinedCredentialType", "nodeCredentialType": "googlePalmApi"}, "credentials": {"googlePalmApi": {"id": "11a68a950433485d", "name": "Dummy googlePalmApi"}}, "retryOnFail": true, "typeVersion": 4.2}, {"id": "8f2f2d4a-0178-4474-a5d5-76149fe6e505", "name": "Settings", "type": "n8n-nodes-base.set", "position": [32, 400], "parameters": {"options": {}, "assignments": {"assignments": [{"id": "abc882a3-e1bf-4330-a624-baa08327cdd2", "name": "image_generation_enabled", "type": "boolean", "value": false}]}, "includeOtherFields": true}, "typeVersion": 3.4}, {"id": "webhook-automata-injected-1791112852005370", "name": "Automata Webhook", "type": "n8n-nodes-base.webhook", "position": [0, 0], "webhookId": "nYC0otQvaIDx36qW", "parameters": {"path": "nYC0otQvaIDx36qW", "options": {}, "httpMethod": "POST", "responseCode": 200, "responseMode": "onReceived"}, "typeVersion": 1.1}]
gPryDVHaa6eAuLNo|[{"id": "6c1fac23-740d-43dd-aef8-792bc9d671b1", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [-3520, 3392], "parameters": {"width": 480, "height": 896, "content": "## Create Jira tickets from Gmail and Outlook support emails with OpenAI and Slack\n\n### How it works\n\nThis workflow monitors both Gmail and Outlook support inboxes, normalizes incoming messages into a shared format, and uses a reusable sub-workflow to classify each email with OpenAI. Based on the classification, it escalates urgent requests into Jira tickets or comments, routes uncertain emails to a Slack review queue, optionally acknowledges customers, and writes audit records to Google Sheets. It also includes Slack failure alerts for workflow errors.\n\n### Setup steps\n\n- Connect Gmail and Microsoft Outlook credentials for the email triggers and reply nodes.\n- Configure OpenAI credentials for the classification chain and confirm the structured output parser matches the expected classification fields.\n- Connect Jira credentials or API details, including the project, issue type, routing rules, and any custom fields used by the Jira payload builder.\n- Connect Slack credentials and set the target escalation, review, and error-alert channels.\n- Connect Google Sheets credentials and select the spreadsheet/sheet used for the triage audit log.\n- Review the Workflow Configuration node values such as internalDomains, ignoreSenderPatterns, minConfidence, and maxBodyChars.\n- If Microsoft Teams notifications are needed, configure the Teams webhook URL used by the escalation notification branch.\n\n### Customization\n\nAdjust the classification prompt, confidence threshold, sender ignore patterns, Jira routing logic, Slack channel mappings, acknowledgement behavior, and audit-log columns to match the support process."}, "typeVersion": 1}, {"id": "7daf8b14-5e9e-4a5f-9de0-0e67ecb9fbca", "name": "Sticky Note1", "type": "n8n-nodes-base.stickyNote", "position": [-2944, 3440], "parameters": {"color": 7, "width": 416, "height": 320, "content": "## Gmail email intake\n\nReceives new Gmail support messages and normalizes them into the common email shape used by the rest of the workflow."}, "typeVersion": 1}, {"id": "528dc7f6-7d92-4465-a239-6257b66ee9c5", "name": "Sticky Note2", "type": "n8n-nodes-base.stickyNote", "position": [-2944, 3792], "parameters": {"color": 7, "width": 416, "height": 320, "content": "## Outlook email intake\n\nReceives new Outlook support messages and normalizes Microsoft Graph email data into the shared email structure."}, "typeVersion": 1}, {"id": "0d111de6-0f09-4bd3-9969-78d9cebc3567", "name": "Sticky Note3", "type": "n8n-nodes-base.stickyNote", "position": [-2448, 3552], "parameters": {"color": 7, "width": 912, "height": 336, "content": "## Configure classification route\n\nAdds workflow configuration, starts the classification step, and routes the main pipeline based on the returned outcome."}, "typeVersion": 1}, {"id": "ae4e0f6f-8385-4434-95bd-89dad9c7647c", "name": "Sticky Note4", "type": "n8n-nodes-base.stickyNote", "position": [-1504, 3392], "parameters": {"color": 7, "width": 848, "height": 304, "content": "## Escalate and acknowledge\n\nInvokes the escalation sub-workflow for high-priority emails, then calls the acknowledgement step to reply to the customer when appropriate."}, "typeVersion": 1}, {"id": "21448b8c-c6dc-44d8-86a8-c5d301464ffc", "name": "Sticky Note5", "type": "n8n-nodes-base.stickyNote", "position": [-1504, 3728], "parameters": {"color": 7, "width": 416, "height": 304, "content": "## Send for review\n\nRoutes uncertain classification results into the review sub-workflow for human triage."}, "typeVersion": 1}, {"id": "c6a8e822-92c0-47ce-ab9a-cf6617774767", "name": "Sticky Note6", "type": "n8n-nodes-base.stickyNote", "position": [-848, 3728], "parameters": {"color": 7, "width": 416, "height": 304, "content": "## Call audit logging\n\nTriggers the audit-log sub-workflow after the main outcome has been processed."}, "typeVersion": 1}, {"id": "0203ee98-a739-4841-b0d0-d2c99042aea4", "name": "Sticky Note7", "type": "n8n-nodes-base.stickyNote", "position": [-2960, 4848], "parameters": {"color": 7, "width": 416, "height": 432, "content": "## Sub-workflow dispatcher\n\nEntry point for reusable sub-workflow calls; dispatches execution to classification, escalation, acknowledgement, review, or logging logic based on the step value."}, "typeVersion": 1}, {"id": "0a223da8-0ca7-4043-91a3-73df4fa506c9", "name": "Sticky Note8", "type": "n8n-nodes-base.stickyNote", "position": [-2416, 4128], "parameters": {"color": 7, "width": 416, "height": 320, "content": "## Classification pre-filter\n\nFilters out internal or automated senders before incurring AI usage and decides whether the message should be sent to the model."}, "typeVersion": 1}, {"id": "c1c3282d-2bdc-4516-b5c7-5c52201910f8", "name": "Sticky Note9", "type": "n8n-nodes-base.stickyNote", "position": [-1968, 4064], "parameters": {"color": 7, "width": 656, "height": 544, "content": "## AI email classification\n\nUses an OpenAI chat model with structured parsing to classify eligible emails, then merges the AI result back with the original email data."}, "typeVersion": 1}, {"id": "64f6ec4d-192d-42e9-95a6-8e2788bdc89a", "name": "Sticky Note10", "type": "n8n-nodes-base.stickyNote", "position": [-1280, 4192], "parameters": {"color": 7, "height": 352, "content": "## Skipped classification result\n\nProduces a logged result for messages that are intentionally not sent to AI."}, "typeVersion": 1}, {"id": "e8dcc9c7-2c80-41a7-98da-ff1313f1c7c6", "name": "Sticky Note11", "type": "n8n-nodes-base.stickyNote", "position": [-2416, 4880], "parameters": {"color": 7, "width": 640, "height": 320, "content": "## Resolve Jira routing\n\nBuilds the Jira routing decision, searches for an existing open ticket for the email thread, and branches between follow-up and new issue handling."}, "typeVersion": 1}, {"id": "158ab89b-5f38-4291-a8d2-cc05c9426b3d", "name": "Sticky Note12", "type": "n8n-nodes-base.stickyNote", "position": [-1744, 4768], "parameters": {"color": 7, "width": 416, "height": 320, "content": "## Update existing ticket\n\nAdds the incoming email as a follow-up comment on an existing Jira ticket and formats the result like a newly handled issue."}, "typeVersion": 1}, {"id": "f21ec1e1-e472-4705-b776-dbde45961fd5", "name": "Sticky Note13", "type": "n8n-nodes-base.stickyNote", "position": [-1744, 5152], "parameters": {"color": 7, "height": 320, "content": "## Create Jira issue\n\nCreates a new Jira issue when no open ticket exists for the email thread."}, "typeVersion": 1}, {"id": "f1e31ca7-6a0e-41e9-b8da-d1e27af4616a", "name": "Sticky Note14", "type": "n8n-nodes-base.stickyNote", "position": [-1296, 4896], "parameters": {"color": 7, "width": 640, "height": 304, "content": "## Build team notifications\n\nBuilds escalation messages, posts the main notification to Slack, and checks whether a Teams webhook is configured."}, "typeVersion": 1}, {"id": "b584a6f1-9551-4653-9342-4e5674404f22", "name": "Sticky Note15", "type": "n8n-nodes-base.stickyNote", "position": [-608, 4800], "parameters": {"color": 7, "width": 416, "height": 400, "content": "## Return escalation status\n\nOptionally posts a Microsoft Teams card and returns the final escalation result to the main pipeline."}, "typeVersion": 1}, {"id": "ae390ef0-d9a5-41d3-bf71-2481fbd75cdf", "name": "Sticky Note16", "type": "n8n-nodes-base.stickyNote", "position": [-2416, 5632], "parameters": {"color": 7, "width": 416, "height": 384, "content": "## Choose acknowledgement path\n\nPrepares the customer acknowledgement text and selects the appropriate email reply channel or no-reply outcome."}, "typeVersion": 1}, {"id": "4210f5f1-6845-492c-a7a9-b0b1ff023478", "name": "Sticky Note17", "type": "n8n-nodes-base.stickyNote", "position": [-1936, 5520], "parameters": {"color": 7, "width": 448, "height": 640, "content": "## Send customer replies\n\nSends or drafts Gmail acknowledgements, sends Outlook replies, and returns acknowledgement status to the caller."}, "typeVersion": 1}, {"id": "b3e8931d-442f-43ea-b040-038b39971c47", "name": "Sticky Note18", "type": "n8n-nodes-base.stickyNote", "position": [-2416, 6224], "parameters": {"color": 7, "width": 640, "height": 304, "content": "## Post review alert\n\nBuilds a human-review Slack alert for low-confidence emails and returns the review routing result."}, "typeVersion": 1}, {"id": "8a966c81-1198-41c3-a527-8497d5adcc39", "name": "Sticky Note19", "type": "n8n-nodes-base.stickyNote", "position": [-1664, 6192], "parameters": {"color": 7, "width": 416, "height": 320, "content": "## Append audit row\n\nFlattens the processed email outcome into an audit-log row and appends it to Google Sheets."}, "typeVersion": 1}, {"id": "9e0a1572-02f4-4c0a-bcac-0091150bde35", "name": "Sticky Note20", "type": "n8n-nodes-base.stickyNote", "position": [-2416, 6576], "parameters": {"color": 7, "width": 640, "height": 304, "content": "## Notify workflow failures\n\nHandles workflow-level errors by formatting a readable alert and posting it to Slack."}, "typeVersion": 1}, {"id": "60e1db40-59f7-46ca-8523-1ee8f07ac833", "name": "When Email Received in Gmail", "type": "n8n-nodes-base.gmailTrigger", "position": [-2896, 3600], "parameters": {"simple": false, "filters": {"q": "-from:me -category:promotions -category:social -category:updates -category:forums", "labelIds": ["INBOX"]}, "options": {}, "pollTimes": {"item": [{"mode": "everyMinute"}]}}, "typeVersion": 1.3}, {"id": "69f277ae-89d6-4ed2-8be8-ba6114e42fb9", "name": "When Email Received in Outlook", "type": "n8n-nodes-base.microsoftOutlookTrigger", "position": [-2896, 3952], "parameters": {"output": "raw", "filters": {}, "options": {}, "pollTimes": {"item": [{"mode": "everyMinute"}]}}, "typeVersion": 1}, {"id": "21d959db-6a22-4f3c-a09c-a2fa824319bc", "name": "Normalize Gmail Email", "type": "n8n-nodes-base.code", "position": [-2672, 3600], "parameters": {"jsCode": "// Normalise Gmail messages to the common email shape.\nreturn $input.all().map(({ json: m }) => {\n  const from = m.from?.value?.[0] || {};\n  const text = m.text || String(m.html || '').replace(/<style[\\s\\S]*?<\\/style>/gi, '').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ');\n  return { json: {\n    source: 'Gmail',\n    messageId: m.id || m.messageId || '',\n    threadId: m.threadId || '',\n    receivedAt: m.date ? new Date(m.date).toISOString() : new Date().toISOString(),\n    fromName: from.name || '',\n    fromEmail: (from.address || '').toLowerCase(),\n    to: m.to?.text || '',\n    subject: m.subject || '(no subject)',\n    body: text,\n    link: m.threadId ? `https://mail.google.com/mail/u/0/#all/${m.threadId}` : '',\n    hasAttachments: Object.keys(m).some(k => k.startsWith('attachment')) || (m.attachments?.length > 0),\n  } };\n});"}, "typeVersion": 2}, {"id": "092d27b0-97b4-42f7-a515-c32406265efd", "name": "Normalize Outlook Email", "type": "n8n-nodes-base.code", "position": [-2672, 3952], "parameters": {"jsCode": "// Normalise Outlook (Microsoft Graph raw) messages to the common email shape.\nreturn $input.all().map(({ json: m }) => {\n  const from = m.from?.emailAddress || m.sender?.emailAddress || {};\n  const html = m.body?.content || '';\n  const text = m.body?.contentType === 'text' ? html :\n    String(html).replace(/<style[\\s\\S]*?<\\/style>/gi, '').replace(/<br\\s*\\/?>/gi, '\\n').replace(/<\\/p>/gi, '\\n')\n      .replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/[ \\t]+/g, ' ');\n  return { json: {\n    source: 'Outlook',\n    messageId: m.id || '',\n    threadId: m.conversationId || '',\n    receivedAt: m.receivedDateTime || new Date().toISOString(),\n    fromName: from.name || '',\n    fromEmail: (from.address || '').toLowerCase(),\n    to: (m.toRecipients || []).map(r => r.emailAddress?.address).join(', '),\n    subject: m.subject || '(no subject)',\n    body: text || m.bodyPreview || '',\n    link: m.webLink || '',\n    hasAttachments: !!m.hasAttachments,\n  } };\n});"}, "typeVersion": 2}, {"id": "54c4a3e0-2500-4bf7-b6f6-34aff4ceb41d", "name": "Set Workflow Configuration", "type": "n8n-nodes-base.set", "position": [-2384, 3696], "parameters": {"options": {}, "assignments": {"assignments": [{"id": "d11c34c1-86a3-4c60-9049-47de35f0991b", "name": "internalDomains", "type": "string", "value": "example.com"}, {"id": "e5e3371e-9f2e-426f-9fbf-d16a07d3a3f3", "name": "ignoreSenderPatterns", "type": "string", "value": "noreply,no-reply,donotreply,mailer-daemon,notifications@,newsletter"}, {"id": "ae3c49d9-0943-402e-9aac-4b80b58c0edb", "name": "minConfidence", "type": "number", "value": 0.6}, {"id": "94803ca7-4715-455a-a55c-f17fdafa51fe", "name": "maxBodyChars", "type": "number", "value": 6000}, {"id": "835aab3d-c002-4fb5-a1ba-1656c3c013a2", "name": "jiraBaseUrl", "type": "string", "value": "https://your-domain.atlassian.net"}, {"id": "dce96970-cdb8-4e7d-bd7d-6057f40d8f4d", "name": "jiraProjectKey", "type": "string", "value": "SUP"}, {"id": "0e122879-026e-4b00-b6d8-3ce8424d8718", "name": "bugIssueType", "type": "string", "value": "Bug"}, {"id": "12bab9ee-459b-41e3-943c-a547a8470c05", "name": "issueIssueType", "type": "string", "value": "Task"}, {"id": "39d2291b-a6fe-4934-9c52-d2e30355fb69", "name": "requirementIssueType", "type": "string", "value": "Story"}, {"id": "be338ace-125f-4128-a0e8-ef6f3041e108", "name": "bugAssigneeAccountId", "type": "string", "value": ""}, {"id": "4f1be264-5d01-44de-94c8-5029d0ef7f51", "name": "issueAssigneeAccountId", "type": "string", "value": ""}, {"id": "2f80a56e-3635-49cc-bbf7-86d524b004be", "name": "requirementAssigneeAccountId", "type": "string", "value": ""}, {"id": "29ee38e6-5dad-4ba0-8d27-e54e890d2326", "name": "setJiraPriority", "type": "boolean", "value": true}, {"id": "5217e80c-0993-4801-9d96-0a88bb44639b", "name": "dedupByThread", "type": "boolean", "value": true}, {"id": "07620414-d936-49a2-b3ae-0ed0c378a1c9", "name": "bugSlackChannel", "type": "string", "value": "support-bugs"}, {"id": "bd1ba8c7-3a71-42c0-a63b-853bef35da3b", "name": "issueSlackChannel", "type": "string", "value": "support-issues"}, {"id": "dea6131b-8a56-4b3c-9187-93c484934810", "name": "requirementSlackChannel", "type": "string", "value": "product-requests"}, {"id": "d0ac31e9-abb7-4181-a60e-8c06b99bb309", "name": "reviewSlackChannel", "type": "string", "value": "triage-review"}, {"id": "a5baccf3-e98d-4f36-8640-3058de33e85b", "name": "teamsWebhookUrl", "type": "string", "value": ""}, {"id": "b2d516c6-4ce0-40a8-9919-9916b1d3d5eb", "name": "ackMode", "type": "string", "value": "off"}, {"id": "eb4ed085-5577-48ee-a9b8-0d059d7540ce", "name": "companyName", "type": "string", "value": "Your Company"}, {"id": "18b2a88d-24ca-43f1-8eb9-b1933913d97e", "name": "ackSignature", "type": "string", "value": "Customer Success Team"}]}, "includeOtherFields": true}, "typeVersion": 3.4}, {"id": "f4388c67-7c2c-4192-8c9f-cf6ed977d7d4", "name": "Prepare Step for Classification", "type": "n8n-nodes-base.set", "position": [-2112, 3696], "parameters": {"options": {}, "assignments": {"assignments": [{"id": "94affcd1-c387-4de5-ad89-1b936752810b", "name": "step", "type": "string", "value": "classify"}]}, "includeOtherFields": true}, "typeVersion": 3.4}, {"id": "ecf8d929-9172-4367-ab68-98b971184384", "name": "Execute Email Classification", "type": "n8n-nodes-base.executeWorkflow", "position": [-1888, 3696], "parameters": {"mode": "each", "options": {"waitForSubWorkflow": true}, "workflowId": {"__rl": true, "mode": "id", "value": "={{ $workflow.id }}"}, "workflowInputs": {"value": {}, "schema": [], "mappingMode": "defineBelow", "matchingColumns": [], "attemptToConvertTypes": false, "convertFieldsToString": true}}, "typeVersion": 1.2}, {"id": "4334dbf3-aa44-4624-91b0-57993ffeeeeb", "name": "Route by Classification Outcome", "type": "n8n-nodes-base.switch", "position": [-1664, 3696], "parameters": {"rules": {"values": [{"outputKey": "Escalate", "conditio