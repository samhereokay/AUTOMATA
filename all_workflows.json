.minConfidence || 0) * 100)}%)`;\nconst text = [\n  `:mag: *Email needs manual triage* - ${reason}`,\n  `*AI guess:* ${e.category} / ${e.priority}${e.productArea ? ' / ' + e.productArea : ''}`,\n  `*From:* ${e.fromName || ''} <${e.fromEmail}>  |  *Subject:* ${e.subject}`,\n  e.summary ? `>${String(e.summary).replace(/\\n/g, '\\n>')}` : '',\n  e.reasoning ? `_Why:_ ${e.reasoning}` : '',\n  e.link ? `<${e.link}|Open email>` : `_Source: ${e.source}_`,\n].filter(Boolean).join('\\n');\nreturn { json: { ...e, reviewReason: reason, reviewText: text,\n  reviewChannel: String(e.reviewSlackChannel || 'triage-review').replace('#', '') } };"}, "typeVersion": 2}, {"id": "941a4633-e8e0-4494-9550-994e40cc205d", "name": "Send Review Request to Slack", "type": "n8n-nodes-base.slack", "onError": "continueRegularOutput", "position": [-2144, 6352], "webhookId": "448f9ff1-5891-451c-973d-41f9390154dc", "parameters": {"text": "={{ $json.reviewText }}", "select": "channel", "channelId": {"__rl": true, "mode": "name", "value": "={{ $json.reviewChannel }}"}, "otherOptions": {"unfurl_links": false, "includeLinkToWorkflow": false}}, "typeVersion": 2.3}, {"id": "8d5bde18-c88d-4317-bd61-260f223bdf32", "name": "Return Review Outcome", "type": "n8n-nodes-base.code", "position": [-1936, 6352], "parameters": {"mode": "runOnceForEachItem", "jsCode": "// Return the email data plus review status.\nconst e = $('Alert for Email Review').item.json;\nconst { reviewText, ...rest } = e;\nreturn { json: { ...rest, reviewAlertSent: !$json.error, escalationStatus: 'Sent to review (' + e.reviewReason + ')' } };"}, "typeVersion": 2}, {"id": "983fb096-e8c3-4c2e-84d6-6876e932c6d3", "name": "Generate Audit Log Entry", "type": "n8n-nodes-base.code", "position": [-1616, 6352], "parameters": {"mode": "runOnceForEachItem", "jsCode": "// Flatten the result into one audit-log row.\nconst e = $json;\nreturn { json: {\n  'Logged At': new Date().toISOString(),\n  'Received At': e.receivedAt || '',\n  'Source': e.source || ''