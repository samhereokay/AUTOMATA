tep for Acknowledgement", "type": "n8n-nodes-base.set", "position": [-1008, 3536], "parameters": {"options": {}, "assignments": {"assignments": [{"id": "44c8abd5-e28e-4f94-bb07-97e6e571ea46", "name": "step", "type": "string", "value": "acknowledge"}]}, "includeOtherFields": true}, "typeVersion": 3.4}, {"id": "92cfd208-0456-4538-bd8f-ae8dfbae78e7", "name": "Execute Customer Acknowledgement", "type": "n8n-nodes-base.executeWorkflow", "position": [-784, 3536], "parameters": {"mode": "each", "options": {"waitForSubWorkflow": true}, "workflowId": {"__rl": true, "mode": "id", "value": "={{ $workflow.id }}"}, "workflowInputs": {"value": {}, "schema": [], "mappingMode": "defineBelow", "matchingColumns": [], "attemptToConvertTypes": false, "convertFieldsToString": true}}, "typeVersion": 1.2}, {"id": "e7e5266d-db60-4597-8aae-0d4c39d7b5ed", "name": "Prepare Step for Review", "type": "n8n-nodes-base.set", "position": [-1456, 3856], "parameters": {"options": {}, "assignments": {"assignments": [{"id": "f6ded644-f041-4463-8a5b-d9ecefe1d8fb", "name": "step", "type": "string", "value": "review"}]}, "includeOtherFields": true}, "typeVersion": 3.4}, {"id": "72fed49a-859c-4768-9318-1d8e3f49f6e9", "name": "Execute Review Queue Workflow", "type": "n8n-nodes-base.executeWorkflow", "position": [-1232, 3856], "parameters": {"mode": "each", "options": {"waitForSubWorkflow": true}, "workflowId": {"__rl": true, "mode": "id", "value": "={{ $workflow.id }}"}, "workflowInputs": {"value": {}, "schema": [], "mappingMode": "defineBelow", "matchingColumns": [], "attemptToConvertTypes": false, "convertFieldsToString": true}}, "typeVersion": 1.2}, {"id": "13b76e42-3fa0-4d78-9da7-ce2c981b5ac2", "name": "Prepare Step for Logging", "type": "n8n-nodes-base.set", "position": [-800, 3872], "parameters": {"options": {}, "assignments": {"assignments": [{"id": "1e7ebf32-77e6-4c14-9d8b-b7cf1c9fc900", "name": "step", "type": "string", "value": "log"}]}, "includeOtherFields": true}, "typeVersion": 3.4}, {"id": "944289cb-85ff-49f6-bd8f-5d786db6d40a", "name": "Execute Audit Log Workflow", "type": "n8n-nodes-base.executeWorkflow", "position": [-576, 3872], "parameters": {"mode": "each", "options": {"waitForSubWorkflow": true}, "workflowId": {"__rl": true, "mode": "id", "value": "={{ $workflow.id }}"}, "workflowInputs": {"value": {}, "schema": [], "mappingMode": "defineBelow", "matchingColumns": [], "attemptToConvertTypes": false, "convertFieldsToString": true}}, "typeVersion": 1.2}, {"id": "a9c50f66-08f9-49b3-8aad-3301a4c662f1", "name": "Route by Workflow Step", "type": "n8n-nodes-base.switch", "position": [-2688, 5040], "parameters": {"rules": {"values": [{"outputKey": "classify", "conditions": {"options": {"version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "strict"}, "combinator": "and", "conditions": [{"id": "47dbd1e5-0d92-4486-bbc9-9747d92c8e60", "operator": {"type": "string", "operation": "equals"}, "leftValue": "={{ $json.step }}", "rightValue": "classify"}]}, "renameOutput": true}, {"outputKey": "escalate", "conditions": {"options": {"version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "strict"}, "combinator": "and", "conditions": [{"id": "39f7df9c-3e51-4b91-91ce-a595bf0a53fe", "operator": {"type": "string", "operation": "equals"}, "leftValue": "={{ $json.step }}", "rightValue": "escalate"}]}, "renameOutput": true}, {"outputKey": "acknowledge", "conditions": {"options": {"version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "strict"}, "combinator": "and", "conditions": [{"id": "5fa3b6f1-5751-453d-b7ad-fa08427256f6", "operator": {"type": "string", "operation": "equals"}, "leftValue": "={{ $json.step }}", "rightValue": "acknowledge"}]}, "renameOutput": true}, {"outputKey": "review", "conditions": {"options": {"version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "strict"}, "combinator": "and", "conditions": [{"id": "a1122db7-2481-41f5-9bb2-fd4e078eb6f1", "operator": {"type": "string", "operation": "equals"}, "leftValue": "={{ $json.step }}", "rightValue": "review"}]}, "renameOutput": true}, {"outputKey": "log", "conditions": {"options": {"version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "strict"}, "combinator": "and", "conditions": [{"id": "10dd5d24-b9e3-4c1a-8289-70e8a6d16ba9", "operator": {"type": "string", "operation": "equals"}, "leftValue": "={{ $json.step }}", "rightValue": "log"}]}, "renameOutput": true}]}, "options": {}}, "typeVersion": 3.2}, {"id": "65d60bf0-05d2-4905-b014-e98e78ed32e6", "name": "Filter and Prepare for AI", "type": "n8n-nodes-base.code", "position": [-2368, 4304], "parameters": {"mode": "runOnceForEachItem", "jsCode": "// Pre-filter: drop internal / automated senders before spending AI tokens,\n// strip quoted reply history and trim the body.\nconst e = $json;\nconst fromEmail = String(e.fromEmail || '').toLowerCase().trim();\nconst domain = fromEmail.split('@')[1] || '';\nconst list = v => String(v || '').split(',').map(s => s.trim().toLowerCase()).filter(Boolean);\nconst internalDomains = list(e.internalDomains);\nconst ignorePatterns = list(e.ignoreSenderPatterns);\n\nlet skipReason = '';\nif (!fromEmail) skipReason = 'No sender address';\nelse if (internalDomains.includes(domain)) skipReason = 'Internal sender (' + domain + ')';\nelse if (ignorePatterns.some(p => fromEmail.includes(p))) skipReason = 'Automated / no-reply sender';\n\n// Remove quoted history (\"On ... wrote:\", \"From: ... Sent:\", lines starting with \">\")\nlet body = String(e.body || '');\nconst cut = body.search(/\\n(On .{0,200}wrote:|-{2,}\\s*Original Message|From:\\s.+\\n(Sent|Date):)/i);\nif (cut > 0) body = body.slice(0, cut);\nbody = body.split('\\n').filter(l => !l.trim().startsWith('>')).join('\\n')\n  .replace(/\\n{3,}/g, '\\n\\n').trim();\nconst max = Number(e.maxBodyChars) || 6000;\nif (body.length > max) body = body.slice(0, max) + '\\n...[truncated]';\n\nreturn { json: { ...e, fromEmail, body, skipAI: !!skipReason, skipReason } };"}, "typeVersion": 2}, {"id": "914f6e66-5232-48f5-b6b1-1a2cacfcc733", "name": "Check AI Classification Needed", "type": "n8n-nodes-base.if", "position": [-2144, 4304], "parameters": {"options": {}, "conditions": {"options": {"version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "loose"}, "combinator": "and", "conditions": [{"id": "cb163c9f-d0c0-4885-a8b6-16498feb1eae", "operator": {"type": "boolean", "operation": "true", "singleValue": true}, "leftValue": "={{ !$json.skipAI }}", "rightValue": ""}]}, "looseTypeValidation": true}, "typeVersion": 2.2}, {"id": "d5a08ab3-e3c3-4e72-bd7a-2441000cd1fa", "name": "AI Email Classifier", "type": "@n8n/n8n-nodes-langchain.chainLlm", "onError": "continueRegularOutput", "maxTries": 3, "position": [-1808, 4192], "parameters": {"text": "=Classify this inbound email.\n\nReceived via: {{ $json.source }}\nFrom: {{ $json.fromName }} <{{ $json.fromEmail }}>\nSubject: {{ $json.subject }}\nHas attachments: {{ $json.hasAttachments }}\n\nBody:\n\"\"\"\n{{ $json.body }}\n\"\"\"", "batching": {}, "messages": {"messageValues": [{"message": "You are a senior customer-support triage analyst for a B2B software company. You read ONE inbound email and decide whether it is a genuine customer request and, if so, what kind.\n\nCategories (pick exactly one):\n- \"New Requirement\": the customer asks for a new feature, enhancement, change request, integration, report, or customisation that does not exist today.\n- \"Issue\": something is not working as the customer expects but it is NOT clearly a software defect - access/login problems, configuration or data questions, how-to confusion, performance complaints, service outages, billing/account problems.\n- \"Bug\": a reproducible software defect - error messages, crashes, wrong calculations, broken UI, features behaving contrary to their documented behaviour.\n- \"Other\": newsletters, marketing, sales pitches, vendor/recruiter outreach, invoices from suppliers, auto-replies, thank-you notes, meeting logistics, spam, or anything not requiring product/support action.\n\nPriority:\n- \"Critical\": production down, data loss/corruption, security incident, many users blocked, or explicit severe business impact/deadline today.\n- \"High\": key workflow blocked for some users, no workaround, or strong urgency/escalation language.\n- \"Medium\": workaround exists or limited impact; most feature requests from active customers.\n- \"Low\": cosmetic, nice-to-have, general questions.\n\nRules:\n- isCustomerRequest is true only for New Requirement, Issue or Bug coming from a customer/client/end-user (not vendors, recruiters, or marketing).\n- If the email mixes several asks, classify by the most severe one (Bug > Issue > New Requirement) and mention the others in summary.\n- title: an actionable ticket title, max 100 characters, no customer name.\n- summary: 2-4 sentences a developer can act on; include versions, modules, IDs, error text if present.\n- stepsToReproduce: only for Bug, otherwise empty string.\n- productArea: the module/feature mentioned (e.g. \"Billing\", \"Login\", \"Reports\", \"API\", \"Mobile App\"), or \"General\".\n- customerCompany: infer from signature or email domain if possible, else empty string.\n- confidence: 0-1, how sure you are about the category.\n- Ignore signatures, legal disclaimers and quoted previous messages.\n- Respond ONLY with the structured output."}]}, "promptType": "define", "hasOutputParser": true}, "retryOnFail": true, "typeVersion": 1.7, "waitBetweenTries": 3000}, {"id": "f00da2fb-7748-425a-a1b1-61b833997885", "name": "OpenAI GPT-4.1 Mini", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [-1808, 4448], "parameters": {"model": {"__rl": true, "mode": "list", "value": "gpt-4.1-mini"}, "options": {"temperature": 0.1}}, "typeVersion": 1.2}, {"id": "887bfe67-8bd7-4ebe-a011-0025ca41d2ba", "name": "Parse Classification Result", "type": "@n8n/n8n-nodes-langchain.outputParserStructured", "position": [-1472, 4448], "parameters": {"schemaType": "manual", "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"isCustomerRequest\": {\n      \"type\": \"boolean\"\n    },\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"New Requirement\",\n        \"Issue\",\n        \"Bug\",\n        \"Other\"\n      ]\n    },\n    \"priority\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Critical\",\n        \"High\",\n        \"Medium\",\n        \"Low\"\n      ]\n    },\n    \"confidence\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1\n    },\n    \"productArea\": {\n      \"type\": \"string\"\n    },\n    \"title\": {\n      \"type\": \"string\"\n    },\n    \"summary\": {\n      \"type\": \"string\"\n    },\n    \"customerName\": {\n      \"type\": \"string\"\n    },\n    \"customerCompany\": {\n      \"type\": \"string\"\n    },\n    \"sentiment\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Positive\",\n        \"Neutral\",\n        \"Negative\",\n        \"Angry\"\n      ]\n    },\n    \"stepsToReproduce\": {\n      \"type\": \"string\"\n    },\n    \"reasoning\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"isCustomerRequest\",\n    \"category\",\n    \"priority\",\n    \"confidence\",\n    \"productArea\",\n    \"title\",\n    \"summary\",\n    \"customerName\",\n    \"customerCompany\",\n    \"sentiment\",\n    \"stepsToReproduce\",\n    \"reasoning\"\n  ]\n}"}, "typeVersion": 1.3}, {"id": "e6fb23d1-6a78-40ec-affa-5374fdf21cf6", "name": "Combine Email and Classification", "type": "n8n-nodes-base.code", "position": [-1456, 4192], "parameters": {"mode": "runOnceForEachItem", "jsCode": "// Combine the original email with the AI classification.\nconst src = $('Filter and Prepare for AI').item.json;\nconst ai = $json.output || {};\nconst ok = !!ai.category;\nreturn { json: {\n  ...src,\n  isCustomerRequest: ok ? !!ai.isCustomerRequest : false,\n  category: ok ? ai.category : 'Unclassified',\n  priority: ai.priority || 'Medium',\n  confidence: typeof ai.confidence === 'number' ? ai.confidence : 0,\n  productArea: ai.productArea || '',\n  title: ai.title || src.subject || '(no subject)',\n  summary: ai.summary || '',\n  customerName: ai.customerName || src.fromName || '',\n  customerCompany: ai.customerCompany || '',\n  sentiment: ai.sentiment || 'Neutral',\n  stepsToReproduce: ai.stepsToReproduce || '',\n  reasoning: ai.reasoning || (ok ? '' : 'AI classification failed: ' + ($json.error?.message || $json.error || 'no output')),\n  needsReview: !ok,\n  classifiedBy: 'AI',\n  classifiedAt: new Date().toISOString(),\n} };"}, "typeVersion": 2}, {"id": "46753dcc-7e5e-4116-bc58-b14894551514", "name": "Record Skipped AI Classification", "type": "n8n-nodes-base.code", "position": [-1232, 4400], "parameters": {"mode": "runOnceForEachItem", "jsCode": "// Not sent to AI - keep a record so it can still be logged.\nconst e = $json;\nreturn { json: {\n  ...e,\n  isCustomerRequest: false,\n  category: 'Other',\n  priority: 'Low',\n  confidence: 1,\n  productArea: '',\n  title: e.subject || '(no subject)',\n  summary: 'Skipped: ' + e.skipReason,\n  customerName: e.fromName || '',\n  customerCompany: '',\n  sentiment: 'Neutral',\n  stepsToReproduce: '',\n  reasoning: e.skipReason,\n  needsReview: false,\n  classifiedBy: 'rules',\n  classifiedAt: new Date().toISOString(),\n} };"}, "typeVersion": 2}, {"id": "36012838-37f5-446c-a7c0-1af2ac6672e8", "name": "Build Jira Routing Decision", "type": "n8n-nodes-base.code", "position": [-2368, 5040], "parameters": {"mode": "runOnceForEachItem", "jsCode": "// Build the routing decision and Jira payload from Workflow Configuration.\nconst e = $json;\nconst ROUTES = {\n  'Bug':             { issueType: e.bugIssueType || 'Bug',           assigneeAccountId: e.bugAssigneeAccountId,         slackChannel: e.bugSlackChannel,         labels: ['customer-email', 'bug'] },\n  'Issue':           { issueType: e.issueIssueType || 'Task',        assigneeAccountId: e.issueAssigneeAccountId,       slackChannel: e.issueSlackChannel,       labels: ['customer-email', 'issue'] },\n  'New Requirement': { issueType: e.requirementIssueType || 'Story', assigneeAccountId: e.requirementAssigneeAccountId, slackChannel: e.requirementSlackChannel, labels: ['customer-email', 'requirement'] },\n};\n// Optional: route specific product areas elsewhere, e.g. { billing: { slackChannel: 'billing' } }\nconst AREA_OVERRIDES = {};\n\nlet route = { ...(ROUTES[e.category] || ROUTES['Issue']) };\nconst area = String(e.productArea || '').toLowerCase();\nfor (const [key, ov] of Object.entries(AREA_OVERRIDES)) {\n  if (area.includes(key)) { route = { ...route, ...ov }; break; }\n}\nroute.slackChannel = String(route.slackChannel || '').replace('#', '');\nroute.owner = `${e.category} owner (#${route.slackChannel})`;\n\n// Stable Jira label per email thread, used to find the open ticket for replies\nconst threadKey = String(e.threadId || e.messageId || e.subject || '');\nlet h = 5381;\nfor (let i = 0; i < threadKey.length; i++) h = ((h << 5) + h + threadKey.charCodeAt(i)) >>> 0;\nconst threadLabel = 'email-thread-' + h.toString(36);\n\nconst description = [\n  `*Source:* customer email via ${e.source}`,\n  `*From:* ${e.fromName || ''} <${e.fromEmail}>${e.customerCompany ? ' - ' + e.customerCompany : ''}`,\n  `*Received:* ${e.receivedAt}`,\n  `*Category / priority:* ${e.category} / ${e.priority} (AI confidence ${Math.round((e.confidence || 0) * 100)}%)`,\n  `*Product area:* ${e.productArea || 'General'}  |  *Sentiment:* ${e.sentiment}`,\n  '', 'h3. Summary', e.summary || '',\n  e.stepsToReproduce ? '\\nh3. Steps to reproduce\\n' + e.stepsToReproduce : '',\n  '', 'h3. Original email', `*Subject:* ${e.subject}`,\n  '{noformat}', String(e.body || '').slice(0, 20000), '{noformat}',\n].join('\\n');\n\nconst PRIORITY_MAP = { Critical: 'Highest', High: 'High', Medium: 'Medium', Low: 'Low' };\nconst fields = {\n  project: { key: e.jiraProjectKey },\n  issuetype: { name: route.issueType },\n  summary: String(e.title || e.subject || 'Customer request').slice(0, 250),\n  description,\n  labels: [...route.labels, threadLabel],\n};\nif (e.setJiraPriority && PRIORITY_MAP[e.priority]) fields.priority = { name: PRIORITY_MAP[e.priority] };\nif (route.assigneeAccountId) fields.assignee = { accountId: route.assigneeAccountId };\n\nreturn { json: {\n  ...e,\n  route,\n  jiraBaseUrl: String(e.jiraBaseUrl || '').replace(/\\/$/, ''),\n  jiraPayload: { fields },\n  threadLabel,\n  dedupEnabled: e.dedupByThread !== false && !!threadKey,\n  dedupJql: `labels = \"${threadLabel}\" AND statusCategory != Done ORDER BY created DESC`,\n  followUpComment: [\n    `Follow-up email from ${e.fromName || ''} <${e.fromEmail}> at ${e.receivedAt}`,\n    `AI read: ${e.category} / ${e.priority} - ${e.summary || ''}`,\n    '{noformat}', String(e.body || '').slice(0, 15000), '{noformat}',\n  ].join('\\n'),\n} };"}, "typeVersion": 2}, {"id": "3c55cf20-8b4d-4191-873a-b9ca9e673d3a", "name": "Search Open Jira Tickets", "type": "n8n-nodes-base.jira", "onError": "continueRegularOutput", "position": [-2144, 5040], "parameters": {"limit": 1, "options": {"jql": "={{ $json.dedupJql }}", "fields": "key,status"}, "operation": "getAll"}, "typeVersion": 1, "alwaysOutputData": true}, {"id": "e359cba8-c573-4b09-b083-cb48bc07babb", "name": "Check If Ticket Exists", "type": "n8n-nodes-base.if", "position": [-1936, 5040], "parameters": {"options": {}, "conditions": {"options": {"version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "loose"}, "combinator": "and", "conditions": [{"id": "a512d684-e176-44ae-b90d-df8701ae57fe", "operator": {"type": "boolean", "operation": "true", "singleValue": true}, "leftValue": "={{ $('Build Jira Routing Decision').item.json.dedupEnabled && !!$json.key }}", "rightValue": ""}]}, "looseTypeValidation": true}, "typeVersion": 2.2}, {"id": "eb8ea324-7926-4fa5-80d3-44ae7f035d50", "name": "Comment on Existing Ticket", "type": "n8n-nodes-base.jira", "onError": "continueRegularOutput", "position": [-1696, 4944], "parameters": {"comment": "={{ $('Build Jira Routing Decision').item.json.followUpComment }}", "options": {}, "issueKey": "={{ $json.key }}", "resource": "issueComment"}, "typeVersion": 1}, {"id": "f6fb2a72-2a5d-48bf-84ad-24023392f205", "name": "Record Ticket Follow-Up", "type": "n8n-nodes-base.code", "position": [-1472, 4944], "parameters": {"mode": "runOnceForEachItem", "jsCode": "// Comment added to the open ticket: expose its key like a newly created issue.\nconst key = $('Search Open Jira Tickets').item.json.key || '';\nreturn { json: { key: $json.error ? '' : key, isFollowUp: true, error: $json.error } };"}, "typeVersion": 2}, {"id": "000c879d-3d31-4416-aeed-cd9729680f0d", "name": "Post New Jira Issue", "type": "n8n-nodes-base.httpRequest", "onError": "continueRegularOutput", "maxTries": 2, "position": [-1696, 5312], "parameters": {"url": "={{ $('Build Jira Routing Decision').item.json.jiraBaseUrl }}/rest/api/2/issue", "method": "POST", "options": {}, "jsonBody": "={{ JSON.stringify($('Build Jira Routing Decision').item.json.jiraPayload) }}", "sendBody": true, "specifyBody": "json", "authentication": "predefinedCredentialType", "nodeCredentialType": "jiraSoftwareCloudApi"}, "retryOnFail": true, "typeVersion": 4.2}, {"id": "6c914524-9763-4866-b545-71c7b0b16a8e", "name": "Create Notification Messages", "type": "n8n-nodes-base.code", "position": [-1248, 5040], "parameters": {"mode": "runOnceForEachItem", "jsCode": "// Build Slack and Teams messages from the Jira result.\nconst e = $('Build Jira Routing Decision').item.json;\nconst res = $json;\nconst jiraKey = res.key || '';\nconst isFollowUp = !!res.isFollowUp;\nconst jiraUrl = jiraKey ? `${e.jiraBaseUrl}/browse/${jiraKey}` : '';\nconst jiraError = jiraKey ? '' : String(res.error?.message || res.error || res.message || 'Jira issue not created');\nconst icon = { 'Bug': ':beetle:', 'Issue': ':warning:', 'New Requirement': ':bulb:' }[e.category] || ':envelope:';\nconst urgent = e.priority === 'Critical' && !isFollowUp ? '<!channel> ' : '';\n\nconst slackText = [\n  isFollowUp ? `:speech_balloon: *Customer follow-up* on ${jiraKey} - ${e.category} / ${e.priority}`\n             : `${urgent}${icon} *New customer ${e.category}* - *${e.priority}* priority`,\n  `*${e.title}*`,\n  `>${String(e.summary || '').replace(/\\n/g, '\\n>')}`,\n  `*Customer:* ${e.customerName || e.fromName} <${e.fromEmail}>${e.customerCompany ? ' (' + e.customerCompany + ')' : ''}`,\n  `*Area:* ${e.productArea || 'General'} | *Sentiment:* ${e.sentiment}`,\n  jiraKey ? `*Jira:* <${jiraUrl}|${jiraKey}>` : `:x: *Jira not created:* ${jiraError.slice(0, 300)}`,\n  e.link ? `<${e.link}|Open email>` : `_via ${e.source}_`,\n].join('\\n');\n\nconst teamsCard = {\n  type: 'message',\n  attachments: [{\n    contentType: 'application/vnd.microsoft.card.adaptive',\n    content: {\n      $schema: 'http://adaptivecards.io/schemas/adaptive-card.json', type: 'AdaptiveCard', version: '1.4',\n      body: [\n        { type: 'TextBlock', size: 'Medium', weight: 'Bolder', wrap: true,\n          text: isFollowUp ? `Customer follow-up on ${jiraKey}` : `New customer ${e.category} - ${e.priority}` },\n        { type: 'TextBlock', wrap: true, weight: 'Bolder', text: e.title },\n        { type: 'TextBlock', wrap: true, text: e.summary || '' },\n        { type: 'FactSet', facts: [\n          { title: 'Customer', value: `${e.customerName || e.fromName} <${e.fromEmail}>` },\n          { title: 'Area', value: e.productArea || 'General' },\n          { title: 'Jira', value: jiraKey || 'not created' },\n        ] },\n      ],\n      actions: jiraUrl ? [{ type: 'Action.OpenUrl', title: 'Open in Jira', url: jiraUrl }] : [],\n    },\n  }],\n};\n\nreturn { json: { ...e, jiraKey, jiraUrl, jiraError, isFollowUp, slackText, teamsCard } };"}, "typeVersion": 2}, {"id": "db72ab45-3b8a-4154-b029-816854cbd9fc", "name": "Send Slack Notification", "type": "n8n-nodes-base.slack", "onError": "continueRegularOutput", "position": [-1024, 5040], "webhookId": "11133fb4-f759-4a3d-b374-5a1eede4e0a9", "parameters": {"text": "={{ $json.slackText }}", "select": "channel", "channelId": {"__rl": true, "mode": "name", "value": "={{ $json.route.slackChannel }}"}, "otherOptions": {"unfurl_links": false, "includeLinkToWorkflow": false}}, "typeVersion": 2.3}, {"id": "7a947a27-b359-4aa0-a1ff-4aa9fa4317b3", "name": "Check Teams Webhook Availability", "type": "n8n-nodes-base.if", "position": [-816, 5040], "parameters": {"options": {}, "conditions": {"options": {"version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "loose"}, "combinator": "and", "conditions": [{"id": "d2abfbb7-75e7-4baa-a7a6-f4aff0bfaa4c", "operator": {"type": "boolean", "operation": "true", "singleValue": true}, "leftValue": "={{ !!$('Create Notification Messages').item.json.teamsWebhookUrl }}", "rightValue": ""}]}, "looseTypeValidation": true}, "typeVersion": 2.2}, {"id": "ac0278e4-f7c4-417b-902b-ab77e3f81a75", "name": "Send Teams Notification", "type": "n8n-nodes-base.httpRequest", "onError": "continueRegularOutput", "position": [-560, 4960], "parameters": {"url": "={{ $('Create Notification Messages').item.json.teamsWebhookUrl }}", "method": "POST", "options": {}, "jsonBody": "={{ JSON.stringify($('Create Notification Messages').item.json.teamsCard) }}", "sendBody": true, "specifyBody": "json"}, "typeVersion": 4.2}, {"id": "1c904120-9ce1-48c7-90e9-96ff5559764d", "name": "Return to Main Pipeline", "type": "n8n-nodes-base.code", "position": [-336, 5040], "parameters": {"mode": "runOnceForEachItem", "jsCode": "// Result returned to the main pipeline.\nconst e = $('Create Notification Messages').item.json;\nconst slack = $('Send Slack Notification').item?.json || {};\nconst { jiraPayload, teamsCard, slackText, followUpComment, dedupJql, ...rest } = e;\nreturn { json: {\n  ...rest,\n  assignedTo: e.route.owner,\n  slackChannel: e.route.slackChannel,\n  slackSent: !slack.error && (!!slack.ok || !!slack.message),\n  teamsSent: !!e.teamsWebhookUrl,\n  escalationStatus: !e.jiraKey ? 'Escalation failed - check Jira' : (e.isFollowUp ? 'Follow-up added to ' + e.jiraKey : 'Escalated'),\n  escalatedAt: new Date().toISOString(),\n} };"}, "typeVersion": 2}, {"id": "ffaa40e5-cd87-491a-8123-4eec818f6d37", "name": "Build Acknowledgement Reply", "type": "n8n-nodes-base.code", "position": [-2368, 5792], "parameters": {"mode": "runOnceForEachItem", "jsCode": "// Decide whether to acknowledge and build the reply text.\nconst e = $json;\nconst mode = String(e.ackMode || 'off').toLowerCase();   // off | draft | send\nlet skip = '';\nif (!['draft', 'send'].includes(mode)) skip = 'Acknowledgement disabled';\nelse if (e.isFollowUp) skip = 'Follow-up on existing ticket';\nelse if (!e.jiraKey) skip = 'No ticket created';\nelse if (!e.messageId) skip = 'No message ID';\n\nconst RESPONSE_TIME = { Critical: '2 business hours', High: '1 business day', Medium: '2 business days', Low: '3 business days' };\nconst firstName = String(e.customerName || e.fromName || '').trim().split(/\\s+/)[0] || 'there';\nconst what = { 'Bug': 'bug report', 'Issue': 'support request', 'New Requirement': 'feature request' }[e.category] || 'request';\nconst company = e.companyName || 'our team';\n\nconst ackText = [\n  `Hi ${firstName},`,\n  '',\n  `Thank you for contacting ${company}. We have received your ${what} (reference: ${e.jiraKey}) and passed it to the right team.`,\n  `You can expect an update within ${RESPONSE_TIME[e.priority] || '2 business days'}. Just reply to this email if you have anything to add.`,\n  '',\n  'Kind regards,',\n  `${company} ${e.ackSignature || ''}`.trim(),\n].join('\\n');\nconst ackHtml = ackText.split('\\n').map(l => `<p style=\"margin:0\">${l || '&nbsp;'}</p>`).join('');\n\nreturn { json: { ...e, ackMode: mode, ackSkipReason: skip, ackText, ackHtml,\n  ackRoute: skip ? 'skip' : (e.source === 'Outlook' ? 'outlook' : (mode === 'send' ? 'gmail-send' : 'gmail-draft')) } };"}, "typeVersion": 2}, {"id": "ad1adcf4-d01d-4fd0-8736-5f9878ac6bdd", "name": "Route by Reply Channel", "type": "n8n-nodes-base.switch", "position": [-2144, 5792], "parameters": {"rules": {"values": [{"outputKey": "Gmail send", "conditions": {"options": {"version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "strict"}, "combinator": "and", "conditions": [{"id": "4c142b9f-7a05-4c7a-809a-1e355e7e8705", "operator": {"type": "string", "operation": "equals"}, "leftValue": "={{ $json.ackRoute }}", "rightValue": "gmail-send"}]}, "renameOutput": true}, {"outputKey": "Gmail draft", "conditions": {"options": {"version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "strict"}, "combinator": "and", "conditions": [{"id": "8f69795d-0bd4-4912-8ad4-e0cb3c35e2d5", "operator": {"type": "string", "operation": "equals"}, "leftValue": "={{ $json.ackRoute }}", "rightValue": "gmail-draft"}]}, "renameOutput": true}, {"outputKey": "Outlook", "conditions": {"options": {"version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "strict"}, "combinator": "and", "conditions": [{"id": "43f278bf-677b-4573-b2b4-f5da53c450ab", "operator": {"type": "string", "operation": "equals"}, "leftValue": "={{ $json.ackRoute }}", "rightValue": "outlook"}]}, "renameOutput": true}]}, "options": {"fallbackOutput": "extra", "renameFallbackOutput": "Skip"}}, "typeVersion": 3.2}, {"id": "b9396ff0-55a6-4b50-a344-cbab1df19bb1", "name": "Send Gmail Reply", "type": "n8n-nodes-base.gmail", "onError": "continueRegularOutput", "position": [-1888, 5680], "webhookId": "af62bb9c-b658-4343-91c4-481f480ccc2d", "parameters": {"message": "={{ $json.ackText }}", "options": {"appendAttribution": false, "replyToSenderOnly": true}, "emailType": "text", "messageId": "={{ $json.messageId }}", "operation": "reply"}, "typeVersion": 2.1}, {"id": "ed2dbd38-d77a-46ee-984e-9fccc17fd8a0", "name": "Draft Gmail Reply", "type": "n8n-nodes-