laude-opus-5", "cachedResultName": "Claude Opus 5"}, "options": {}}, "credentials": {"anthropicApi": {"id": "72a50b4450644155", "name": "Dummy anthropicApi"}}, "typeVersion": 1.5}, {"id": "1aee2183-8a20-453c-b362-a2ae65b1c55d", "name": "LLM - Tickets", "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic", "position": [5072, 304], "parameters": {"model": {"__rl": true, "mode": "list", "value": "claude-sonnet-4-6", "cachedResultName": "Claude Sonnet 4.6"}, "options": {}}, "credentials": {"anthropicApi": {"id": "72a50b4450644155", "name": "Dummy anthropicApi"}}, "typeVersion": 1.3}, {"id": "fc5fc29c-a2cc-456b-b856-61e2a9547b1d", "name": "01 \u00b7 Trigger & Discover", "type": "n8n-nodes-base.stickyNote", "position": [0, -32], "parameters": {"color": 7, "width": 1000, "height": 492, "content": "### 1. Trigger & discover report definitions\nChoose **manual** or **scheduled** execution, then inspect the GitHub reports directory and identify the `.txt` query files that should be processed."}, "typeVersion": 1}, {"id": "9ed68ac7-2287-49cb-a1eb-7befbdc8899b", "name": "02 \u00b7 Load & normalize request", "type": "n8n-nodes-base.stickyNote", "position": [1104, -48], "parameters": {"color": 7, "width": 1030, "height": 476, "content": "### 2. Load & normalize request\nProcess one report query at a time. Fetch the selected file from GitHub, decode its contents, generate an execution ID for agent memory, and consolidate the request into a single item."}, "typeVersion": 1}, {"id": "733b93d7-8f83-4718-8697-ec7dcc1fd65a", "name": "03 \u00b7 Build audit rules", "type": "n8n-nodes-base.stickyNote", "position": [2208, -48], "parameters": {"color": 7, "width": 820, "height": 604, "content": "### 3. Build audit rules\nUse the Rules Summarizer Agent to turn the human-readable request and rule source into a structured ruleset. Parse and normalize the agent output before it reaches the audit stage."}, "typeVersion": 1}, {"id": "e8a1e3b3-3134-4543-a1d4-ca69b73e9437", "name": "04 \u00b7 Run the network audit", "type": "n8n-nodes-base.stickyNote", "position": [3104, -48], "parameters": {"color": 7, "width": 1030, "height": 604, "content": "### 4. Run the network audit\nCombine the request with the generated rules, then let the Audit Agent assess each rule against real device data through the **read-only pyATS MCP** tools. Memory keeps the agent context scoped to the current execution."}, "typeVersion": 1}, {"id": "1499c8de-0572-4e1b-9edb-dcfef643b171", "name": "05 \u00b7 Generate report & decide on ticket", "type": "n8n-nodes-base.stickyNote", "position": [4192, -48], "parameters": {"color": 7, "width": 1448, "height": 576, "content": "### 5. Generate report & decide on ticket\nSave the Markdown assessment to GitHub, capture its URL/tag, and ask the ticketing agent whether the findings justify a GitHub issue. Convert the structured decision to JSON and branch accordingly."}, "typeVersion": 1}, {"id": "be5ea3d9-0ef1-4384-aaa3-2c3827407860", "name": "06 \u00b7 Deliver results", "type": "n8n-nodes-base.stickyNote", "position": [5696, -48], "parameters": {"color": 7, "width": 1120, "height": 604, "content": "### 6. Deliver results\nIf actionable risk exists, create a GitHub issue and send Slack a report + issue notification. Otherwise, send a report-only notification. The loop then continues with the next query file."}, "typeVersion": 1}, {"id": "3e8c13bc-11a3-4204-862a-7b37d449c313", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [-528, 0], "parameters": {"width": 480, "height": 496, "content": "## GitHub-based Networking Auditing, Reports Generation and Ticketing\n\n### How it works\n\n1. Triggered manually or on schedule, then lists report query files from GitHub.\n2. For each query file, decodes request fields (Query, Notes, optional Rule Source URL, optional Inline Rules, optional Devices).\n3. **Agent 1 (Rule Summarizer)** derives a compact JSON rule set from either a live URL (single fetch) or inline rules.\n4. **Agent 2 (Audit + Report)** executes the derived rules against requested devices with read-only pyATS MCP tools and returns the final markdown report.\n5. The report is committed to GitHub, and **Agent 3 (Ticketing)** decides whether to create an issue.\n6. Slack cards are sent with the report link and optional issue link, then loop continues."}, "typeVersion": 1}, {"id": "f704f505-d203-475d-86fd-495448ae4501", "name": "Sticky Note1", "type": "n8n-nodes-base.stickyNote", "position": [-528, 528], "parameters": {"width": 480, "height": 288, "content": "![Arch](https://raw.githubusercontent.com/ponchotitlan/pyATS-loves-agenticops/refs/heads/main/images/banner_arch_reporting.png)"}, "typeVersion": 1}, {"id": "webhook-automata-injected-1791111459384", "name": "Automata Webhook", "type": "n8n-nodes-base.webhook", "position": [0, 0], "webhookId": "8ypTst40kVbprIp6", "parameters": {"path": "8ypTst40kVbprIp6", "options": {}, "httpMethod": "POST", "responseCode": 200, "responseMode": "onReceived"}, "typeVersion": 1.1}]
