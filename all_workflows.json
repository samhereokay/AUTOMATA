tials": {"googleSheetsOAuth2Api": {"id": "cbc1b5f60f3e43a0", "name": "Dummy googleSheetsOAuth2Api"}}, "typeVersion": 4.7}, {"id": "86303094-24ed-4597-816b-458914e13ca3", "name": "H\u00e4ndlerangebote f\u00fcr Vergleich vorbereiten", "type": "n8n-nodes-base.code", "position": [3088, 2800], "parameters": {"jsCode": "const eingaben = $input.all().map(item => item.json);\n\nif (eingaben.length === 0) {\n  throw new Error(\n    'Es wurden keine H\u00e4ndlerangebote f\u00fcr den Vergleich gefunden.'\n  );\n}\n\n// Identische H\u00e4ndlerangebote anhand ihrer eindeutigen ID entfernen\nconst eindeutigeAngebote = new Map();\n\neingaben.forEach((angebot, index) => {\n  const schluessel =\n    String(\n      angebot.Haendlerangebot_ID ||\n      angebot.Gmail_Message_ID ||\n      `OHNE-ID-${index}`\n    ).trim();\n\n  const vorhandenesAngebot =\n    eindeutigeAngebote.get(schluessel);\n\n  // Bei Dubletten die zuletzt gespeicherte Zeile verwenden\n  if (\n    !vorhandenesAngebot ||\n    Number(angebot.row_number || 0) >\n      Number(vorhandenesAngebot.row_number || 0)\n  ) {\n    eindeutigeAngebote.set(schluessel, angebot);\n  }\n});\n\nconst bereinigteEingaben =\n  Array.from(eindeutigeAngebote.values());\n\n// Deutsche und internationale Preisformate sicher einlesen\nfunction preisEinlesen(wert) {\n  if (\n    wert === undefined ||\n    wert === null ||\n    wert === ''\n  ) {\n    return null;\n  }\n\n  if (typeof wert === 'number') {\n    return Number.isFinite(wert) ? wert : null;\n  }\n\n  const text = String(wert).trim();\n\n  const zahlen = text.match(\n    /-?\\d{1,3}(?:\\.\\d{3})+(?:,\\d{1,2})?|-?\\d{1,3}(?:,\\d{3})+(?:\\.\\d{1,2})?|-?\\d+(?:,\\d{1,2})|-?\\d+(?:\\.\\d{1,2})|-?\\d+/g\n  ) || [];\n\n  if (zahlen.length === 0) {\n    return null;\n  }\n\n  // Bei \u201e19% (198,97 \u20ac)\u201c wird der letzte Wert genommen\n  let zahlText = zahlen[zahlen.length - 1]\n    .replace(/\\s/g, '');\n\n  if (\n    zahlText.includes('.') &&\n    zahlText.includes(',')\n  ) {\n    if (\n      zahlText.lastIndexOf(',') >\n      zahlText.lastIndexOf('.')\n    ) {\n      // Deutsches Format: 1.246,17\n      zahlText = zahlText\n        .replace(/\\./g, '')\n        .replace(',', '.');\n    } else {\n      // Internationales Format: 1,246.17\n      zahlText = zahlText.replace(/,/g, '');\n    }\n  } else if (zahlText.includes(',')) {\n    zahlText = zahlText.replace(',', '.');\n  } else if (zahlText.includes('.')) {\n    const teile = zahlText.split('.');\n\n    const istTausenderformat =\n      teile.length >= 2 &&\n      teile[teile.length - 1].length === 3 &&\n      teile.slice(1).every(\n        teil => teil.length === 3\n      ) &&\n      teile[0].length <= 3;\n\n    if (istTausenderformat) {\n      zahlText = zahlText.replace(/\\./g, '');\n    }\n  }\n\n  const zahl = Number(zahlText);\n\n  return Number.isFinite(zahl) ? zahl : null;\n}\n\nfunction lieferzeitEinlesen(wert) {\n  const zahlen =\n    String(wert || '')\n      .match(/\\d+/g)\n      ?.map(Number) || [];\n\n  return {\n    minimum:\n      zahlen.length >= 1 ? zahlen[0] : null,\n\n    maximum:\n      zahlen.length >= 2\n        ? zahlen[1]\n        : zahlen.length === 1\n          ? zahlen[0]\n          : null\n  };\n}\n\nconst preisanfrageId =\n  String(\n    bereinigteEingaben[0].Preisanfrage_ID || ''\n  ).trim();\n\nif (!preisanfrageId) {\n  throw new Error(\n    'Die Preisanfrage_ID fehlt in den H\u00e4ndlerangeboten.'\n  );\n}\n\nconst unterschiedlicheIds =\n  bereinigteEingaben.filter(\n    angebot =>\n      String(\n        angebot.Preisanfrage_ID || ''\n      ).trim() !== preisanfrageId\n  );\n\nif (unterschiedlicheIds.length > 0) {\n  throw new Error(\n    'Die H\u00e4ndlerangebote geh\u00f6ren nicht alle zur selben Preisanfrage_ID.'\n  );\n}\n\nconst angebote = bereinigteEingaben.map(\n  angebot => {\n    const lieferzeit =\n      lieferzeitEinlesen(angebot.Lieferzeit);\n\n    return {\n      row_number: angebot.row_number,\n\n      Haendlerangebot_ID:\n        angebot.Haendlerangebot_ID || '',\n\n      Preisanfrage_ID:\n        angebot.Preisanfrage_ID || '',\n\n      Angebotsnummer:\n        angebot.Angebotsnummer || '',\n\n      Haendlername:\n        angebot.Haendlername ||\n        'Nicht angegeben',\n\n      Grosshaendler_Absender:\n        angebot.Grosshaendler_Absender || '',\n\n      Gesamtpreis_netto:\n        preisEinlesen(\n          angebot.Gesamtpreis_netto\n        ),\n\n      Mehrwertsteuer:\n        preisEinlesen(\n          angebot.Mehrwertsteuer\n        ),\n\n      Gesamtpreis_brutto:\n        preisEinlesen(\n          angebot.Gesamtpreis_brutto\n        ),\n\n      Lieferkosten:\n        preisEinlesen(\n          angebot.Lieferkosten\n        ),\n\n      Lieferzeit:\n        angebot.Lieferzeit ||\n        'Nicht angegeben',\n\n      Lieferzeit_min_Tage:\n        lieferzeit.minimum,\n\n      Lieferzeit_max_Tage:\n        lieferzeit.maximum,\n\n      Gueltig_bis:\n        angebot.Gueltig_bis ||\n        'Nicht angegeben',\n\n      Zahlungsbedingungen:\n        angebot.Zahlungsbedingungen ||\n        'Nicht angegeben',\n\n      Positionen:\n        angebot.Positionen ||\n        'Nicht angegeben',\n\n      Hinweise:\n        angebot.Hinweise || '',\n\n      Zusammenfassung:\n        angebot.Zusammenfassung || ''\n    };\n  }\n);\n\nangebote.sort((a, b) => {\n  const preisA =\n    a.Gesamtpreis_brutto ??\n    Number.POSITIVE_INFINITY;\n\n  const preisB =\n    b.Gesamtpreis_brutto ??\n    Number.POSITIVE_INFINITY;\n\n  if (preisA !== preisB) {\n    return preisA - preisB;\n  }\n\n  const lieferzeitA =\n    a.Lieferzeit_max_Tage ??\n    Number.POSITIVE_INFINITY;\n\n  const lieferzeitB =\n    b.Lieferzeit_max_Tage ??\n    Number.POSITIVE_INFINITY;\n\n  return lieferzeitA - lieferzeitB;\n});\n\nreturn [\n  {\n    json: {\n      Preisanfrage_ID: preisanfrageId,\n\n      Anzahl_Angebote: angebote.length,\n\n      Entfernte_Dubletten:\n        eingaben.length -\n        bereinigteEingaben.length,\n\n      Vergleich_bereit:\n        angebote.length >= 2,\n\n      Vergleichsstatus:\n        angebote.length >= 2\n          ? 'BEREIT_ZUM_VERGLEICH'\n          : 'WEITERES_ANGEBOT_ERFORDERLICH',\n\n      Angebote: angebote,\n\n      Angebote_JSON:\n        JSON.stringify(angebote, null, 2)\n    }\n  }\n];"}, "typeVersion": 2}, {"id": "b7835542-99d2-4d50-9c4b-01edc83d3f1a", "name": "Mindestens zwei H\u00e4ndlerangebote pr\u00fcfen", "type": "n8n-nodes-base.if", "position": [3312, 2800], "parameters": {"options": {}, "conditions": {"options": {"version": 3, "leftValue": "", "caseSensitive": true, "typeValidation": "strict"}, "combinator": "and", "conditions": [{"id": "5ae8500f-d496-4364-95e2-cc70fe74eb4a", "operator": {"type": "boolean", "operation": "true", "singleValue": true}, "leftValue": "={{ $json.Vergleich_bereit }}", "rightValue": ""}]}}, "typeVersion": 2.3}, {"id": "a7c62173-b7b1-4a3f-be46-7a0c852c659f", "name": "H\u00e4ndlerangebote vergleichen", "type": "@n8n/n8n-nodes-langchain.openAi", "position": [3520, 2800], "parameters": {"modelId": {"__rl": true, "mode": "list", "value": "gpt-5-mini", "cachedResultName": "GPT-5-MINI"}, "options": {"textFormat": {"textOptions": {"type": "json_object", "verbosity": "low"}}}, "responses": {"values": [{"content": "=Vergleiche alle H\u00e4ndlerangebote derselben Preisanfrage und bestimme das insgesamt beste Angebot.\n\nBewertungskriterien:\n1. Gesamtpreis brutto\n2. Lieferzeit\n3. Lieferkosten\n4. Zahlungsbedingungen\n5. Vollst\u00e4ndigkeit und Plausibilit\u00e4t des Angebots\n\nDer niedrigste Preis ist wichtig, aber nicht automatisch allein entscheidend. Ein geringf\u00fcgig teureres Angebot darf empfohlen werden, wenn Lieferzeit oder Zahlungsbedingungen deutlich besser sind.\n\nVerwende ausschlie\u00dflich die \u00fcbergebenen Daten. Erfinde keine Angaben.\n\nGib ausschlie\u00dflich ein g\u00fcltiges JSON-Objekt mit exakt diesen Feldern zur\u00fcck:\n\n{\n  \"Preisanfrage_ID\": \"\",\n  \"Bestes_Haendlerangebot_ID\": \"\",\n  \"Bester_Haendlername\": \"\",\n  \"Bester_Gesamtpreis_brutto\": 0,\n  \"Bester_Gesamtpreis_netto\": 0,\n  \"Bester_Lieferkosten\": 0,\n  \"Bester_Lieferzeit\": \"\",\n  \"Bester_Zahlungsbedingungen\": \"\",\n  \"Anzahl_verglichener_Angebote\": 0,\n  \"Preisunterschied_zum_teuersten_Angebot\": 0,\n  \"Preisvergleich\": \"\",\n  \"Lieferzeitvergleich\": \"\",\n  \"Begruendung\": \"\",\n  \"KI_Empfehlung\": \"\"\n}\n\nRegeln:\n- IDs exakt und unver\u00e4ndert \u00fcbernehmen.\n- Geldbetr\u00e4ge ausschlie\u00dflich als Zahlen ohne Eurozeichen ausgeben.\n- Keine Markdown-Formatierung verwenden.\n- Keine zus\u00e4tzlichen Felder erg\u00e4nzen.\n- Fehlende Angaben mit \"Nicht angegeben\" ausf\u00fcllen.\n- Die KI_Empfehlung soll kurz, konkret und f\u00fcr einen Handwerksbetrieb verst\u00e4ndlich sein.\n\nPreisanfrage:\n{{ $json.Preisanfrage_ID }}\n\nAnzahl der Angebote:\n{{ $json.Anzahl_Angebote }}\n\nH\u00e4ndlerangebote:\n{{ $json.Angebote_JSON }}"}]}, "builtInTools": {}}, "credentials": {"openAiApi": {"id": "d83021c6ea6c47ee", "name": "Dummy openAiApi"}}, "typeVersion": 2.3}, {"id": "b05e9ce4-4ac3-47ce-a63c-2f805c840d22", "name": "Vergleichsergebnis f\u00fcr Tabellen vorbereiten", "type": "n8n-nodes-base.code", "position": [3744, 2800], "parameters": {"jsCode": "const eingabe = $input.first().json;\n\n// KI-Ergebnis aus der OpenAI-Ausgabe holen\nlet ergebnis =\n  eingabe.output?.[0]?.content?.[0]?.text ??\n  eingabe.text ??\n  eingabe;\n\n// Falls das Modell JSON als Text zur\u00fcckgibt\nif (typeof ergebnis === 'string') {\n  const bereinigterText = ergebnis\n    .replace(/^```json\\s*/i, '')\n    .replace(/^```\\s*/i, '')\n    .replace(/```$/i, '')\n    .trim();\n\n  try {\n    ergebnis = JSON.parse(bereinigterText);\n  } catch (error) {\n    throw new Error(\n      `Das KI-Vergleichsergebnis ist kein g\u00fcltiges JSON: ${error.message}`\n    );\n  }\n}\n\nif (!ergebnis || typeof ergebnis !== 'object') {\n  throw new Error(\n    'Das KI-Vergleichsergebnis konnte nicht verarbeitet werden.'\n  );\n}\n\nconst preisanfrageId =\n  String(ergebnis.Preisanfrage_ID || '').trim();\n\nconst bestesAngebotId =\n  String(ergebnis.Bestes_Haendlerangebot_ID || '').trim();\n\nif (!preisanfrageId) {\n  throw new Error(\n    'Im KI-Vergleichsergebnis fehlt die Preisanfrage_ID.'\n  );\n}\n\nif (!bestesAngebotId) {\n  throw new Error(\n    'Im KI-Vergleichsergebnis fehlt die Bestes_Haendlerangebot_ID.'\n  );\n}\n\n// Urspr\u00fcnglich verglichene Angebote laden\nconst vergleichsdaten =\n  $('H\u00e4ndlerangebote f\u00fcr Vergleich vorbereiten')\n    .first()\n    .json;\n\nconst angebote =\n  Array.isArray(vergleichsdaten.Angebote)\n    ? vergleichsdaten.Angebote\n    : [];\n\nif (angebote.length < 2) {\n  throw new Error(\n    'F\u00fcr die Tabellenaktualisierung wurden weniger als zwei Angebote gefunden.'\n  );\n}\n\nconst bestesAngebotGefunden =\n  angebote.some(\n    angebot =>\n      String(angebot.Haendlerangebot_ID || '').trim() ===\n      bestesAngebotId\n  );\n\nif (!bestesAngebotGefunden) {\n  throw new Error(\n    `Das beste H\u00e4ndlerangebot ${bestesAngebotId} ist nicht in den verglichenen Angeboten enthalten.`\n  );\n}\n\n// Aktualisierungen f\u00fcr jede Angebotszeile vorbereiten\nconst angeboteAktualisierungen =\n  angebote.map(angebot => {\n    const angebotId =\n      String(\n        angebot.Haendlerangebot_ID || ''\n      ).trim();\n\n    const istBestesAngebot =\n      angebotId === bestesAngebotId;\n\n    return {\n      Haendlerangebot_ID: angebotId,\n      Preisanfrage_ID: preisanfrageId,\n      Vergleichsstatus: 'VERGLICHEN',\n      Ist_bestes_Angebot: istBestesAngebot,\n\n      KI_Empfehlung: istBestesAngebot\n        ? String(\n            ergebnis.KI_Empfehlung ||\n            ergebnis.Begruendung ||\n            ''\n          )\n        : `Nicht ausgew\u00e4hlt. Empfohlen wird ${\n            ergebnis.Bester_Haendlername ||\n            bestesAngebotId\n          }.`\n    };\n  });\n\nreturn [\n  {\n    json: {\n      Preisanfr