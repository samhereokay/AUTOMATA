n\\n?/gi, '').replace(/```/g, '').trim();\n\n  try {\n    const parsedJson = JSON.parse(outputText);\n    return { json: parsedJson };\n  } catch {\n    return { json: { create_issue: false } };\n  }\n});"}, "typeVersion": 2}, {"id": "9a2cc882-14b8-489e-90b4-e2ad8e8c68c3", "name": "Is there an issue?", "type": "n8n-nodes-base.if", "position": [5760, 112], "parameters": {"options": {}, "conditions": {"options": {"version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "strict"}, "combinator": "and", "conditions": [{"id": "44b388a2-943d-4801-b559-c51f2b077113", "operator": {"type": "boolean", "operation": "true", "singleValue": true}, "leftValue": "={{ $json.create_issue }}", "rightValue": ""}]}}, "typeVersion": 2.2}, {"id": "ee1e4532-29da-444d-bc1d-329f18ac6d6a", "name": "Create an issue", "type": "n8n-nodes-base.github", "position": [6272, 96], "webhookId": "ad3b9396-66e6-48b1-8a49-6e88ef07c205", "parameters": {"body": "={{ $('Convert to JSON').item.json.description }}\n\n\ud83d\udcda Reference report: {{ $('Consolidate ticketing query').item.json.report_url }}", "owner": {"__rl": true, "mode": "name", "value": "ponchotitlan"}, "title": "=[{{ $('Consolidate ticketing query').item.json.report_tag }}] [{{ $('Convert to JSON').item.json.priority }}] {{ $('Convert to JSON').item.json.title }}", "labels": [{"label": "={{ $json.priority }}"}], "assignees": [], "repository": {"__rl": true, "mode": "list", "value": "pyATS-loves-agenticops", "cachedResultUrl": "https://github.com/ponchotitlan/pyATS-loves-agenticops", "cachedResultName": "pyATS-loves-agenticops"}}, "credentials": {"githubApi": {"id": "b89e2be75fec4b31", "name": "Dummy githubApi"}}, "typeVersion": 1.1}, {"id": "fe90ac66-aa44-4466-b614-38286ae20b83", "name": "Send Card with Report and Issue", "type": "n8n-nodes-base.slack", "position": [6608, 256], "parameters": {"text": "=\ud83d\udcdd Automated Report Generation", "channel": "your_channel_id", "blocksJson": "={{ JSON.stringify([\n  {\n    \"type