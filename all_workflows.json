eIAvSUEdxSNVBrdM|[{"id": "877584c6-ca5f-418e-bfa3-4dbf9eba9ea7", "name": "Schedule Trigger", "type": "n8n-nodes-base.scheduleTrigger", "position": [-320, 0], "parameters": {"rule": {"interval": [{}]}}, "typeVersion": 1.3}, {"id": "7bf5bbc7-65cd-445e-9075-457945ec5bfd", "name": "Decodo", "type": "n8n-nodes-base.noOp", "position": [384, 16], "parameters": {"url": "={{ $json.url }}", "operation": "amazon"}, "credentials": {"decodoApi": {"id": "4bc6d1d948e04ba5", "name": "Dummy decodoApi"}}, "typeVersion": 1}, {"id": "00a28249-c90d-4532-866c-0e1eaf23784f", "name": "Get row(s) in sheet", "type": "n8n-nodes-base.googleSheets", "position": [-80, 0], "parameters": {"options": {}, "sheetName": {"__rl": true, "mode": "list", "value": "gid=0", "cachedResultUrl": "", "cachedResultName": "list urls"}, "documentId": {"__rl": true, "mode": "list", "value": "", "cachedResultUrl": "", "cachedResultName": "decodo"}}, "credentials": {"googleSheetsOAuth2Api": {"id": "cbc1b5f60f3e43a0", "name": "Dummy googleSheetsOAuth2Api"}}, "typeVersion": 4.7}, {"id": "9e5e3fdd-0e01-43ce-a576-9ad31f817355", "name": "Google Gemini Chat Model", "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini", "position": [720, 272], "parameters": {"options": {}}, "credentials": {"googlePalmApi": {"id": "11a68a950433485d", "name": "Dummy googlePalmApi"}}, "typeVersion": 1}, {"id": "93845a3b-96ef-4f77-8456-1ef88d868fb8", "name": "Code in JavaScript", "type": "n8n-nodes-base.code", "position": [592, 16], "parameters": {"jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nconst reviews = $input.first().json.results[0].content.results.reviews.map(el => (\n `${el.review_from} - ${el.rating} - ${el.content}`\n))\n\nreturn {\n  reviews: reviews.join(\"\\n\\n\"),\n  url: $('Get row(s) in sheet').first().json.url\n}"}, "typeVersion": 2}, {"id": "3ad0d98e-1e81-410c-a821-448bd4ecac45", "name": "Summarize Reviews", "type": "@n8n/n8n-nodes-langchain.chainSummarization", "position": [1168, 80], "parameters": {"options": {}}, "typeVersion": 2.1}, {"id": "07a0197d-94e2-4016-ab72-d51b9e15414f", "name": "Alert Group", "type": "n8n-nodes-base.telegram", "position": [1504, 96], "webhookId": "6e4c1f35-6293-440b-afdd-b8b7c310d7b6", "parameters": {"text": "=\ud83d\udea8ALERT WARNING\ud83d\udea8\nDate: {{ DateTime.now().format('yyyy-MM-dd') }}\nSentiment: {{ $('Sentiment Analyzer').item.json.sentimentAnalysis.category }}\n\nUrl: {{ $('Code in JavaScript').item.json.url }}\n\nSummary: {{ $json.output.text }}\n\n", "chatId": "123456789", "additionalFields": {}}, "credentials": {"telegramApi": {"id": "XP2SJ3wLc8EY82QZ", "name": "Telegram API"}}, "typeVersion": 1.2}, {"id": "f027e9fa-8bf9-4f4a-a702-abecf6f472f2", "name": "Loop Over Items", "type": "n8n-nodes-base.splitInBatches", "position": [144, 0], "parameters": {"options": {}, "batchSize": 5}, "typeVersion": 3}, {"id": "802c3000-3e37-40a5-b7a6-cffefaa4600c", "name": "Store to Sheet", "type": "n8n-nodes-base.googleSheets", "position": [1456, -272], "parameters": {"columns": {"value": {"Url": "={{ $('Code in JavaScript').item.json.url }}", "Sentiment": "={{ $json.sentimentAnalysis.category }}", "List Review": "={{ $json.reviews }}"}, "schema": [{"id": "Url", "type": "string", "display": true, "required": false, "displayName": "Url", "defaultMatch": false, "canBeUsedToMatch": true}, {"id": "List Review", "type": "string", "display": true, "required": false, "displayName": "List Review", "defaultMatch": false, "canBeUsedToMatch": true}, {"id": "Sentiment", "type": "string", "display": true, "required": false, "displayName": "Sentiment", "defaultMatch": false, "canBeUsedToMatch": true}], "mappingMode": "defineBelow", "matchingColumns": [], "attemptToConvertTypes": false, "convertFieldsToString": false}, "options": {}, "operation": "append", "sheetName": {"__rl": true, "mode": "list", "value": 1499922583, "cachedResultUrl": "https://docs.google.com/spreadsheets/d/1uvnAqq36EoJqdTN01oHCsQs7eqP0zVP3BM_ZJ7avepQ/edit#gid=1499922583", "cachedResultName": "user review aggregations"}, "documentId": {"__rl": true, "mode": "list", "value": "1uvnAqq36EoJqdTN01oHCsQs7eqP0zVP3BM_ZJ7avepQ", "cachedResultUrl": "https://docs.google.com/spreadsheets/d/1uvnAqq36EoJqdTN01oHCsQs7eqP0zVP3BM_ZJ7avepQ/edit?usp=drivesdk", "cachedResultName": "decodo"}}, "credentials": {"googleSheetsOAuth2Api": {"id": "cbc1b5f60f3e43a0", "name": "Dummy googleSheetsOAuth2Api"}}, "typeVersion": 4.7}, {"id": "6a4a0040-617d-45e4-ad41-2152343eab93", "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "position": [-608, -640], "parameters": {"width": 624, "height": 608, "content": "## Automated Review Monitoring with Decodo, Google Sheets, Gemini AI & Telegram Alerts\n\nGreat For:\n\u2022 E-commerce owners\n\u2022 Product managers\n\u2022 Reputation & CX teams\n\u2022 Amazon/Marketplace sellers\n\u2022 Anyone who wants hands-off, scheduled review monitoring + alerts\n\nWhat It Does:\n- Reads URLs from Google Sheets\n- Loops through each product URL\n- Scrapes reviews using Decodo\n- Converts scraped data into clean text\n- Detects sentiment (positive / neutral / negative)\n- Summarizes all reviews\n- Sends Telegram alerts when needed\n- Stores all results in a review log sheet\n\nWhy It\u2019s Useful:\n- Fully automated review monitoring\n- Daily digest + alerts for negative sentiment\n- Structured historical record of reviews\n- Works without coding\n- Upgradable (translation, classification, etc.)"}, "typeVersion": 1}, {"id": "1cf7d274-422d-4b0b-bfe3-7d8c7fda7361", "name": "Sticky Note1", "type": "n8n-nodes-base.stickyNote", "position": [-192, 208], "parameters": {"content": "## Google Sheets\n\n\u2022 Keep one URL per row\n\u2022 Ensure Sheet permissions allow n8n access"}, "typeVersion": 1}, {"id": "3e2de6e1-0de2-4d49-a234-eb116671c452", "name": "Sticky Note2", "type": "n8n-nodes-base.stickyNote", "position": [256, -400], "parameters": {"width": 304, "height": 240, "content": "### Decodo \n\nWhat it does:\nScrapes Amazon product reviews based on the given URL.\n\nOutput:\nStructured JSON with reviewer name, rating, and review content."}, "typeVersion": 1}, {"id": "69ba32f1-844e-4dc2-ab59-4795df6d1219", "name": "Sticky Note3", "type": "n8n-nodes-base.stickyNote", "position": [640, -400], "parameters": {"width": 304, "height": 240, "content": "### Javascript\n\ntransforms Decodo\u2019s raw JSON into simple text blocks of:\n<author> \u2013 <rating> \u2013 <content>\n\nResult:\nA clean, multi-line text string ready for sentiment + summarization."}, "typeVersion": 1}, {"id": "5742938e-b6ad-4d65-8d4d-4bacfb144be7", "name": "Sentiment Analyzer", "type": "@n8n/n8n-nodes-langchain.sentimentAnalysis", "position": [800, -16], "parameters": {"options": {}, "inputText": "={{ $json.reviews }}"}, "typeVersion": 1.1}, {"id": "323a388b-a7f8-40a5-b99a-d46690a6dd79", "name": "Sticky Note4", "type": "n8n-nodes-base.stickyNote", "position": [1408, -544], "parameters": {"width": 304, "height": 240, "content": "Saves a new record into the \u201cuser review aggregations\u201d sheet.\n\nStored fields:\n\u2022 Cleaned review text\n\u2022 Sentiment\n\u2022 Product URL\n\nPurpose:\nCreates a historical review database you can analyze anytime."}, "typeVersion": 1}, {"id": "webhook-automata-injected-1791111459356", "name": "Automata Webhook", "type": "n8n-nodes-base.webhook", "position": [0, 0], "webhookId": "eIAvSUEdxSNVBrdM", "parameters": {"path": "eIAvSUEdxSNVBrdM", "options": {}, "httpMethod": "POST", "responseCode": 200, "responseMode": "onReceived"}, "typeVersion": 1.1}]
X5QbZmDHag2VlNgB|[{"id": "ff08f551-7eab-4c7a-918a-2e12d7e5b12b", "name": "Start Here - Workflow Overview", "type": "n8n-nodes-base.stickyNote", "position": [0, -1200], "parameters": {"color": 1, "width": 760, "height": 1050, "content": "## AI cold email sequences\n\n### How it works\nResearches prospects using LinkedIn profiles and posts, drafts personalised emails with OpenAI and Qdrant service knowledge, and delegates delivery to a sending sub-workflow. Three scheduled branches prepare later follow-ups and update NocoDB records.\n\nRead the numbered sections from left to right, then continue to the next row: initial email, first follow-up, second follow-up, final follow-up, and knowledge-base setup.\n\n### How to set up\n1. Connect OpenAI, RapidAPI, NocoDB and Qdrant. Replace the API-key placeholders and deployment-specific database URLs.\n2. Import/create and reselect these three required external workflows, which are **not included in this JSON**:\n   - `1.1 = If Emails Available to Send Email-v2`\n   - `1.2 = Send Emails-v2`\n   - `1.3 = Filter Leads Data-v2`\n3. Map your lead/company fields, choose the Qdrant collection and upload your service PDFs/CSVs.\n4. Set the workflow timezone and confirm the four weekday schedules. Read the detailed setup and configuration-check notes beside this one.\n5. Keep schedules inactive while testing each branch with one lead and an inbox you control.\n\n### Customization\n- Change the AI prompts for your audience, services, tone and call to action.\n- Adjust trigger times, pacing waits and lead-query limits.\n- Replace company knowledge and the Qdrant collection with your own material.\n- Configure eligibility and sender limits in the external workflows.\n- Replace tracking-pixel URLs if using tracking.\n\nThis export is inactive. Notes describe the workflow; live execution still requires configuration and testing."}, "typeVersion": 1}, {"id": "8a9bc7c7-b835-4444-a7de-12da36f5bfbb", "name": "Setup - Services and Data", "type": "n8n-nodes-base.stickyNote", "position": [856, -1200], "parameters": {"color": 4, "width": 760, "height": 1050, "content": "## Setup before running\n\n1. Connect OpenAI credentials to the chat-model and embedding nodes. Confirm the configured model is available in your account.\n2. Replace `YOUR_NOCODB_API_TOKEN`, `YOUR_RAPIDAPI_KEY` and `YOUR_OPENAI_API_KEY` in the HTTP headers, preferably using n8n credentials.\n3. Replace the NocoDB host, project and table URLs with your own. Preserve the existing query filters and map fields to your schema.\n4. Configure the three external workflows listed in the overview. Confirm their input/output contracts.\n5. Connect Qdrant credentials. Use the same collection and compatible embeddings for both insertion and retrieval.\n6. Upload your service material through the knowledge-base form before generating emails.\n\n### Expected records\nLeads include `email`, `name`, `linkedin_url`, `industry` and `title`. Follow-up rows include `Id`, `Name`, `Company`, `email_sent_to`, `email_sent_from` and `Need of follow up?`. Company data includes `your_company_name` and `company_services`.\n\n### Schedule\nThe triggers run Monday-Friday at **16:00, 16:15, 16:30 and 16:45 in the n8n workflow/instance timezone**. Set that timezone and verify the schedule; the existing node labels are not authoritative."}, "typeVersion": 1}, {"id": "75bef8d0-1354-48ef-abc1-a4d0ff70d9df", "name": "Review - Existing Configuration Dependencies", "type": "n8n-nodes-base.stickyNote", "position": [1712, -1200], "parameters": {"color": 3, "width": 760, "height": 1050, "content": "## Check configuration before activation\n\nThe annotations describe the supplied export; they do not repair its execution logic.\n\n- Check generated fields against the structured parsers: some prompts request `email_subject` / `email_message`, while later nodes consume `subject` / `cold_email`.\n- Verify batching and expressions that use `.first()` with multiple leads.\n- Verify eligibility, reply detection, sending limits and sequence handling in the external workflows. Their internals are not included here.\n- The final branch's sequence-preparation Code node currently emits `3`; its email-payload Code node emits `4`. Confirm the intended contract with the filter workflow.\n- Follow-up filtering and reply-related node names do not prove that replies are monitored. Inspect the referenced workflows and the database update payloads.\n- The tracking-pixel URLs in the follow-up payloads are deployment-specific. Replace them if you use tracking.\n\n### Test\nKeep schedules inactive. Use a single test lead and an inbox you control, check the draft fields and database updates, then test each branch with the external workflows connected."}, "typeVersion": 1}, {"id": "ec7c62b2-11c1-4d65-90f4-ef4b2761a026", "name": "01 - Select and Prepare New Leads", "type": "n8n-nodes-base.stickyNote", "position": [0, 0], "parameters": {"color": 5, "width": 4256, "height": 800, "content": "## Section 1: Select and prepare new leads\nThe weekday trigger reads up to 500 NocoDB leads whose `done` field is empty. Split Out and the batch loop pass leads through pacing waits and build the lead fields used downstream.\n\n**Configure:** lead table URL, field mapping and timezone. The completion node marks the end of this loop; it does not send an email."}, "typeVersion": 1}, {"id": "c5d812de-125c-4ca1-b7cc-cf7794600cf9", "name": "02 - Check Sender Availability", "type": "n8n-nodes-base.stickyNote", "position": [4352, 0], "parameters": {"color": 5, "width": 1120, "height": 800, "content": "## Section 2: Check sender availability\nCalls the inbox-availability sub-workflow with `_firstItem = 1`. The IF node only continues to LinkedIn research when `emails_available` is true; otherwise it routes to completion.\n\n**Dependency:** reselect your availability workflow. It must return `emails_available` and the `selected_email` data consumed by later expressions."}, "typeVersion": 1}, {"id": "9877c490-1868-4bec-a2ff-d0245023f8b7", "name": "03 - Research the Prospect", "type": "n8n-nodes-base.stickyNote", "position": [5568, 0], "parameters": {"color": 5, "width": 2464, "height": 800, "content": "## Section 3: Research the prospect\nFetches the lead's LinkedIn posts and profile in parallel, merges the responses, and asks an AI agent to prepare a service-related briefing. The Code node combines the briefing with lead data for email drafting.\n\n**Configure:** RapidAPI headers, LinkedIn username and OpenAI credentials. Missing or generic posts reduce personalisation; review the generated briefing."}, "typeVersion": 1}, {"id": "104dfe45-1cee-43b1-9951-addcd52bc9bb", "name": "04 - Draft and Parse the Initial Email", "type": "n8n-nodes-base.stickyNote", "position": [8128, 0], "parameters": {"color": 5, "width": 1568, "height": 800, "content": "## Section 4: Draft and parse the initial email\nTwo AI agents prepare and structure the initial message, with the shared Qdrant retrieval tool supplying service information. Email Data maps the parsed result into a sequence-1 delivery payload.\n\n**Check:** parser fields, skip-message handling and sender selection before delivery. The first agent's existing name says availability checker, but its prompt writes email copy."}, "typeVersion": 1}, {"id": "90785b42-dbaa-4adf-b6fb-a734f3360b80", "name": "05 - Deliver and Record the Initial Email", "type": "n8n-nodes-base.stickyNote", "position": [9792, 0], "parameters": {"color": 5, "width": 2016, "height": 800, "content": "## Section 5: Deliver and record the initial email\nCalls the sending sub-workflow, creates a follow-up record in NocoDB, fetches the lead by email, then patches the lead record and returns to the batch loop.\n\n**Dependency:** delivery is implemented in the external sending workflow. Verify its returned fields and inspect the PATCH payload; the node's reply-related name does not establish reply monitoring."}, "typeVersion": 1}, {"id": "6156dd7d-8c2c-4c4a-8bd4-aaff1010f9ba", "name": "06 - Select First Follow-up Leads", "type": "n8n-nodes-base.stickyNote", "position": [0, 1000], "parameters": {"color": 5, "width": 3360, "height": 800, "content": "## Section 6: Select first follow-up leads\nThe 16:15 weekday trigger loads follow-up rows, prepares a sequence container and calls the lead-filter sub-workflow. Split Out and the loop process eligible items; Aggregate provides the record used by downstream expressions.\n\n**Configure:** follow-up table and filter-workflow mapping. The filter call passes `sequence = 1`; check this contract in that external workflow."}, "typeVersion": 1}, {"id": "75b07d7b-0ec9-4448-9402-7cee06069607", "name": "07 - Gate the First Follow-up", "type": "n8n-nodes-base.stickyNote", "position": [3456, 1000], "parameters": {"color": 5, "width": 2016, "height": 800, "content": "## Section 7: Gate the first follow-up\nCalls the inbox-availability workflow with `_firstItem = 2`. If an inbox is available, the branch waits before loading company service information.\n\n**Dependency:** sender availability and limits are implemented externally. The false output of this IF node is unconnected in the supplied export."}, "typeVersion": 1}, {"id": "210faf3d-7cd6-4574-86fa-70dfd74198fd", "name": "08 - Research and Refine the First Follow-up", "type": "n8n-nodes-base.stickyNote", "position": [5568, 1000], "parameters": {"color": 5, "width": 2016, "height": 800, "content": "## Section 8: Research and refine the first follow-up\nBuilds an article-based prompt, calls the OpenAI chat-completions endpoint, normalises the response and refines the email with an AI agent. A reasoning tool and the shared Qdrant service knowledge support this stage.\n\n**Configure:** OpenAI HTTP authorization and model credentials. Review research results and the final parsed subject/body."}, "typeVersion": 1}, {"id": "c3b936a3-67f6-47d9-bab2-0374c9ed010d", "name": "09 - Deliver the First Follow-up", "type": "n8n-nodes-base.stickyNote", "position": [7680, 1000], "parameters": {"color": 5, "width": 2016, "height": 800, "content": "## Section 9: Deliver the first follow-up\nBuilds a sequence-2 payload and tracking-pixel tag, adds the follow-up record ID, invokes the sending workflow, then patches the follow-up count and returns to the loop.\n\n**Configure:** sending-workflow reference, count-update fields and pixel endpoint. Email delivery and any send-result checks belong to the external workflow."}, "typeVersion": 1}, {"id": "2a51e85c-3c2f-4fb7-b520-d6b91f028da1", "name": "10 - Select Second Follow-up Leads", "type": "n8n-nodes-base.stickyNote", "position": [0, 2000], "parameters": {"color": 5, "width": 3360, "height": 800, "content": "## Section 10: Select second follow-up leads\nThe 16:30 weekday trigger loads follow-up rows, prepares `sequence = 2` for the filter workflow, splits eligible leads and processes them through a batch loop and Aggregate.\n\n**Configure:** NocoDB table and filter-workflow reference. Check eligibility and reply exclusion in the external filter before enabling the schedule."}, "typeVersion": 1}, {"id": "5a4d3ffe-9761-4902-915a-9c266689b698", "name": "11 - Gate and Load the Second Follow-up", "type": "n8n-nodes-base.stickyNote", "position": [3456, 2000], "parameters": {"color": 5, "width": 2912, "height": 800, "content": "## Section 11: Gate and load the second follow-up\nChecks sender availability with `_firstItem = 3`, waits, loads company information and fetches the original lead by recipient email. The IF node requires a non-empty lead email before continuing.\n\n**Configure:** sender workflow and company/lead tables. The availability IF's false output is unconnected; the lead-email IF's false output returns to the batch loop."}, "typeVersion": 1}, {"id": "a6382843-3920-493f-b91c-e6a82cda47cb", "name": "12 - Draft from Company LinkedIn Posts", "type": "n8n-nodes-base.stickyNote", "position": [6464, 2000], "parameters": {"color": 5, "width": 2016, "height": 800, "content": "## Section 12: Draft from company LinkedIn posts\nExtracts the company username from its LinkedIn URL, fetches company posts and checks the API `success` flag. An AI agent drafts the next email using those posts and the shared service knowledge base.\n\n**Configure:** RapidAPI and OpenAI credentials. An unsuccessful posts response returns to the batch loop; inspect parser output before delivery."}, "typeVersion": 1}, {"id": "e417e0f8-b625-46ed-b3c4-cd102dbb5064", "name": "13 - Deliver the Second Follow-up", "type": "n8n-nodes-base.stickyNote", "position": [8576, 2000], "parameters": {"color": 5, "width": 2464, "height": 800, "content": "## Section 13: Deliver the second follow-up\nBuilds a sequence-3 payload with a UUID and pixel tag, attaches the follow-up record ID and delegates sending. After a short wait it patches the follow-up count and returns to the batch loop.\n\n**Configure:** sending-workflow reference, tracking endpoint and NocoDB update fields."}, "typeVersion": 1}, {"id": "24615e25-ab19-4b15-b830-565594c2aa89", "name": "14 - Select Final Follow-up Leads", "type": "n8n-nodes-base.stickyNote", "position": [0, 3000], "parameters": {"color": 5, "width": 3360, "height": 800, "content": "## Section 14: Select final follow-up leads\nThe 16:45 weekday trigger loads follow-up rows, calls the filter workflow and processes eligible records through Split Out, a loop and Aggregate.\n\n**Check the contract:** Update Email Sequence 3 currently outputs `sequence = 3`, while the later email payload uses `sequence = 4`. The correct filter input depends on the external workflow."}, "typeVersion": 1}, {"id": "feadbf1f-92d2-4974-a04b-42682b89128c", "name": "15 - Gate and Draft the Final Follow-up", "type": "n8n-nodes-base.stickyNote", "position": [3456, 3000], "parameters": {"color": 5, "width": 3360, "height": 800, "content": "## Section 15: Gate and draft the final follow-up\nChecks sender availability using `_firstItem = 3`, loads company information and the previous lead record, then requires a non-empty email. The drafting agent prepares a final message with Qdrant service knowledge and a structured parser.\n\n**Configure:** tables, sender workflow and AI credentials. The availability IF's false output is unconnected; a missing lead email returns to the loop."}, "typeVersion": 1}, {"id": "ea515c9d-42dc-4772-81e3-c684c6dd74f6", "name": "16 - Deliver the Final Follow-up", "type": "n8n-nodes-base.stickyNote", "position": [6912, 3000], "parameters": {"color": 5, "width": 2464, "height": 800, "content": "## Section 16: Deliver the final follow-up\nBuilds the sequence-4 email payload and pixel tag, includes the follow-up record ID, calls the sending workflow, waits and updates the follow-up count before returning to the loop.\n\n**Configure:** delivery-workflow reference, pixel endpoint and database update fields. Review the message before testing delivery."}, "typeVersion": 1}, {"id": "3374dbf6-af21-457a-81b0-64a5ab9c17b5", "name": "17 - Upload Service Knowledge to Qdrant", "type": "n8n-nodes-base.stickyNote", "position": [0, 4000], "parameters": {"color": 6, "width": 1120, "height": 800, "content": "## Section 17: Upload service knowledge to Qdrant\nThe independent form accepts PDF/CSV files. The binary document loader supplies documents to the Qdrant insertion node; OpenAI embeddings convert text into vectors for both insertion and retrieval.\n\n**Configure:** Qdrant/OpenAI credentials, collection and embedding compatibility. Upload accurate service material before testing email generation."}, "typeVersion": 1}, {"id": "fc300aef-d6d4-405d-b670-d4558f737218", "name": "18 - Retrieve Shared Service Knowledge", "type": "n8n-nodes-base.stickyNote", "position": [1216, 4000], "parameters": {"color": 6, "width": 760, "height": 800, "content": "## Section 18: Retrieve shared service knowledge\nThis Qdrant tool is connected to all five email-writing agents. It retrieves service context from the same collection populated by the upload branch; the embedding model is shared with insertion.\n\n**Configure:** matching collection and embedding dimensions. Verify retrieval returns your service information. Connected tools are available to agents, but their use is not guaranteed on every run."}, "typeVersion": 1}, {"id": "31e866dd-94b5-4bbd-84a2-bd4c561a8769", "name": "19 - Optional Anthropic Experiment", "type": "n8n-nodes-base.stickyNote", "position": [2072, 4000], "parameters": {"color": 7, "width": 760, "height": 800, "content": "## Section 19: Optional Anthropic experiment (disabled)\nThis HTTP node contains an alternative email-generation request. It is disabled and has no execution connections, so it is not part of the current email sequence.\n\n**Optional setup:** add your own Anthropic API key, confirm the model/API request format, connect the node and explicitly test its output mapping before using it."}, "typeVersion": 1}, {"id": "13fa1fde-dfd1-4a2a-804c-e1e1303b222e", "name": "OpenAI GPT-4 Chat Model", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [8176, 560], "parameters": {"model": "gpt-5.4-mini", "options": {}}, "credentials": {"openAiApi": {"id": "d83021c6ea6c47ee", "name": "Dummy openAiApi"}}, "typeVersion": 1}, {"id": "b7b6d65b-fe83-4584-a84e-9f65f261e1e1", "name": "Email Availability Checker Agent", "type": "@n8n/n8n-nodes-langchain.agent", "onError": "continueErrorOutput", "position": [8176, 320], "parameters": {"text": "=<instructions>\nYou are an expert cold email writer. You write short, human emails that feel like a quick note from a real person, not a pitch from a company.\n\nYou have access to a prospect briefing prepared by a research analyst. This briefing is your primary source. It contains the prospect's pain points, what they care about, a personalisation angle, and a conversation hook, all pre-filtered through the client's services.\n\nUse the briefing first. Only fall back to raw posts or industry defaults if the briefing is thin or says \"weak fit.\"\n\n<prospect_briefing>\nProspect Name: {{ $json.person.full_name }}\nIndustry: {{ $json.person.industry }}\nSummary: {{ $json.person.summary }}\n</prospect_briefing>\n\n<raw_posts_fallback>\nOnly use these if the briefing fields are empty, say \"weak fit\", or say \"posts are too generic to personalise from.\" Otherwise ignore this section entirely.\n\n- Post 1: {{ $(\"User's Posts\").first().json.data[0]?.text ?? 'No post available' }}\n- Post 2: {{ $(\"User's Posts\").first().json.data[1]?.text ?? 'No post available' }}\n\n<writing_priority>\nThis is the order you follow when building the email:\n\n1. Use the briefing's personalisation_angle for the opening paragraph. This is a specific thing from their posts that was pre-selected for you. Reference it naturally like a peer who read it and had a real reaction.\n\n2. Use the briefing's pain_points for the second paragraph. These have already been filtered to match the client's services. Name the pain in plain language. Do not name the product.\n\n3. Use the briefing's conversation_hook to guide your tone and framing throughout.\n\n4. If the briefing says \"weak fit\" in service_connection, do NOT write the email. Set cold_email to \"weak fit - no relevant service connection found.\"\n\n5. If has_posts is false AND the briefing fields are mostly empty, set cold_email to \"no data found.\"\n</writing_priority>\n\n<target_audience>\nYou are writing to small and mid-sized service-based businesses with 10 to 100 employees. Primary markets: Nashville, Columbus, Kansas City, Birmingham, Louisville. Secondary markets: Raleigh, Indianapolis, Jacksonville, San Antonio, Oklahoma City, Memphis, Greenville, Des Moines.\n</target_audience>\n\n<writing_rules>\nSTRICT RULES, no exceptions:\n- The email must be between 80 and 100 words. Not less. Not more. Count carefully before finalizing.\n- Never use em dashes. Use a comma if you need to separate a thought.\n- No fluff words. No filler. No corporate buzzwords.\n- No fancy or hard words. Write like a real person texting a colleague.\n- No AI-sounding phrases. No words like \"leverage,\" \"robust,\" \"seamless,\" \"cutting-edge,\" \"synergy,\" \"furthermore,\" or \"I hope this finds you well.\"\n- No unnecessary quotation marks.\n- Reading grade level must be 8 or below.\n- Every paragraph is one or two lines max. Quick note sent from a phone.\n- Do not pitch the product directly. Build curiosity. Make them want to ask more.\n- Do not make up features, results, or services. Only use what is in the product section and RAG.\n- Never use promotional or spam trigger words.\n- 100% human tone throughout.\n</writing_rules>\n\n<format_rules>\nSTRICT FORMAT RULES, follow exactly:\n- Always open with: Hi [First Name],\n- Then leave one blank line.\n- Write each paragraph as 1 to 2 short lines only.\n- Leave one blank line between every paragraph.\n- The CTA is its own paragraph with a blank line above it.\n- The signature must always be a single HTML paragraph using a line break, exactly like this:\n<p>Best,<br>{{ $('Check If Emails Available to Send Email').item.json.selected_email.list[0]['email inbox'].split(\"@\")[0][0].toUpperCase() + $('Check If Emails Available to Send Email').item.json.selected_email.list[0]['email inbox'].split(\"@\")[0].slice(1) }}</p>\nDo not split the signature into two separate <p> tags. Never add a blank line between Best and the name.\n- The final output must be in HTML. Use <p> tags for each paragraph so spacing renders correctly in email clients.\n</format_rules>\n\n<email_structure>\nStep 1: Open with Hi [First Name],\n\nStep 2: First paragraph. Use the personalisation_angle from the briefing. Reference a specific thing they said or shared. Agree with their point of view like a peer who actually read it. One or two lines only.\n\nStep 3: Second paragraph. Use the pain_points from the briefing. Name one specific friction point they are likely dealing with. Do not name the product. Just name the pain in plain language.\n\nStep 4: Third paragraph. In one short line, hint that you have seen something that handles exactly that. Keep it vague. No features. No explanation. Just enough to make them curious.\n\nStep 5: CTA paragraph. End with this exact line, word for word:\n\"If you are up for comparing notes over a virtual coffee, maybe we could connect later this week or next?\"\n\nStep 6: Signature as a single HTML paragraph:\n<p>Best,<br>{{ $('Check If Emails Available to Send Email').item.json.selected_email.list[0]['email inbox'].split(\"@\")[0][0].toUpperCase() + $('Check If Emails Available to Send Email').item.json.selected_email.list[0]['email inbox'].split(\"@\")[0].slice(1) }}</p>\n</email_structure>\n\n<subject_line_rules>\nSelect the best subject line for this specific prospect from the list below. Choose 4 candidates that fit the prospect's industry and briefing, then pick the single best one. The subject line must include their first name and their company name where {company} appears.\n\nSubject line pool:\n- {first_name}, was this on purpose?\n- {first_name}, this surprised me\n- {first_name}, this doesn't look intentional\n- {first_name}, this feels heavier than needed\n- {first_name}, unsure if this was on purpose\n- {first_name}, checking before assuming\n- {first_name}, I've seen this go sideways\n- {first_name}, curious about one thing I noticed\n- {first_name}, question about your workflow setup\n- {first_name}, this might deserve a look\n- {first_name}, small concern worth flagging\n- {first_name}, double-checking before I assume\n- {first_name}, sanity check on something I noticed\n- {first_name}, this seems to create drag\n\nPick the one that fits this specific prospect, their industry, and their briefing the best.\n</subject_line_rules>\n\n<product>\nEmail writer name: {{ $('Check If Emails Available to Send Email').item.json.selected_email.list[0]['email inbox'].split(\"@\")[0][0].toUpperCase() + $('Check If Emails Available to Send Email').item.json.selected_email.list[0]['email inbox'].split(\"@\")[0].slice(1) }}\nProduct Name: {{ $('Company Info').item.json.list[0].your_company_name }}\nDescription: {{ $('Company Info').item.json.list[0].company_services }}\nCore Features and Benefits: Obtain this from RAG at all costs. Do not make anything up. Only use what is relevant to the RAG.\n</product>\n\n<result>\nReturn ONLY a raw JSON object. No markdown. No code fences. No explanation. No text before or after. Start with { and end with }.\n\nFormat exactly: {\"email_subject\": \"...\", \"email_message\": \"...\"}\n\nThe email_message must be in HTML. Use <p> tags for every paragraph. Do not use markdown. The signature must be a single <p> tag as shown above.\n\nIf service_connection is \"weak fit\", return: {\"email_subject\": \"\", \"email_message\": \"weak fit - no relevant service connection found\"}\nIf has_posts is false and briefing is empty, return: {\"email_subject\": \"\", \"email_message\": \"no data found\"}\n</result>\n</instructions>", "options": {}, "promptType": "define", "hasOutputParser": true}, "typeVersion": 1.8, "alwaysOutputData": true}, {"id": "640beb8f-b1b5-4491-8a8e-7477e60d5d68", "name": "Output Structure Parser", "type": "@n8n/n8n-nodes-langchain.outputParserStructured", "position": [8352, 560], "parameters": {"jsonSchemaExample": "{\n\t\"subject\": \"\",\n\t\"cold_email\": \"\",\n    \"has_linkedin_data\": \"\"\n}"}, "typeVersion": 1.2}, {"id": "0a569a1f-dee9-4bbc-8dcc-08d82f3aac9b", "name": "User Summary Generator Agent", "type": "@n8n/n8n-nodes-langchain.agent", "onError": "continueErrorOutput", "position": [6960, 320], "parameters": {"text": "=You are a research analyst preparing intel for a cold outreach campaign. Your job is to study a prospect's profile and their recent LinkedIn posts, then produce a short briefing that an email writer can use to write a personalised cold email.\n\nYou are NOT writing the email. You are building the foundation for one.\n\n<your_company>\nCompany Name: {{ $('Company Info').item.json.list[0].your_company_name }}\nWhat We Do: {{ $('Company Info').item.json.list[0].company_services }}\n\nThis is who you represent. Every pain point you identify and every personalisation angle you pick should connect back to a problem this company can solve. If you spot a pain point that has nothing to do with what this company offers, skip it. Only flag problems where there is a real overlap between what the prospect is struggling with and what this company actually does.\n</your_company>\n\n<target_industries>\nThe prospects you will encounter work in one of these industries:\n- Engineering / Construction\n- Marketing / Digital Agencies\n- Law Firms\n\nIf the industry field is missing or unclear, figure it out from their job title, company summary, and posts. Pick the closest match. If none fit, label it \"Other\" and still do the analysis.\n</target_industries>\n\n<data>\nName: {{ $('Batch Process Emails').item.json.name }}\nIndustry: {{ $('Batch Process Emails').item.json.industry }}\nCurrent Job Title: {{ $('Batch Process Emails').item.json.title }}\nProfile Summary: {{ $('Batch Process Emails').item.json.summary ?? 'Not provided' }}\n\nLinkedIn Posts:\n- Post 1: {{ $(\"User's Posts\").item.json.data[0]?.text ?? 'No post available' }}\n- Post 2: {{ $(\"User's Posts\").item.json.data[1]?.text ?? 'No post available' }}\n- Post 3: {{ $(\"User's Posts\").item.json.data[2]?.text ?? 'No post available' }}\n- Post 4: {{ $(\"User's Posts\").item.json.data[3]?.text ?? 'No post available' }}\n</data>\n\n<instructions>\nGo through the profile AND posts together. Do not treat them separately.\n\nYour analysis must be filtered through what \n{{ $('Company Info').item.json.list[0].your_company_name }} actually offers. You are not doing general research. You are looking for signals that this prospect has a problem the client's company can help with.\n\nLook for:\n\n1. WHO they are: Name, title, industry, location, company size if mentioned. One line, factual only.\n\n2. WHAT they care about: Read their posts. What topics keep coming up? What are they frustrated about, proud of, or asking about? Do not guess. Pull directly from what they wrote.\n\n3. RELEVANT PAIN POINTS: Based on their industry, their posts, AND what {{ $('Company Info').item.json.list[0].your_company_name }} offers, identify 1 to 2 friction points where there is a genuine overlap. The pain must be real (from their posts or obvious from their industry) AND something the client's services can address. If there is no overlap, say so honestly. Do not force a connection.\n\n4. SERVICE CONNECTION: In one sentence, explain which part of the client's offering maps to the pain point you identified. Be specific. Do not say \"our services can help.\" Say exactly which service or capability is relevant and why.\n\n5. PERSONALISATION ANGLE: Pick the single best thing from their posts that a cold emailer could reference naturally, as if they actually read it and had a genuine reaction. Prioritise posts where the prospect mentions a problem, frustration, or goal that connects to what the client offers. If no posts connect to the service, pick the most human and relatable post instead.\n\n6. CONVERSATION HOOK: In one sentence, describe what kind of opening line would land with this person AND tie back to the client's offering. Example: \"They posted about losing hours to manual reporting, so leading with that and hinting at automation would feel relevant.\"\n\nIf posts are available, you MUST use them. Do not ignore them in favour of the profile summary.\nIf posts are NOT available, set has_posts to false, use only the profile summary, and flag that personalisation will be limited.\n</instructions>\n\n<rules>\n- Do NOT make anything up. If the posts are empty or generic, say so. Do not invent pain points or interests.\n- Do NOT force a connection between the prospect and the client's services. If there is no real overlap, say \"weak fit\" in the service_connection field. A bad lead identified early saves everyone time.\n- Do NOT use corporate language. Write like a sharp colleague briefing you before a call.\n- Do NOT include any email copy, subject lines, or CTAs. That is not your job.\n- Keep the whole output under 150 words. This is a briefing, not an essay.\n- Be direct. If there is nothing useful in the posts, say \"posts are too generic to personalise from\" and work with what you have.\n</rules>\n\n<output_format>\nReturn ONLY a raw JSON object. No markdown. No code fences. No explanation. Start with { and end with }.\n\n{\n  \"has_posts\": true or false,\n  \"prospect_name\": \"...\",\n  \"industry\": \"...\",\n  \"title\": \"...\",\n  \"who_they_are\": \"One line summary of this person\",\n  \"what_they_care_about\": \"What their posts reveal about their priorities and frustrations\",\n  \"pain_points\": \"1 to 2 specific friction points that overlap with the client's services\",\n  \"service_connection\": \"Which specific service or capability maps to their pain, or 'weak fit' if none\",\n  \"personalisation_angle\": \"The single best thing from their posts to reference in a cold email\",\n  \"conversation_hook\": \"One sentence describing the best opening approach tied to the client's offering\"\n}\n</output_format>", "options": {}, "promptType": "define"}, "typeVersion": 1.8}, {"id": "e0167655-8dfc-4123-a716-2a550e037fd8", "name": "OpenAI GPT-4 for Summary", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [6960, 560], "parameters": {"model": "gpt-5.4-mini", "options": {}}, "credentials": {"openAiApi": {"id": "d83021c6ea6c47ee", "name": "Dummy openAiApi"}}, "typeVersion": 1}, {"id": "1eaa5b4a-7848-4d50-af22-a779d1b1731a", "name": "Fetch LinkedIn Data", "type": "n8n-nodes-base.code", "position": [7408, 320], "parameters": {"jsCode": "const lead = $('Lead Info').first().json;\nconst postsResponse = $input.first().json;\nconst posts = postsResponse.data || postsResponse.list || [];\n\nreturn {\n  person: {\n    summary: $('User Summary Generator Agent').first().json.output,\n    full_name: lead.name,\n    linkedin_url: lead.linkedin_url,\n    industry: lead.industry,\n    technologies: lead.technologies,\n    keywords: lead.keywords,\n    posts: posts,\n    data: posts,\n  },\n  company: {\n    website: lead.website,\n    company_size: lead.employees,\n  },\n};"}, "typeVersion": 2}, {"id": "d69f15f5-e2f1-41d7-a792-883825125e0e", "name": "Parse Structured Output 5", "type": "@n8n/n8n-nodes-langchain.outputParserStructured", "position": [8032, 2560], "parameters": {"jsonSchemaExample": "{\n\t\"subject\": \"subject\",\n\t\"cold_email\": \"Los Angeles\"\n}"}, "typeVersion": 1.2}, {"id": "01761432-eed8-43a9-afd3-e19ee85c86b8", "name": "OpenAI GPT-4 for Email 9", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [6192, 3560], "parameters": {"model": "gpt-5.4-mini", "options": {}}, "credentials": {"openAiApi": {"id": "d83021c6ea6c47ee", "name": "Dummy openAiApi"}}, "typeVersion": 1}, {"id": "b1c53cf5-27c3-4f49-8eca-9f29e1a6ce45", "name": "Email Drafting Agent 9", "type": "@n8n/n8n-nodes-langchain.agent", "onError": "continueErrorOutput", "position": [6192, 3320], "parameters": {"text": "=<instructions>\nYou are an expert cold email writer. You write short, human emails that feel like a genuine final note from a real person, not a closing pitch from a sales rep.\n\n<target_audience>\nYou are writing to small and mid-sized service-based businesses with 10 to 100 employees. The industries you will encounter are Engineering, Construction, Marketing and Digital Agencies, and Law Firms. These businesses are based primarily in Nashville, Columbus, Kansas City, Birmingham, and Louisville, with secondary markets in Raleigh, Indianapolis, Jacksonville, San Antonio, Oklahoma City, Memphis, Greenville, and Des Moines.\n\nBefore writing, identify which industry this prospect belongs to using: Lead Industry: {{ $('Lead Previous Email Data').item.json.list[0].industry }}\n\nThen use the relevant pain point angle below:\n\n- Engineering or Construction: Focus on slow project timelines, lack of visibility on where time and money go, and manual processes that delay delivery. Use language around compressing timelines, eliminating delays, and turning messy processes into clear systems.\n- Marketing or Digital Agencies: Focus on manual reporting, slow client delivery cycles, and juggling too many tools. Use language around faster delivery, cleaner operations, and getting more done without adding headcount.\n- Law Firms: Focus on manual intake, slow document workflows, and time lost on non-billable admin tasks. Use language around cutting out the back and forth, freeing up billable hours, and getting client work out faster.\n</target_audience>\n\n<writing_rules>\nSTRICT RULES \u2014 follow every single one, no exceptions:\n- The email must be between 80 and 100 words. Not less. Not more. Count carefully before finalizing.\n- Never use em dashes (\u2014). If you need to separate a thought, use a comma.\n- No fluff words. No filler. No corporate buzzwords.\n- No fancy or hard words. Write like a real person texting a colleague.\n- No AI-sounding phrases. No words like \"leverage,\" \"unlock,\" \"robust,\" \"seamless,\" \"cutting-edge,\" \"revolutionary,\" \"synergy,\" \"furthermore,\" or \"I hope this finds you well.\"\n- No unnecessary quotation marks.\n- Reading grade level must be 8 or below.\n- Every paragraph is one or two lines max. Must look like a quick note sent from a phone.\n- Do not be pushy or needy. This is a calm, low-pressure closing note.\n- Do not mention sending a PDF.\n- Do not include any meeting link.\n- Do not make up features, results, or services. Only use what is in the RAG.\n- Never use promotional or spam trigger words.\n- 100% human tone throughout.\n- Use very basic words so they know you are being real, not trying to close a deal.\n</writing_rules>\n\n<format_rules>\nSTRICT FORMAT RULES \u2014 this controls how the email looks. Follow exactly:\n- Always open with: Hi [First Name],\n- Then leave one blank line.\n- Write each paragraph as 1 to 2 short lines only.\n- Leave one blank line between every paragraph.\n- The CTA is its own paragraph with a blank line above it.\n- The signature must always be a single HTML paragraph using a line break, exactly like this:\n<p>Best,<br>Nicole</p>\nDo not split the signature into two separate <p> tags. Never add a blank line between Best and Nicole.\n- The final output must be in HTML. Use <p> tags for each paragraph so spacing renders correctly in email clients.\n</format_rules>\n\n<email_structure>\nThis is the fourth and final email. The prospect has not replied to any of the previous three emails. This is a closing email. Keep it warm, light, and genuine. No pressure.\n\nStep 1 \u2014 Open with: Hi [First Name],\n\nStep 2 \u2014 First paragraph: Acknowledge in one honest line that you have reached out a few times. No guilt. No pressure. Just a real person wrapping up.\n\nStep 3 \u2014 Second paragraph: In one or two lines, make it clear that others in their industry have already moved past the manual work they are still dealing with. Tie it to their specific industry pain point. Make it feel like they are leaving something useful on the table, not that they are failing.\n\nStep 4 \u2014 Third paragraph: One short, genuinely warm and funny line about their calendar. Write something fresh each time. Do not copy these examples word for word, they are just the tone to aim for:\n- \"Any chance we grab 15 minutes before your calendar ghosts me completely?\"\n- \"Mind if I borrow 15 minutes? I'll return it in mint condition.\"\n\nStep 5 \u2014 CTA paragraph: End with this exact line, word for word:\n\"Are you open to a brief virtual coffee? I'm happy to squeeze you into my calendar and will send over a link to find a time that fits.\"\n\nStep 6 \u2014 Signature, as a single HTML paragraph:\n<p>Best,<br>Nicole</p>\n</email_structure>\n\n<subject_line_rules>\nYou must select the best subject line for this specific prospect from the list below. Choose 4 candidates that fit the prospect's industry and tone, then pick the single best one. The subject line must include their first name and their company name where {company} appears.\n\nSubject line pool:\n- {first_name}, was this on purpose?\n- {first_name}, this surprised me\n- {first_name}, this doesn't look intentional\n- {first_name}, this feels heavier than needed\n- {first_name}, unsure if this was on purpose\n- {first_name}, checking before assuming\n- {first_name}, I've seen this go sideways\n- {first_name}, curious about one thing I noticed\n- {first_name}, question about your workflow setup\n- {first_name}, this might deserve a look\n- {first_name}, small concern worth flagging\n- {first_name}, double-checking before I assume\n- {first_name}, sanity check on something I noticed\n- {first_name}, this seems to create drag\n\nPick the one that fits this specific prospect and gives the best chance of being opened as a final email.\n</subject_line_rules>\n\n<history>\nThis is the fourth and final email. The prospect has not replied to any of the previous three emails. Treat this as a warm closing note with a gentle final invitation to connect.\nUse the RAG to pull relevant product information. Do not make anything up.\n</history>\n\n</instructions>\n\n<lead_information>\nEmail Receiver Name: {{ $('Aggregate2').item.json.data[0].Name }}\nEmail Writer Name: {{ $('Aggregate2').item.json.data[0].email_sent_from.split('@')[0].replace(/^./, c => c.toUpperCase()) }}\nLead Industry: {{ $('Lead Previous Email Data').item.json.list[0].industry }}\n</lead_information>\n\n<tools>\nUse the RAG tool to obtain important information about the business. Do not make up any features, services, or results not found in the RAG.\n</tools>\n\n<result>\nReturn ONLY a raw JSON object. No markdown. No code fences. No explanation. No text before or after. Start with { and end with }.\n\nFormat exactly: {\"subject\": \"...\", \"cold_email\": \"...\"}\n\nThe email_message must be in HTML. Use <p> tags for every paragraph. Do not use markdown. The signature must be a single <p> tag like this: <p>Best,<br>Nicole</p>\n</result>", "options": {}, "promptType": "define", "hasOutputParser": true}, "typeVersion": 1.8, "alwaysOutputData": true}, {"id": "831a4a40-229d-40f0-97f4-47a88d3cda8c", "name": "Parse Structured Output 6", "type": "@n8n/n8n-nodes-langchain.outputParserStructured", "position": [6368, 3560], "parameters": {"jsonSchemaExample": "{\n\t\"subject\": \"\",\n\t\"cold_email\": \"\"\n}"}, "typeVersion": 1.2}, {"id": "ac5e2831-97c9-44fb-bdcd-8b2d900cd8ef", "name": "Email Drafting Agent 10", "type": "@n8n/n8n-nodes-langchain.agent", "onError": "continueErrorOutput", "position": [7856, 2320], "parameters": {"text": "=<instructions>\nYou are an expert cold email writer. You write short, human emails that feel like a quick note from a real person, not a pitch from a company.\n\n<target_audience>\nYou are writing to small and mid-sized service-based businesses with 10 to 100 employees. The industries you will encounter are Engineering, Construction, Marketing and Digital Agencies, and Law Firms. These businesses are based primarily in Nashville, Columbus, Kansas City, Birmingham, and Louisville, with secondary markets in Raleigh, Indianapolis, Jacksonville, San Antonio, Oklahoma City, Memphis, Greenville, and Des Moines.\n\nBefore writing, identify which industry this prospect belongs to. Then use the relevant angle below:\n\n- Engineering or Construction: Focus on slow project timelines, lack of visibility on where time and money go, and manual processes that delay delivery. Use language around compressing timelines, eliminating delays, and turning messy processes into clear systems.\n- Marketing or Digital Agencies: Focus on manual reporting, slow client delivery cycles, and juggling too many tools. Use language around faster delivery, cleaner operations, and getting more done without adding headcount.\n- Law Firms: Focus on manual intake, slow document workflows, and time lost on non-billable admin tasks. Use language around cutting out the back and forth, freeing up billable hours, and getting client work out faster.\n\nIf the industry is unclear, use the prospect's company posts and bio to make your best judgment.\n</target_audience>\n\n<writing_rules>\nSTRICT RULES \u2014 follow every single one, no exceptions:\n- The email must be between 80 and 100 words. Not less. Not more. Count carefully before finalizing.\n- Never use em dashes (\u2014). If you need to separate a thought, use a comma.\n- No fluff words. No filler. No corporate buzzwords.\n- No fancy or hard words. Write like a real person texting a colleague.\n- No AI-sounding phrases. No words like \"leverage,\" \"unlock,\" \"robust,\" \"seamless,\" \"cutting-edge,\" \"revolutionary,\" \"synergy,\" \"furthermore,\" or \"I hope this finds you well.\"\n- No unnecessary quotation marks.\n- Reading grade level must be 8 or below.\n- Every paragraph is one or two lines max. Must look like a quick note sent from a phone.\n- Do not pitch the product directly. Build curiosity. Make them want to ask for more.\n- Do not use phrases like \"we have developed a tool\" or \"our solution.\" Talk about how their work gets easier.\n- Do not make up features, results, or services. Only use what is in the product section below.\n- Never use promotional or spam trigger words.\n- 100% human tone throughout.\n</writing_rules>\n\n<format_rules>\nSTRICT FORMAT RULES \u2014 this controls how the email looks. Follow exactly:\n- Always open with: Hi [First Name],\n- Then leave one blank line.\n- Write each paragraph as 1 to 2 short lines only.\n- Leave one blank line between every paragraph.\n- The CTA is its own paragraph with a blank line above it.\n- The signature must always be a single HTML paragraph using a line break, exactly like this:\n<p>Best,<br>Nicole</p>\nDo not split the signature into two separate <p> tags. Never add a blank line between Best and Nicole.\n- The final output must be in HTML. Use <p> tags for each paragraph so spacing renders correctly in email clients.\n</format_rules>\n\n<email_structure>\nThis is the third email. The prospect has not replied yet. Do not mention that. Just reconnect naturally through their company.\n\nStep 1 \u2014 Open with: Hi [First Name],\n\nStep 2 \u2014 First paragraph: Look at the company post provided. Find something real they shared. Reference it in one line like a peer who actually read it. One or two lines only.\n\nStep 3 \u2014 Second paragraph: Name one specific manual bottleneck they are likely dealing with based on their industry. Do not name the product. Describe the pain in plain language.\n\nStep 4 \u2014 Third paragraph: One short line. Paint a quick picture of what their workflow looks like once that friction is gone. Just the outcome. No explanation of how.\n\nStep 5 \u2014 CTA paragraph: End with this exact line, word for word:\n\"Would Wednesday or Thursday next week work for you?\"\n\nStep 6 \u2014 Signature, as a single HTML paragraph:\n<p>Best,<br>Nicole</p>\n</email_structure>\n\n<subject_line_rules>\nYou must select the best subject line for this specific prospect from the list below. Choose 4 candidates that fit the prospect's industry and company post, then pick the single best one. The subject line must include their first name and their company name where {company} appears.\n\nSubject line pool:\n- {first_name}, was this on purpose?\n- {first_name}, this surprised me\n- {first_name}, this doesn't look intentional\n- {first_name}, this feels heavier than needed\n- {first_name}, unsure if this was on purpose\n- {first_name}, checking before assuming\n- {first_name}, I've seen this go sideways\n- {first_name}, curious about one thing I noticed\n- {first_name}, question about your workflow setup\n- {first_name}, this might deserve a look\n- {first_name}, small concern worth flagging\n- {first_name}, double-checking before I assume\n- {first_name}, sanity check on something I noticed\n- {first_name}, this seems to create drag\n\nPick the one that fits this specific prospect and their company post the best.\n</subject_line_rules>\n\n</instructions>\n\n<data>\nCompany Post: {{ $('Company\\'s Posts').item.json.data[0].text?.replace(/[\\u{1D400}-\\u{1D7FF}]/gu, '').trim() ?? 'No post available' }}\n</data>\n\n<product>\nEmail Receiver Name: {{ $('Aggregate1').item.json.data[0].Name }}\nEmail Writer Name: {{ $('Aggregate1').item.json.data[0].email_sent_from.split('@')[0].replace(/^./, c => c.toUpperCase()); }}\nProduct Name: AI Implementation Checklist\nDescription: {{ $('Company Info1').item.json.list[0].your_company_activity }}\nCore Features and Benefits:\n- Reduce cycle time across strategy, creative, and client services\n- Improve margins by increasing throughput with existing staff\n- Increase adoption so your team actually uses AI every day\n- Boost client satisfaction with faster, more consistent delivery\n- Stay tool-neutral, we optimize your current stack, not replace it\n- Get measurable ROI within one quarter\nPain Points We Solve: Paying for AI tools the team does not use, long cycle times, onboarding and support backlogs, documentation burden, margin erosion\n</product>\n\n<result>\nReturn ONLY a raw JSON object. No markdown. No code fences. No explanation. No text before or after. Start with { and end with }.\n\nFormat exactly: {\"subject\": \"...\", \"cold_email\": \"...\"}\n\nThe email_message must be in HTML. Use <p> tags for every paragraph. Do not use markdown. The signature must be a single <p> tag like this: <p>Best,<br>Nicole</p>\n</result>", "options": {}, "promptType": "define", "hasOutputParser": true}, "typeVersion": 1.8, "alwaysOutputData": true}, {"id": "b20378a1-a7a5-4729-929f-aa2a948c598c", "name": "OpenAI GPT-4 for Drafting", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [8624, 560], "parameters": {"model": "gpt-5.4-mini", "options": {"topP": 1, "temperature": 0.5}}, "credentials": {"openAiApi": {"id": "d83021c6ea6c47ee", "name": "Dummy openAiApi"}}, "typeVersion": 1}, {"id": "b747f912-3092-404f-b8e5-fa0b40c1ebd3", "name": "Cold Email Generator Agent", "type": "@n8n/n8n-nodes-langchain.agent", "onError": "continueErrorOutput", "maxTries": 3, "position": [8624, 320], "parameters": {"text": "=<instructions>\nyou are an expert email writter, how much would you rate this email for a cold sales email marketing prespective, it is to build curosity, not sell the product, if you were a client watching this, how much interested would you be? Next question, if you were the expert email writer, how would you have wrote this email\n \nCurrent Subject: {{ $json.output.subject }}\n \nCurrent Email: {{ $json.output.cold_email }}\n \n \nThe result should be in html, what we are looking\n- Keep it short, should be easy to read on mobile\n- Hooks early: References their post in the subject and opening.\n- Curiosity maintained: No feature overload, just one quick case example.\n- Clear next step: \u201c2-minute version\u201d feels light and easy to say yes to.\n- Conversational tone: Less corporate, more human.\n- Avoid promotional and spam trigger words at all costs (we don't want the email to land in promotion or spam, but rather in the general/main inbox)\n \n<Writing instructions>\n- Must avoid spam trigger words\n- Reading grade level should be 8 max\n- Write like a confident, clear thinking human speaking to another smart human.\n'leveraging synergies', or 'furthermore.\n- Skip unnecessary quotation marks (\"'), and corporate buzzwords like 'cutting-edge', 'robust, or\n'seamless experience.\n- Never use em dashes (\u2014) in the email. Avoid them entirely. If you need to separate a thought, use a simple comma.\n- No Al tone. No fluff. No filler.\n- When you rewrite or improve the email, do not change the signature. There should be no extra space or gap between them. Ensure it remains exactly:\nBest,\nNicole\n\nMake sure this exact format is followed every single time.\n\n</Writing instructions>\n<instructions>", "options": {"systemMessage": "You are a helpful assistant"}, "promptType": "define", "hasOutputParser": true}, "retryOnFail": true, "typeVersion": 1.8, "alwaysOutputData": true}, {"id": "5927a3b7-a679-45fc-b946-824ca52c470f", "name": "Parse Structured Output", "type": "@n8n/n8n-nodes-langchain.outputParserStructured", "position": [8800, 560], "parameters": {"jsonSchemaExample": "{\n\t\"subject\": \"\",\n\t\"cold_email\": \"\"\n}"}, "typeVersion": 1.2}, {"id": "95965abd-d692-41d4-8db1-3f4ed0e36da8", "name": "OpenAI GPT-4 Email Ideas", "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi", "position": [6960, 1560], "parameters": {"model": "gpt-5.4-mini", "options": {"topP": 1, "temperature": 0.5}}, "credentials": {"openAiApi": {"id": "d83021c6ea6c47ee", "name": "Dummy openAiApi"}}, "typeVersion": 1}, {"id": "92bf72e4-eb98-453e-8378-777d628d834f", "name": "Email Content Enhancement Agent", "type": "@n8n/n8n-nodes-langchain.agent", "onError": "continueErrorOutput", "maxTries": 3, "position": [6960, 1320], "parameters": {"text": "=You are an expert cold email writer. Review the email below from a cold sales perspective. The goal is curiosity, not selling.\n\nAsk yourself two things:\n1. How would you rate this as a cold follow-up email meant to build curiosity using a real article?\n2. If you were rewriting it as a top 0.1% email writer, what would it look like?\n\n<email>\nCurrent Subject + Email: {{ $('Open AI Search').item.json.choices[0].message.content }}\nSender Name: {{ $('Aggregate').item.json.data[0].email_sent_from.split('@')[0].replace(/^./, c => c.toUpperCase()) }}\nReceiver Name: {{ $('Aggregate').item.json.data[0].Name }}\nFirst Name: {{ $('Aggregate').item.json.data[0].Name.split(' ')[0] }}\nCompany Name: {{ $('Aggregate').item.json.data[0]['Company Name'] ?? '' }}\n</email>\n\n<rewrite_rules>\nSTRICT RULES \u2014 no exceptions:\n- The email body MUST contain between 110 and 120 words. This is non-negotiable. Count every single word before finalizing. The greeting \"Hi [First Name],\" counts. The CTA counts. Every word counts. If you are under 110 you MUST expand paragraphs. Do not submit until word count is confirmed between 110 and 120.\n- The current email you are reviewing may be too short. You must rewrite it from scratch to reach 110 to 120 words. Do not just polish the existing email. Rebuild it fully if needed.\n- Never use em dashes (\u2014). Use a comma instead if needed.\n- NEVER use ellipsis (...) anywhere in the email. Do not write \"...\" for any reason. Not between paragraphs, not as a transition, not anywhere. If you are about to write \"...\", stop and delete it.\n- No fluff. No filler. No buzzwords.\n- No hard or fancy words. Write like a real person.\n- No AI tone. Nothing that sounds generated or corporate.\n- Reading grade level must be 8 or below.\n- Every paragraph is one or two lines only. Must look like a quick note from a phone.\n- Avoid all promotional and spam trigger words. This email must land in the main inbox, not promotions or spam.\n- Do not pitch the product. Build curiosity through the article reference.\n- Use only ONE article. Never combine multiple articles. Use the first one provided.\n- When referencing the article, mention the publication name naturally. Never paste the URL as a link in the email body.\n- DO NOT ADD LINKS IN THE EMAIL BODY.\n- The CTA must read exactly: \"If you want to learn more about it, I would be happy to send a PDF.\"\n- The signature must be a single HTML paragraph using a line break, exactly like this:\n<p>Best,<br>Nicole</p>\nDo not split the signature into two separate <p> tags. Never add a blank line between Best and Nicole.\n</rewrite_rules>\n\n<format_rules>\nSTRICT FORMAT RULES \u2014 follow exactly:\n- Always open with: Hi [First Name],\n- Leave one blank line after the greeting.\n- Each paragraph is 1 to 2 short lines only.\n- Leave one blank line between every paragraph.\n- The CTA is its own paragraph with a blank line above it.\n- The signature immediately follows the CTA as a single <p> tag: <p>Best,<br>Nicole</p>\n- Output must be in HTML. Use <p> tags for every paragraph.\n</format_rules>\n\n<subject_line_rules>\nIMPORTANT: You must pick ONE subject line from the pool below. Do not write your own subject line. Do not modify any subject line. Do not combine subject lines. Only use what is in the list below, exactly as written.\n\nPick the single most relevant one based on the prospect's industry and the article topic.\n\nCRITICAL: Replace {first_name} with the actual First Name value above. Do NOT output {first_name} as literal text. Always use the real value.\n\nSubject line pool:\n- {first_name}, was this on purpose?\n- {first_name}, this surprised me\n- {first_name}, this doesn't look intentional\n- {first_name}, this feels heavier than needed\n- {first_name}, unsure if this was on purpose\n- {first_name}, checking before assuming\n- {first_name}, I've seen this go sideways\n- {first_name}, curious about one thing I noticed\n- {first_name}, question about your workflow setup\n- {first_name}, this might deserve a look\n- {first_name}, small concern worth flagging\n- {first_name}, double-checking before I assume\n- {first_name}, sanity check on something I noticed\n- {first_name}, this seems to create drag\n\nOutput only the chosen subject line with real values substituted. Do not explain your choice. Do not write a new one.\n</subject_line_rules>\n\n<article_details>\n(ignore if undefined)\nArticle 1:\n- Name: {{ $('Open AI Search').item.json.choices[0].message.annotations?.[0]?.url_citation?.title ?? 'undefined' }}\n- Link: {{ $('Open AI Search').item.json.choices[0].message.annotations?.[0]?.url_citation?.url ?? 'undefined' }}\nArticle 2:\n- Name: {{ $('Open AI Search').item.json.choices[0].message.annotations?.[1]?.url_citation?.title ?? 'undefined' }}\n- Link: {{ $('Open AI Search').item.json.choices[0].message.annotations?.[1]?.url_citation?.url ?? 'undefined' }}\nArticle 3:\n- Name: {{ $('Open AI Search').item.json.choices[0].message.annotations?.[2]?.url_citation?.title ?? 'undefined' }}\n- Link: {{ $('Open AI Search').item.json.choices[0].message.annotations?.[2]?.url_citation?.url ?? 'undefined' }}\nArticle 4:\n- Name: {{ $('Open AI Search').item.json.choices[0].message.annotations?.[3]?.url_citation?.title ?? 'undefined' }}\n- Link: {{ $('Open AI Search').item.json.choices[0].message.annotations?.[3]?.url_citation?.url ?? 'undefined' }}\n</article_details>\n\n<quality_checklist>\nBefore finalizing, confirm:\n- Opens with Hi [First Name],\n- Word count is between 110 and 120\n- No em dashes anywhere\n- No ellipsis (...) anywhere in the email body\n- No buzzwords or filler phrases\n- Each paragraph separated by a blank line\n- ONE article referenced naturally with publication name only, no URL in body\n- Pain point tied to the prospect's industry\n- CTA is word for word as required\n- Signature is <p>Best,<br>Nicole</p> with no blank line between them\n- No links in the email body\n- Subject line is picked from the pool only, not written from scratch\n- {first_name} is replaced with the real first name, not shown as literal text\n- Output is in HTML using proper p tags\n</quality_checklist>", "options": {}, "promptType": "define", "hasOutputParser": true}, "retryOnFail": true, "typeVersion": 1.8, "alwaysOutputData": true}, {"id": "ba79e88b-05f3-4d60-9df4-b87291c4c05b", "name": "Parse Structured Output 1", "type": "@n8n/n8n-nodes-langchain.outputParserStructured", "position": [7136, 1560], "parameters": {"jsonSchemaExample": "{\n\t\"subject\": \"\",\n\t\"cold_email\": \"\"\n}"}, "typeVersion": 1.2}, {"id": "a3bc71b6-c78a-4c6e-a357-1d07b7091c0e", "name": "Batch Process Emails", "type": "n8n-nodes-base.splitInBatches", "position": [1392, 320], "parameters": {"options": {}}, "typeVersion"